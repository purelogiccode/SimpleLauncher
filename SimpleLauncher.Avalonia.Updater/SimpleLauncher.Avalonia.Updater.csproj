<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFrameworks>net11.0;net11.0-windows</TargetFrameworks>
        <!-- Must stay in sync with SimpleLauncher.Avalonia.csproj. The app publishes this updater
             (framework-dependent) and copies it next to itself, so a different runtime pin here
             could make the updater require a runtime the apps do not. -->
        <RuntimeFrameworkVersion>11.0.0</RuntimeFrameworkVersion>
        <!-- The single updater ships as Updater.exe; it also migrates legacy WPF installs. -->
        <AssemblyName>Updater</AssemblyName>
        <Nullable>enable</Nullable>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>

        <CopyDocumentationFileToOutputDirectory>false</CopyDocumentationFileToOutputDirectory>
        <ImplicitUsings>enable</ImplicitUsings>
        <AssemblyVersion>5.9.2</AssemblyVersion>
        <FileVersion>5.9.2</FileVersion>
        <Version>5.9.2</Version>
        <IsPackable>false</IsPackable>
        <LangVersion>15</LangVersion>
        <ApplicationIcon>icon\icon.ico</ApplicationIcon>
        <NeutralLanguage>en</NeutralLanguage>
        <DebugType>embedded</DebugType>
        <DebugSymbols>true</DebugSymbols>
        <Company>PureLogicCode.com</Company>
        <Product>Simple Launcher Updater</Product>
        <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
        <SupportedOSPlatformVersion>7.0</SupportedOSPlatformVersion>
        <NoWarn>CS0436</NoWarn>
        <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    </PropertyGroup>

    <!-- Cross-platform target (net11.0): Linux + macOS RIDs (must cover every RID
         the app's net11.0 target can publish, since the app build forwards its own
         RuntimeIdentifier to the updater publish). -->
    <PropertyGroup Condition="'$(TargetFramework)' == 'net11.0'">
        <RuntimeIdentifiers>linux-x64;linux-arm64;osx-x64;osx-arm64</RuntimeIdentifiers>
    </PropertyGroup>

    <ItemGroup>
        <Using Include="System.IO" />
        <Using Include="System.Net.Http" />
        <Using Include="Serilog" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\SimpleLauncher.Diagnostics\SimpleLauncher.Diagnostics.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Meziantou.Analyzer" Version="3.0.342">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Roslynator.Analyzers" Version="5.0.1">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Serilog" Version="4.4.0" />
        <PackageReference Include="Serilog.Sinks.Async" Version="2.1.0" />
        <PackageReference Include="Serilog.Sinks.Debug" Version="3.0.0" />
        <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
        <PackageReference Include="SharpCompress" Version="0.50.12" />
        <PackageReference Include="Avalonia" Version="12.2.0" />
        <PackageReference Include="Avalonia.Desktop" Version="12.2.0" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="12.2.0" />
    </ItemGroup>

</Project>