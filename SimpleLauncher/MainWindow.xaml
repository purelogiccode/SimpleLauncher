                                        Grid.Column="5"
                                        x:Name="RetroAchievementsGameButton"
                                        Style="{StaticResource NavImageButton3DStyle}"
                                        ToolTip="{DynamicResource TooltipShowGamesWithRA}"
                                        Click="NavShowGamesWithRetroAchievementsButtonClickAsync"
                                        Margin="10,10,0,0"
                                        AutomationProperties.Name="{DynamicResource ShowGamesWithRetroAchievements}">
                                        <Image Source="pack://application:,,,/images/trophy.png" Width="27" Height="27" />
                                    </Button>
                                    <Button x:Name="SortOrderToggleButton"
                                            Style="{StaticResource NavImageButton3DStyle}"
                                            Grid.Row="1"
                                            Grid.RowSpan="2"
                                            Grid.Column="6"
                                            ToolTip="{DynamicResource TooltipSortOrder}"
                                            Click="SortOrderToggleButtonClickAsync"
                                            Margin="10,10,0,0"
                                            AutomationProperties.Name="{DynamicResource SortByFileNameTooltip}">
                                        <Image Source="pack://application:,,,/images/sort-az.png" Width="27"
                                               Height="27" AutomationProperties.Name="{DynamicResource SortAzIcon}" />
                                    </Button>

                                    <!-- Slider twin of the "Set Button Size" menu (game thumbnail size) -->
                                    <StackPanel
                                        Grid.Row="1"
                                        Grid.RowSpan="2"
                                        Grid.Column="7"
                                        Margin="8,10,0,0"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center"
                                        ToolTip="{DynamicResource TooltipButtonSizeMenu}"
                                        AutomationProperties.Name="{DynamicResource SetButtonSize}">
                                        <TextBlock
                                            Text="◉"
                                            FontSize="10"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource MahApps.Brushes.Gray5}" />
                                        <Slider
                                            x:Name="CardSizeSlider"
                                            Width="80"
                                            Minimum="50"
                                            Maximum="800"
                                            IsSnapToTickEnabled="True"
                                            TickFrequency="50"
                                            Margin="4,0"
                                            VerticalAlignment="Center"
                                            AutomationProperties.Name="{DynamicResource SetButtonSize}"
                                            AutomationProperties.AutomationId="CardSizeSlider"
                                            AutomationProperties.HelpText="{DynamicResource TooltipButtonSizeMenu}" />
                                        <TextBlock
                                            Text="○"
                                            FontSize="10"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource MahApps.Brushes.Gray5}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- <Border Grid.Column="1" -->
                            <!--         VerticalAlignment="Stretch" -->
                            <!--         HorizontalAlignment="Left" -->
                            <!--         MaxHeight="{Binding ElementName=TopSystemSelection, Path=ActualHeight}" -->
                            <!--         x:Name="TopSystemImage" -->
                            <!--         BorderThickness="1" -->
                            <!--         Margin="10,5,0,5" -->
                            <!--         Padding="5" -->
                            <!--         BorderBrush="{DynamicResource MahApps.Brushes.Gray7}" -->
                            <!--         Background="{DynamicResource MahApps.Brushes.Gray9}" -->
                            <!--         ToolTip="{DynamicResource TooltipTopSystemImage}" -->
                            <!--         CornerRadius="5"> -->
                            <!--     <Image x:Name="TopSystemLogoImage" -->
                            <!--            VerticalAlignment="Center" -->
                            <!--            HorizontalAlignment="Center" -->
                            <!--            Stretch="Uniform" -->
                            <!--            ToolTip="{DynamicResource TooltipTopSystemLogoImage}" /> -->
                            <!-- </Border> -->
                        </Grid>

                        <!-- Main Content -->
                        <Grid Grid.Row="1">
                            <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" Margin="5,0,5,0"
                                          ToolTip="{DynamicResource TooltipScroller}">
                                <WrapPanel x:Name="GameFileGrid" Orientation="Horizontal" Margin="0"
                                           ToolTip="{DynamicResource TooltipGameFileGrid}">
                                    <!-- Game buttons will be added here programmatically -->
                                </WrapPanel>
                            </ScrollViewer>

                            <!-- Embedded Grid -->
                            <Grid x:Name="ListViewPreviewArea" Visibility="Collapsed" Margin="0"
                                  ToolTip="{DynamicResource TooltipListViewPreviewArea}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4.5*" />
                                    <ColumnDefinition Width="5" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- DataGrid in the left column -->
                                <DataGrid Grid.Column="0"
                                          Name="GameDataGrid"
                                          MouseDoubleClick="GameListDoubleClickOnSelectedItemAsync"
                                          ItemsSource="{Binding GameListItems}"
                                          Margin="10,5,5,0"
                                          BorderThickness="1"
                                          BorderBrush="{DynamicResource MahApps.Brushes.ThemeForeground}"
                                          Background="{DynamicResource MahApps.Brushes.ThemeBackground}"
                                          Foreground="{DynamicResource MahApps.Brushes.ThemeForeground}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          IsReadOnly="True"
                                          GridLinesVisibility="All"
                                          SelectionChanged="GameListSelectionChanged"
                                          MouseRightButtonUp="GameListRightClickContextMenuAsync"
                                          AutomationProperties.Name="{DynamicResource GameListGrid}"
                                          AutomationProperties.AutomationId="GameDataGrid"
                                          AutomationProperties.HelpText="{DynamicResource GameListGridHelpText}"
                                          ToolTip="{DynamicResource TooltipGameDataGrid}"
                                          RowStyle="{StaticResource CustomDataGridRowStyle}">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="{DynamicResource FavoriteColumnHeader}"
                                                                Width="Auto"
                                                                AutomationProperties.Name="{DynamicResource FavoriteColumnHeader}">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Image Source="pack://application:,,,/images/star.png" Width="16"
                                                           Height="16"
                                                           Visibility="{Binding IsFavorite, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                           AutomationProperties.Name="{Binding IsFavorite, Converter={StaticResource FavoriteStatusConverter}}" />
                                                    <!-- Dynamic AutomationProperties.Name via converter -->
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="{DynamicResource FileNameColumnHeader}"
                                                            Binding="{Binding FileName}" Width="*"
                                                            AutomationProperties.Name="{DynamicResource FileNameColumnHeader}" />
                                        <DataGridTextColumn Header="{DynamicResource MachineDescriptionColumnHeader}"
                                                            Binding="{Binding MachineDescription}" Width="*"
                                                            AutomationProperties.Name="{DynamicResource MachineDescriptionColumnHeader}" />
                                        <DataGridTextColumn Header="{DynamicResource FolderPathColumnHeader}"
                                                            Binding="{Binding FolderPath}" Width="*"
                                                            AutomationProperties.Name="{DynamicResource FolderPathColumnHeader}" />
                                        <DataGridTextColumn Header="{DynamicResource TimesPlayedColumnHeader}"
                                                            Binding="{Binding TimesPlayed}" Width="Auto"
                                                            AutomationProperties.Name="{DynamicResource TimesPlayedColumnHeader}" />
                                        <DataGridTextColumn Header="{DynamicResource PlayTimeColumnHeader}"
                                                            Binding="{Binding PlayTime}" Width="Auto"
                                                            AutomationProperties.Name="{DynamicResource PlayTimeColumnHeader}" />
                                    </DataGrid.Columns>
                                </DataGrid>

                                <!-- GridSplitter between columns 0 and 2 -->
                                <GridSplitter Grid.Row="0" Grid.Column="1"
                                              ResizeDirection="Columns"
                                              Style="{StaticResource EnhancedGridSplitterStyle}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Stretch"
                                              ShowsPreview="True"
                                              ResizeBehavior="PreviousAndNext"
                                              Cursor="SizeWE"
                                              ToolTip="{DynamicResource TooltipGridSplitter}" />

                                <Grid Grid.Column="2" Margin="5,0,10,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Label Grid.Row="0"
                                           Content="{DynamicResource PreviewImage}"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,5" />
                                    <Border Grid.Row="1"
                                            BorderBrush="{DynamicResource MahApps.Brushes.Gray7}"
                                            BorderThickness="1"
                                            Padding="5"
                                            ToolTip="{DynamicResource TooltipPreviewImageBorder}">
                                        <Image Name="PreviewImage"
                                               Stretch="Uniform"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               AutomationProperties.Name="{DynamicResource PreviewImageLabel}"
                                               ToolTip="{DynamicResource TooltipPreviewImage}" />
                                    </Border>
                                </Grid>
                            </Grid>
                        </Grid>

                        <!-- Status Bar / Bottom Area -->
                        <Grid x:Name="StatusBarArea" Grid.Row="2" VerticalAlignment="Center" Margin="0,5,0,5"
                              ToolTip="{DynamicResource TooltipStatusBarArea}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center"
                                        Margin="10,0,0,0"
                                        Orientation="Horizontal">
                                <Label x:Name="StatusBarText" Content="" VerticalAlignment="Center"
                                       VerticalContentAlignment="Center"
                                       ToolTip="{DynamicResource TooltipStatusBarText}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Margin="0">
                                <Button x:Name="PrevPageButton"
                                        Margin="0"
                                        ToolTip="{DynamicResource TooltipPreviousPage}"
                                        Style="{StaticResource NavImageButton3DStyle}"
                                        Click="PrevPageButtonClickAsync"
                                        AutomationProperties.Name="{DynamicResource PreviousPage}">
                                    <Image Source="pack://application:,,,/images/arrowleft.png"
                                           Height="27"
                                           Width="27" AutomationProperties.Name="{DynamicResource ArrowLeftIcon}" />
                                </Button>
                                <Button x:Name="NextPageButton"
                                        Margin="10,0,0,0"
                                        ToolTip="{DynamicResource TooltipNextPage}"
                                        Style="{StaticResource NavImageButton3DStyle}"
                                        Click="NextPageButtonClickAsync"
                                        AutomationProperties.Name="{DynamicResource NextPage}">
                                    <Image Source="pack://application:,,,/images/arrowright.png"
                                           Height="27"
                                           Width="27" AutomationProperties.Name="{DynamicResource ArrowRightIcon}" />
                                </Button>
                                <Label
                                    x:Name="TotalFilesLabel"
                                    Margin="10,0,0,0"
                                    Content=""
                                    VerticalAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    AutomationProperties.Name="{DynamicResource TotalFilesLabel}"
                                    ToolTip="{DynamicResource TooltipTotalFilesLabel}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Margin="10,0,0,0"
                                        Orientation="Horizontal">
                                <!-- System Info -->
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="5,0,15,0"
                                            AutomationProperties.Name="{DynamicResource CurrentSystemInfo}"
                                            ToolTip="{DynamicResource TooltipCurrentSystemInfo}">
                                    <Image Source="pack://application:,,,/images/gamepad.png" Width="16" Height="16"
                                           VerticalAlignment="Center" Margin="0,0,5,0"
                                           AutomationProperties.Name="{DynamicResource GamepadIcon}" />
                                    <Label Content="{DynamicResource System}" VerticalAlignment="Center" Padding="0" />
                                    <Label Content="{Binding SelectedSystem, FallbackValue=''}"
                                           VerticalAlignment="Center" Padding="5,0,0,0" />
                                </StackPanel>
                                <!-- Playtime Info -->
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="5,0,10,0"
                                            AutomationProperties.Name="{DynamicResource TotalPlaytimeInfo}"
                                            Visibility="{Binding IsPlayTimeVisible, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}"
                                            ToolTip="{DynamicResource TooltipTotalPlaytimeInfo}">
                                    <Image Source="pack://application:,,,/images/playhistory.png" Width="16"
                                           Height="16" VerticalAlignment="Center" Margin="0,0,5,0"
                                           AutomationProperties.Name="{DynamicResource PlayHistoryIcon}" />
                                    <Label Content="{DynamicResource Playtime}" VerticalAlignment="Center" Padding="0" />
                                    <Label Content="{Binding PlayTime, FallbackValue=''}" VerticalAlignment="Center"
                                           Padding="5,0,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                    </Grid>

                    <!-- Page Content Frame - for hosting Pages like Favorites, GlobalSearch, PlayHistory -->
                    <!-- This Frame is at the same level as MainGameContent, not inside it -->
                    <Frame x:Name="PageContentFrame"
                           Visibility="Collapsed"
                           NavigationUIVisibility="Hidden"
                           ToolTip="{DynamicResource TooltipPageContentFrame}" />
                </Grid>
            </Grid> <!-- Content grid -->

        </Grid> <!-- MainContentGrid ends -->

        <!-- Loading Overlay stays OUTSIDE MainContentGrid so it remains active -->
        <!-- This ensures the overlay and its Emergency Return Button work even when MainContentGrid is disabled -->
        <ContentControl x:Name="LoadingOverlay"
                        Panel.ZIndex="9999"
                        Template="{StaticResource LoadingOverlayTemplate}"
                        Visibility="Collapsed"
                        ToolTip="{DynamicResource TooltipLoadingOverlay}" />
    </Grid> <!-- Root Grid ends -->

</mah:MetroWindow>