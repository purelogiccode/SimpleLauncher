<controls:MetroWindow x:Class="SimpleLauncher.UpdateLogWindow"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:controls="http://metro.mahapps.com/winfx/xaml/controls"
                      Title="{DynamicResource Updating}"
                      Width="600"
                      Height="400"
                      WindowStartupLocation="CenterScreen"
                      ResizeMode="NoResize"
                      Background="{StaticResource UpdateLogWindowBackground}"
                      GlowBrush="Black">
    <Grid>
        <TextBox Text="{Binding LogText, Mode=OneWay}"
                 HorizontalScrollBarVisibility="Auto"
                 Style="{StaticResource LogTextBoxStyle}"
                 AutomationProperties.Name="{DynamicResource TooltipUpdateLog}"
                 AutomationProperties.AutomationId="LogTextBox"
                 ToolTip="{DynamicResource TooltipUpdateLog}" />
    </Grid>
</controls:MetroWindow>