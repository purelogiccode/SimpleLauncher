<controls:MetroWindow x:Class="SimpleLauncher.DosBoxFileSelectionWindow"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:controls="http://metro.mahapps.com/winfx/xaml/controls"
                      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d"
                      Title="{DynamicResource DosBoxSelectFileTitle}"
                      Width="650"
                      Height="480"
                      MinWidth="450"
                      MinHeight="300"
                      ResizeMode="CanResize"
                      WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{DynamicResource DosBoxSelectFileInstruction}"
                   Margin="10,5,10,10"
                   FontSize="14"
                   TextWrapping="Wrap" />

        <ListBox x:Name="FileListBox"
                 Grid.Row="1"
                 ItemsSource="{Binding FileItems}"
                 SelectedItem="{Binding SelectedItem}"
                 MouseDoubleClick="FileListBox_MouseDoubleClick"
                 Margin="10,0"
                 Padding="5"
                 VerticalAlignment="Stretch"
                 HorizontalAlignment="Stretch"
                 AutomationProperties.Name="{DynamicResource DosBoxSelectFileInstruction}"
                 ToolTip="{DynamicResource DosBoxSelectFileTooltip}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <TextBlock Text="{Binding DisplayName}"
                                   Margin="5,2,5,2"
                                   FontSize="14"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{Binding RelativePath}"
                                   Margin="5,0,5,2"
                                   FontSize="11"
                                   Foreground="{DynamicResource MahApps.Brushes.Gray}" />
                        <Separator Margin="5,2" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10,15,10,5">
            <Button Content="{DynamicResource Cancel}"
                    Margin="5,0"
                    Command="{Binding CancelCommand}"
                    MinWidth="75"
                    AutomationProperties.Name="{DynamicResource Cancel}"
                    AutomationProperties.AutomationId="CancelButton"
                    ToolTip="{DynamicResource TooltipDosBoxCancel}" />
            <Button Content="{DynamicResource DosBoxSelectFileLaunch}"
                    Margin="5,0"
                    Command="{Binding LaunchCommand}"
                    MinWidth="75"
                    IsEnabled="{Binding IsLaunchEnabled}"
                    AutomationProperties.Name="{DynamicResource DosBoxSelectFileLaunch}"
                    AutomationProperties.AutomationId="LaunchButton"
                    ToolTip="{DynamicResource TooltipDosBoxLaunch}" />
        </StackPanel>
    </Grid>
</controls:MetroWindow>