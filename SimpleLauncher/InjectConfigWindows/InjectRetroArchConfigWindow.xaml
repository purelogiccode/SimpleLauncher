<controls:MetroWindow x:Class="SimpleLauncher.InjectConfigWindows.InjectRetroArchConfigWindow"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:controls="http://metro.mahapps.com/winfx/xaml/controls"
                      Title="{DynamicResource RetroArchConfig_Title}"
                      Height="800" Width="700"
                      ResizeMode="CanResize"
                      WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Video Section -->
                <GroupBox Header="{DynamicResource RetroArchConfig_Video_Header}" Margin="0,0,0,10">
                    <StackPanel Margin="5">
                        <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Label Content="{DynamicResource RetroArchConfig_VideoDriver_Label}"
                                   VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding VideoDriverOptions}"
                                      SelectedItem="{Binding VideoDriver}"
                                      AutomationProperties.Name="Video Driver"
                                      AutomationProperties.AutomationId="VideoDriverComboBox"
                                      ToolTip="{DynamicResource RetroArchConfig_VideoDriver_Tooltip}" />
                        </Grid>
                        <CheckBox IsChecked="{Binding Fullscreen}"
                                  Content="{DynamicResource RetroArchConfig_Fullscreen_Checkbox}" Margin="0,5"
                                  ToolTip="{DynamicResource RetroArchConfig_Fullscreen_Tooltip}" />
                        <CheckBox IsChecked="{Binding Vsync}"
                                  Content="{DynamicResource RetroArchConfig_VSync_Checkbox}" Margin="0,5"
                                  ToolTip="{DynamicResource RetroArchConfig_VSync_Tooltip}" />
                        <CheckBox IsChecked="{Binding ThreadedVideo}"
                                  Content="{DynamicResource RetroArchConfig_ThreadedVideo_Checkbox}" Margin="0,5"
                                  ToolTip="{DynamicResource RetroArchConfig_ThreadedVideo_Tooltip}" />
                        <CheckBox IsChecked="{Binding Bilinear}"
                                  Content="{DynamicResource RetroArchConfig_Bilinear_Checkbox}" Margin="0,5"
                                  ToolTip="{DynamicResource RetroArchConfig_Bilinear_Tooltip}" />
                        <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Label Content="{DynamicResource RetroArchConfig_AspectRatio_Label}"
                                   VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding AspectRatioIndexOptions}"
                                      SelectedItem="{Binding AspectRatioIndex}"
                                      AutomationProperties.Name="Aspect Ratio"
                                      AutomationProperties.AutomationId="AspectRatioIndexComboBox"
                                      ToolTip="{DynamicResource RetroArchConfig_AspectRatio_Tooltip}" />
                        </Grid>
                        <CheckBox IsChecked="{Binding ScaleInteger}"
                                  Content="{DynamicResource RetroArchConfig_IntegerScale_Checkbox}" Margin="0,5"
                                  ToolTip="{DynamicResource RetroArchConfig_IntegerScale_Tooltip}" />
                        <CheckBox IsChecked="{Binding ShaderEnable}"
                                  Content="{DynamicResource RetroArchConfig_Shaders_Checkbox}" Margin="0,5"
                                  ToolTip="{DynamicResource RetroArchConfig_Shaders_Tooltip}" />
                        <CheckBox IsChecked="{Binding HardSync}"
                                  Content="{DynamicResource RetroArchConfig_HardSync_Checkbox}" Margin="0,5"
                                  ToolTip="{DynamicResource RetroArchConfig_HardSync_Tooltip}" />
                    </StackPanel>
                </GroupBox>

                <!-- Audio Section -->
                <GroupBox Header="{DynamicResource RetroArchConfig_Audio_Header}" Margin="0,0,0,10">
                    <StackPanel Margin="5">
                        <CheckBox IsChecked="{Binding AudioEnable}"
                                  Content="{DynamicResource RetroArchConfig_AudioEnable_Checkbox}" Margin="0,5"
                                  ToolTip="{DynamicResource RetroArchConfig_AudioEnable_Tooltip}" />
                        <CheckBox IsChecked="{Binding AudioMute}"
                                  Content="{DynamicResource RetroArchConfig_AudioMute_Checkbox}" Margin="0,5"
                                  ToolTip="{DynamicResource RetroArchConfig_AudioMute_Tooltip}" />
                    </StackPanel>
                </GroupBox>

                <!-- Automation & Misc -->
                <GroupBox Header="{DynamicResource RetroArchConfig_AutomationBehavior_Header}" Margin="0,0,0,10">
                    <StackPanel Margin="5">
                        <CheckBox IsChecked="{Binding PauseNonActive}"
                                  Content="{DynamicResource RetroArchConfig_PauseNonActive_Checkbox}" Margin="0,5"
                                  ToolTip="{DynamicResource RetroArchConfig_PauseNonActive_Tooltip}" />
                        <CheckBox IsChecked="{Binding SaveOnExit}"
                                  Content="{DynamicResource RetroArchConfig_SaveOnExit_Checkbox}" Margin="0,5"
                                  ToolTip="{DynamicResource RetroArchConfig_SaveOnExit_Tooltip}" />
                        <CheckBox IsChecked="{Binding AutoSaveState}"
                                  Content="{DynamicResource RetroArchConfig_AutoSaveState_Checkbox}" Margin="0,5"
                                  ToolTip="{DynamicResource RetroArchConfig_AutoSaveState_Tooltip}" />
                        <CheckBox IsChecked="{Binding AutoLoadState}"
                                  Content="{DynamicResource RetroArchConfig_AutoLoadState_Checkbox}" Margin="0,5"
                                  ToolTip="{DynamicResource RetroArchConfig_AutoLoadState_Tooltip}" />
                        <CheckBox IsChecked="{Binding Rewind}"
                                  Content="{DynamicResource RetroArchConfig_Rewind_Checkbox}" Margin="0,5"
                                  ToolTip="{DynamicResource RetroArchConfig_Rewind_Tooltip}" />
                        <CheckBox IsChecked="{Binding RunAhead}"
                                  Content="{DynamicResource RetroArchConfig_RunAhead_Checkbox}" Margin="0,5"
                                  ToolTip="{DynamicResource RetroArchConfig_RunAhead_Tooltip}" />
                    </StackPanel>
                </GroupBox>

                <!-- UI Section -->
                <GroupBox Header="{DynamicResource RetroArchConfig_UI_Header}" Margin="0,0,0,10">
                    <StackPanel Margin="5">
                        <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Label Content="{DynamicResource RetroArchConfig_MenuDriver_Label}"
                                   VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding MenuDriverOptions}"
                                      SelectedItem="{Binding MenuDriver}"
                                      AutomationProperties.Name="Menu Driver"
                                      AutomationProperties.AutomationId="MenuDriverComboBox"
                                      ToolTip="{DynamicResource RetroArchConfig_MenuDriver_Tooltip}" />
                        </Grid>
                        <CheckBox IsChecked="{Binding ShowAdvancedSettings}"
                                  Content="{DynamicResource RetroArchConfig_AdvancedSettings_Checkbox}" Margin="0,5"
                                  ToolTip="{DynamicResource RetroArchConfig_AdvancedSettings_Tooltip}" />
                    </StackPanel>
                </GroupBox>

                <!-- RetroAchievements -->
                <GroupBox Header="{DynamicResource RetroArchConfig_RetroAchievements_Header}" Margin="0,0,0,10">
                    <StackPanel Margin="5">
                        <TextBlock Text="{DynamicResource RetroArchConfig_CredentialsManaged_Text}" FontStyle="Italic"
                                   Margin="0,0,0,5" TextWrapping="Wrap" />
                        <CheckBox IsChecked="{Binding CheevosEnable}"
                                  Content="{DynamicResource RetroArchConfig_EnableCheevos_Checkbox}" Margin="0,5"
                                  ToolTip="{DynamicResource RetroArchConfig_EnableCheevos_Tooltip}" />
                        <CheckBox IsChecked="{Binding CheevosHardcore}"
                                  Content="{DynamicResource RetroArchConfig_HardcoreMode_Checkbox}" Margin="0,5"
                                  ToolTip="{DynamicResource RetroArchConfig_HardcoreMode_Tooltip}" />
                        <CheckBox IsChecked="{Binding DiscordAllow}"
                                  Content="{DynamicResource RetroArchConfig_DiscordPresence_Checkbox}" Margin="0,5"
                                  ToolTip="{DynamicResource RetroArchConfig_DiscordPresence_Tooltip}" />
                    </StackPanel>
                </GroupBox>

                <!-- CRITICAL SETTING -->
                <Border Style="{StaticResource ImportantSettingBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource IMPORTANTSETTING}"
                                   Style="{StaticResource ImportantSettingHeaderStyle}" />
                        <CheckBox IsChecked="{Binding ShowBeforeLaunch}"
                                  Content="{DynamicResource RetroArchConfig_ShowBeforeLaunch_Checkbox}"
                                  Style="{StaticResource ImportantSettingCheckBoxStyle}"
                                  ToolTip="{DynamicResource RetroArchConfig_ShowBeforeLaunch_Tooltip}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="BtnSave" Content="{DynamicResource RetroArchConfig_Save_Button}"
                    Style="{DynamicResource DialogSecondaryButtonStyle}"
                    Command="{Binding SaveCommand}"
                    AutomationProperties.Name="Save"
                    ToolTip="{DynamicResource RetroArchConfig_Save_Tooltip}" />
            <Button x:Name="BtnRun" Content="{DynamicResource RetroArchConfig_Run_Button2}"
                    Style="{DynamicResource DialogPrimaryButtonStyle}"
                    Command="{Binding RunCommand}" IsDefault="True"
                    Visibility="{Binding IsLauncherMode, Converter={StaticResource BooleanToVisibilityConverter}}"
                    AutomationProperties.Name="Save &amp; Run"
                    ToolTip="{DynamicResource RetroArchConfig_Run_Tooltip}" />
            <Button Content="{DynamicResource RetroArchConfig_Cancel_Button}"
                    Style="{DynamicResource DialogCancelButtonStyle}"
                    Command="{Binding CancelCommand}"
                    AutomationProperties.Name="Cancel"
                    ToolTip="{DynamicResource RetroArchConfig_Cancel_Tooltip}" />
        </StackPanel>
    </Grid>
</controls:MetroWindow>