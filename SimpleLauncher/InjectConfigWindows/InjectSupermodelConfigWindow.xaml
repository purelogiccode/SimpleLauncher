<controls:MetroWindow x:Class="SimpleLauncher.InjectConfigWindows.InjectSupermodelConfigWindow"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:controls="http://metro.mahapps.com/winfx/xaml/controls"
                      Title="{DynamicResource SupermodelConfig_Title}"
                      Height="750" Width="700"
                      ResizeMode="CanResize"
                      WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Video Section -->
                <GroupBox Header="{DynamicResource SupermodelConfig_Video_Header}" Margin="0,0,0,10">
                    <StackPanel Margin="5">
                        <CheckBox IsChecked="{Binding New3DEngine}"
                                  Content="{DynamicResource SupermodelConfig_New3DEngine_Checkbox}" Margin="0,5"
                                  ToolTip="{DynamicResource SupermodelConfig_New3DEngine_Tooltip}" />
                        <CheckBox IsChecked="{Binding QuadRendering}"
                                  Content="{DynamicResource SupermodelConfig_QuadRendering_Checkbox}" Margin="0,5"
                                  ToolTip="{DynamicResource SupermodelConfig_QuadRendering_Tooltip}" />
                        <CheckBox IsChecked="{Binding Fullscreen}"
                                  Content="{DynamicResource SupermodelConfig_Fullscreen_Checkbox}" Margin="0,5"
                                  ToolTip="{DynamicResource SupermodelConfig_Fullscreen_Tooltip}" />
                        <CheckBox IsChecked="{Binding Vsync}"
                                  Content="{DynamicResource SupermodelConfig_Vsync_Checkbox}" Margin="0,5"
                                  ToolTip="{DynamicResource SupermodelConfig_Vsync_Tooltip}" />
                        <CheckBox IsChecked="{Binding WideScreen}"
                                  Content="{DynamicResource SupermodelConfig_Widescreen_Checkbox}" Margin="0,5"
                                  ToolTip="{DynamicResource SupermodelConfig_Widescreen_Tooltip}" />
                        <CheckBox IsChecked="{Binding Stretch}"
                                  Content="{DynamicResource SupermodelConfig_Stretch_Checkbox}" Margin="0,5"
                                  ToolTip="{DynamicResource SupermodelConfig_Stretch_Tooltip}" />

                        <Label Content="{DynamicResource SupermodelConfig_Resolution_Label}" Margin="0,5,0,0"
                               ToolTip="{DynamicResource SupermodelConfig_Resolution_Tooltip}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <controls:NumericUpDown Value="{Binding ResX}" Grid.Column="0" Minimum="640" Maximum="7680"
                                                    Interval="1"
                                                    ToolTip="{DynamicResource SupermodelConfig_ResolutionX_Tooltip}" />
                            <TextBlock Text="x" Grid.Column="1" VerticalAlignment="Center" Margin="10,0" />
                            <controls:NumericUpDown Value="{Binding ResY}" Grid.Column="2" Minimum="480" Maximum="4320"
                                                    Interval="1"
                                                    ToolTip="{DynamicResource SupermodelConfig_ResolutionY_Tooltip}" />
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <!-- Audio Section -->
                <GroupBox Header="{DynamicResource SupermodelConfig_Audio_Header}" Margin="0,0,0,10">
                    <StackPanel Margin="5">
                        <Label Content="{DynamicResource SupermodelConfig_MusicVolume_Label}"
                               VerticalAlignment="Center" />
                        <Slider Value="{Binding MusicVolume}" Minimum="0" Maximum="100" IsSnapToTickEnabled="True"
                                AutomationProperties.Name="Music Volume"
                                TickFrequency="1" ToolTip="{DynamicResource SupermodelConfig_MusicVolume_Tooltip}" />
                        <Label Content="{DynamicResource SupermodelConfig_SoundVolume_Label}"
                               VerticalAlignment="Center" Margin="0,5,0,0" />
                        <Slider Value="{Binding SoundVolume}" Minimum="0" Maximum="100" IsSnapToTickEnabled="True"
                                AutomationProperties.Name="Sound Effects Volume"
                                TickFrequency="1" ToolTip="{DynamicResource SupermodelConfig_SoundVolume_Tooltip}" />
                    </StackPanel>
                </GroupBox>

                <!-- System & Performance Section -->
                <GroupBox Header="{DynamicResource SupermodelConfig_System_Header}" Margin="0,0,0,10">
                    <StackPanel Margin="5">
                        <CheckBox IsChecked="{Binding Throttle}"
                                  Content="{DynamicResource SupermodelConfig_Throttle_Checkbox}" Margin="0,5"
                                  ToolTip="{DynamicResource SupermodelConfig_Throttle_Tooltip}" />
                        <CheckBox IsChecked="{Binding MultiThreaded}"
                                  Content="{DynamicResource SupermodelConfig_MultiThreaded_Checkbox}" Margin="0,5"
                                  ToolTip="{DynamicResource SupermodelConfig_MultiThreaded_Tooltip}" />

                        <Grid Margin="0,5,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Label Content="{DynamicResource SupermodelConfig_InputSystem_Label}"
                                   VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding InputSystemOptions}"
                                      SelectedItem="{Binding InputSystem}"
                                      AutomationProperties.Name="Input System"
                                      AutomationProperties.AutomationId="InputSystemComboBox"
                                      ToolTip="{DynamicResource SupermodelConfig_InputSystem_Tooltip}" />
                        </Grid>

                        <Grid Margin="0,5,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Label Content="{DynamicResource SupermodelConfig_PpcFrequency_Label}"
                                   VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding PpcFrequencyOptions}"
                                      SelectedItem="{Binding PowerPcFrequency}"
                                      AutomationProperties.Name="PowerPC Frequency (MHz)"
                                      AutomationProperties.AutomationId="PpcFrequencyComboBox"
                                      ToolTip="{DynamicResource SupermodelConfig_PpcFrequency_Tooltip}" />
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <!-- CRITICAL SETTING -->
                <Border Style="{StaticResource ImportantSettingBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource IMPORTANTSETTING}"
                                   Style="{StaticResource ImportantSettingHeaderStyle}" />
                        <CheckBox IsChecked="{Binding ShowBeforeLaunch}"
                                  Content="{DynamicResource SupermodelConfig_ShowBeforeLaunch_Checkbox}"
                                  Style="{StaticResource ImportantSettingCheckBoxStyle}"
                                  ToolTip="{DynamicResource SupermodelConfig_ShowBeforeLaunch_Tooltip}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="BtnSave" Content="{DynamicResource SupermodelConfig_Save_Button}"
                    Style="{DynamicResource DialogSecondaryButtonStyle}"
                    Command="{Binding SaveCommand}"
                    AutomationProperties.Name="Save"
                    ToolTip="{DynamicResource SupermodelConfig_Save_Tooltip}" />
            <Button x:Name="BtnRun" Content="{DynamicResource SupermodelConfig_Run_Button2}"
                    Style="{DynamicResource DialogPrimaryButtonStyle}"
                    Command="{Binding RunCommand}" IsDefault="True"
                    Visibility="{Binding IsLauncherMode, Converter={StaticResource BooleanToVisibilityConverter}}"
                    AutomationProperties.Name="Save &amp; Run"
                    ToolTip="{DynamicResource SupermodelConfig_Run_Tooltip}" />
            <Button Content="{DynamicResource SupermodelConfig_Cancel_Button}"
                    Style="{DynamicResource DialogCancelButtonStyle}"
                    Command="{Binding CancelCommand}"
                    AutomationProperties.Name="Cancel"
                    ToolTip="{DynamicResource SupermodelConfig_Cancel_Tooltip}" />
        </StackPanel>
    </Grid>
</controls:MetroWindow>