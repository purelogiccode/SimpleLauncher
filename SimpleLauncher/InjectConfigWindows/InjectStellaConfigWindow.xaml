<controls:MetroWindow x:Class="SimpleLauncher.InjectConfigWindows.InjectStellaConfigWindow"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:controls="http://metro.mahapps.com/winfx/xaml/controls"
                      Title="{DynamicResource StellaConfig_Title}"
                      Height="700" Width="700"
                      ResizeMode="CanResize"
                      WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Video Section -->
                <GroupBox Header="{DynamicResource StellaConfig_Video_Header}" Margin="0,0,0,10">
                    <StackPanel Margin="5">
                        <CheckBox IsChecked="{Binding Fullscreen}"
                                  Content="{DynamicResource StellaConfig_Fullscreen_Checkbox}" Margin="0,5"
                                  ToolTip="{DynamicResource StellaConfig_Fullscreen_Tooltip}" />
                        <CheckBox IsChecked="{Binding Vsync}" Content="{DynamicResource StellaConfig_Vsync_Checkbox}"
                                  Margin="0,5" ToolTip="{DynamicResource StellaConfig_Vsync_Tooltip}" />
                        <CheckBox IsChecked="{Binding CorrectAspect}"
                                  Content="{DynamicResource StellaConfig_CorrectAspect_Checkbox}" Margin="0,5"
                                  ToolTip="{DynamicResource StellaConfig_CorrectAspect_Tooltip}" />
                        <Grid Margin="0,5,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Label Content="{DynamicResource StellaConfig_VideoDriver_Label}"
                                   VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding VideoDriverOptions}"
                                      SelectedItem="{Binding VideoDriver}"
                                      AutomationProperties.Name="Video Driver"
                                      AutomationProperties.AutomationId="VideoDriverComboBox"
                                      ToolTip="{DynamicResource StellaConfig_VideoDriver_Tooltip}" />
                        </Grid>
                        <Grid Margin="0,5,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Label Content="{DynamicResource StellaConfig_TvFilter_Label}" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding TvFilterOptions}"
                                      SelectedItem="{Binding TvFilter}"
                                      AutomationProperties.Name="TV Effects"
                                      AutomationProperties.AutomationId="TvFilterComboBox"
                                      ToolTip="{DynamicResource StellaConfig_TvFilter_Tooltip}" />
                        </Grid>
                        <Label Content="{DynamicResource StellaConfig_Scanlines_Label}" VerticalAlignment="Center" />
                        <Slider Value="{Binding Scanlines}" Minimum="0" Maximum="100" IsSnapToTickEnabled="True"
                                AutomationProperties.Name="Scanlines Intensity"
                                TickFrequency="1" ToolTip="{DynamicResource StellaConfig_Scanlines_Tooltip}" />
                    </StackPanel>
                </GroupBox>

                <!-- Audio Section -->
                <GroupBox Header="{DynamicResource StellaConfig_Audio_Header}" Margin="0,0,0,10">
                    <StackPanel Margin="5">
                        <CheckBox IsChecked="{Binding AudioEnabled}"
                                  Content="{DynamicResource StellaConfig_AudioEnabled_Checkbox}" Margin="0,5"
                                  ToolTip="{DynamicResource StellaConfig_AudioEnabled_Tooltip}" />
                        <Label Content="{DynamicResource StellaConfig_AudioVolume_Label}" VerticalAlignment="Center" />
                        <Slider Value="{Binding AudioVolume}" Minimum="0" Maximum="100" IsSnapToTickEnabled="True"
                                AutomationProperties.Name="Master Volume"
                                TickFrequency="1" ToolTip="{DynamicResource StellaConfig_AudioVolume_Tooltip}" />
                    </StackPanel>
                </GroupBox>

                <!-- Features Section -->
                <GroupBox Header="{DynamicResource StellaConfig_Features_Header}" Margin="0,0,0,10">
                    <StackPanel Margin="5">
                        <CheckBox IsChecked="{Binding TimeMachine}"
                                  Content="{DynamicResource StellaConfig_TimeMachine_Checkbox}" Margin="0,5"
                                  ToolTip="{DynamicResource StellaConfig_TimeMachine_Tooltip}" />
                        <CheckBox IsChecked="{Binding ConfirmExit}"
                                  Content="{DynamicResource StellaConfig_ConfirmExit_Checkbox}" Margin="0,5"
                                  ToolTip="{DynamicResource StellaConfig_ConfirmExit_Tooltip}" />
                    </StackPanel>
                </GroupBox>

                <!-- CRITICAL SETTING -->
                <Border Style="{StaticResource ImportantSettingBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource IMPORTANTSETTING}"
                                   Style="{StaticResource ImportantSettingHeaderStyle}" />
                        <CheckBox IsChecked="{Binding ShowBeforeLaunch}"
                                  Content="{DynamicResource StellaConfig_ShowBeforeLaunch_Checkbox}"
                                  Style="{StaticResource ImportantSettingCheckBoxStyle}"
                                  ToolTip="{DynamicResource StellaConfig_ShowBeforeLaunch_Tooltip}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="BtnSave" Content="{DynamicResource StellaConfig_Save_Button}"
                    Style="{DynamicResource DialogSecondaryButtonStyle}"
                    Command="{Binding SaveCommand}"
                    AutomationProperties.Name="Save"
                    ToolTip="{DynamicResource StellaConfig_Save_Tooltip}" />
            <Button x:Name="BtnRun" Content="{DynamicResource StellaConfig_Run_Button2}"
                    Style="{DynamicResource DialogPrimaryButtonStyle}"
                    Command="{Binding RunCommand}" IsDefault="True"
                    Visibility="{Binding IsLauncherMode, Converter={StaticResource BooleanToVisibilityConverter}}"
                    AutomationProperties.Name="Save &amp; Run"
                    ToolTip="{DynamicResource StellaConfig_Run_Tooltip}" />
            <Button Content="{DynamicResource StellaConfig_Cancel_Button}"
                    Style="{DynamicResource DialogCancelButtonStyle}"
                    Command="{Binding CancelCommand}"
                    AutomationProperties.Name="Cancel"
                    ToolTip="{DynamicResource StellaConfig_Cancel_Tooltip}" />
        </StackPanel>
    </Grid>
</controls:MetroWindow>