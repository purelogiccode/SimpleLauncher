<controls:MetroWindow x:Class="SimpleLauncher.SupportWindow"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:controls="http://metro.mahapps.com/winfx/xaml/controls"
                      Title="{DynamicResource Support}"
                      Width="600"
                      Height="450"
                      ResizeMode="NoResize"
                      WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid x:Name="MainContentGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="10,10,10,20">
                <TextBlock Text="{DynamicResource UsetheformbelowToGetSupport}" />
            </StackPanel>

            <StackPanel Grid.Row="1" Grid.Column="0" Margin="10,0,10,10" Orientation="Horizontal">
                <TextBlock Text="{DynamicResource Name}" Width="95" VerticalAlignment="Center" />
                <TextBox x:Name="NameTextBox" Width="270" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="{DynamicResource Name}"
                         AutomationProperties.AutomationId="NameTextBox"
                         ToolTip="{DynamicResource TooltipName}" />
            </StackPanel>

            <StackPanel Grid.Row="2" Grid.Column="0" Margin="10,0,10,20" Orientation="Horizontal">
                <TextBlock Text="{DynamicResource Email}" Width="95" VerticalAlignment="Center" />
                <TextBox x:Name="EmailTextBox" Width="270" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="{DynamicResource Email}"
                         AutomationProperties.AutomationId="EmailTextBox"
                         ToolTip="{DynamicResource TooltipEmail}" />
            </StackPanel>

            <TextBox
                x:Name="SupportTextBox"
                Grid.Row="3"
                Height="200"
                Margin="10,0,10,20"
                AcceptsReturn="True"
                TextWrapping="Wrap"
                VerticalScrollBarVisibility="Auto"
                Text="{Binding SupportRequest, UpdateSourceTrigger=PropertyChanged}"
                AutomationProperties.Name="{DynamicResource TooltipSupportDetails}"
                AutomationProperties.AutomationId="SupportTextBox"
                ToolTip="{DynamicResource TooltipSupportDetails}" />

            <StackPanel
                Grid.Row="4"
                Margin="10,0,10,20"
                HorizontalAlignment="Center"
                Orientation="Horizontal">
                <Button
                    Style="{DynamicResource MahApps.Styles.Button.Square.Accent}"
                    IsDefault="True"
                    Command="{Binding SendSupportRequestCommand}"
                    Content="{DynamicResource SendSupportRequest}"
                    AutomationProperties.Name="{DynamicResource SendSupportRequest}"
                    AutomationProperties.AutomationId="SendSupportRequestButton"
                    ToolTip="{DynamicResource TooltipSendSupport}" />
                <Button
                    Style="{DynamicResource MahApps.Styles.Button.Square}"
                    IsCancel="True"
                    Margin="10,0,0,0"
                    Command="{Binding CloseCommand}"
                    Content="{DynamicResource Close}"
                    AutomationProperties.Name="{DynamicResource Close}"
                    AutomationProperties.AutomationId="CloseButton"
                    ToolTip="{DynamicResource TooltipClose}" />
            </StackPanel>
        </Grid>

        <!-- Overlay for Progress Ring -->
        <ContentControl x:Name="LoadingOverlay"
                        Template="{StaticResource LoadingOverlayTemplate}"
                        Visibility="Collapsed"
                        Grid.Row="0" />
    </Grid>
</controls:MetroWindow>