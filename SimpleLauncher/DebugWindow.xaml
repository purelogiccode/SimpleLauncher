<mah:MetroWindow x:Class="SimpleLauncher.DebugWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 mc:Ignorable="d"
                 Title="{DynamicResource Debugger}" Height="400" Width="800"
                 WindowStartupLocation="Manual"
                 Left="100"
                 Top="100">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBox x:Name="LogTextBox"
                 Style="{StaticResource LogTextBoxStyle}"
                 Grid.Row="0"
                 HorizontalScrollBarVisibility="Auto"
                 Margin="5"
                 FontSize="12"
                 Text="{Binding LogText, Mode=OneWay}"
                 AutomationProperties.Name="{DynamicResource TooltipDebuggerLog}"
                 AutomationProperties.AutomationId="LogTextBox"
                 ToolTip="{DynamicResource TooltipDebuggerLog}" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="5">
            <Button Content="{DynamicResource ClearLog}" Margin="5,0" Command="{Binding ClearLogCommand}"
                    Style="{DynamicResource MahApps.Styles.Button.Square}"
                    AutomationProperties.Name="{DynamicResource ClearLog}"
                    AutomationProperties.AutomationId="ClearLogButton"
                    ToolTip="{DynamicResource TooltipClearLog}" />
            <Button Content="{DynamicResource CopyLog}" Margin="5,0" Command="{Binding CopyLogCommand}"
                    Style="{DynamicResource MahApps.Styles.Button.Square}"
                    AutomationProperties.Name="{DynamicResource CopyLog}"
                    AutomationProperties.AutomationId="CopyLogButton"
                    ToolTip="{DynamicResource TooltipCopyLog}" />
            <Button Content="{DynamicResource Close}" Margin="5,0"
                    Style="{DynamicResource DialogCancelButtonStyle}"
                    Click="CloseButton_Click"
                    AutomationProperties.Name="{DynamicResource Close}"
                    AutomationProperties.AutomationId="CloseButton"
                    ToolTip="{DynamicResource TooltipClose}" />
        </StackPanel>
    </Grid>
</mah:MetroWindow>