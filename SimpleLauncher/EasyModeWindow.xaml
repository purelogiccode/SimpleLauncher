<controls:MetroWindow x:Class="SimpleLauncher.EasyModeWindow"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:controls="http://metro.mahapps.com/winfx/xaml/controls"
                      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                      mc:Ignorable="d"
                      Title="{DynamicResource AddNewSystem}"
                      Width="900"
                      MinWidth="700"
                      Height="610"
                      MinHeight="550"
                      WindowStartupLocation="CenterScreen"
                      DataContext="{Binding RelativeSource={RelativeSource Self}}" x:ClassModifier="internal">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Header Text -->
            <RowDefinition Height="*" />    <!-- Main Content -->
            <RowDefinition Height="Auto" /> <!-- Footer / Progress -->
        </Grid.RowDefinitions>

        <!-- 1. Header Section -->
        <StackPanel Grid.Row="0" Margin="20,20,20,10">
            <TextBlock Text="{DynamicResource AddNewSystem}" FontSize="24" FontWeight="Light" Margin="0,0,0,10" />
            <TextBlock Text="{DynamicResource InThisWindowYouCanDownload}" TextWrapping="Wrap" FontSize="12"
                       Opacity="0.6" />
            <TextBlock Text="{DynamicResource WeAlsoSupportSystems}" TextWrapping="Wrap" FontSize="12" Opacity="0.6"
                       Margin="0,5,0,0" />
        </StackPanel>

        <!-- 2. Main Content (Two Columns) -->
        <Grid x:Name="MainContentGrid" Grid.Row="1" Margin="20,10,20,10"
              IsEnabled="{Binding IsOperationInProgress, Converter={StaticResource InverseBooleanConverter}, TargetNullValue=True}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" /> <!-- Spacer -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left Column: Configuration -->
            <StackPanel Grid.Column="0">
                <controls:MetroHeader Header="{DynamicResource ChooseASystemToAdd}" Margin="0,0,0,20">
                    <ComboBox x:Name="SystemNameDropdown"
                              HorizontalAlignment="Stretch"
                              Margin="0,5,0,0"
                              SelectionChanged="SystemNameDropdown_SelectionChanged"
                              controls:TextBoxHelper.Watermark="{DynamicResource SelectASystemWatermark}"
                              AutomationProperties.Name="{DynamicResource ChooseASystemToAdd}"
                              AutomationProperties.AutomationId="SystemNameDropdown"
                              ToolTip="{DynamicResource TooltipChooseSystem}" />
                </controls:MetroHeader>

                <controls:MetroHeader Header="{DynamicResource ChooseFolderWithROMsOrIsos}" Margin="0,0,0,20">
                    <StackPanel Margin="0,5,0,0">
                        <TextBlock Text="{DynamicResource Ifyouleaveitempty}"
                                   TextWrapping="Wrap" FontSize="12" Opacity="0.6" Margin="0,0,0,5" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" x:Name="SystemFolderTextBox"
                                     VerticalContentAlignment="Center"
                                     controls:TextBoxHelper.Watermark="{DynamicResource PathToRomsWatermark}"
                                     AutomationProperties.Name="{DynamicResource ChooseFolderWithROMsOrIsos}"
                                     AutomationProperties.AutomationId="SystemFolderTextBox"
                                     ToolTip="{DynamicResource TooltipChooseFolder}" />
                            <Button Grid.Column="1" Content="..."
                                    ToolTip="{DynamicResource TooltipChooseFolder}"
                                    Click="ChooseFolderButton_Click"
                                    Margin="5,0,0,0" Width="40" />
                        </Grid>
                    </StackPanel>
                </controls:MetroHeader>

                <!-- Links Section -->
                <StackPanel Margin="0,20,0,0">
                    <TextBlock Text="{DynamicResource Resources}" FontWeight="SemiBold" Margin="0,0,0,10" />
                    <TextBlock Text="{DynamicResource IncasetheImagePackisnotavailable}"
                               TextWrapping="Wrap" FontSize="12" Opacity="0.6" Margin="0,0,0,5" />
                    <TextBlock Margin="0,0,0,5">
                        <Hyperlink NavigateUri="https://github.com/libretro-thumbnails/libretro-thumbnails"
                                   RequestNavigate="Hyperlink_RequestNavigateAsync">
                            Libretro Thumbnails (GitHub)
                        </Hyperlink>
                    </TextBlock>
                    <TextBlock>
                        <Hyperlink NavigateUri="https://emumovies.com/files/"
                                   RequestNavigate="Hyperlink_RequestNavigateAsync">
                            EmuMovies Files
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>
            </StackPanel>

            <!-- Right Column: Downloads -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <controls:MetroHeader Header="{DynamicResource Install}" Margin="0,0,0,10" />

                    <!-- Essential Components -->
                    <GroupBox Header="{DynamicResource EssentialsHeader}" Margin="0,0,0,15">
                        <UniformGrid Columns="2" Rows="1" Margin="5">
                            <Button x:Name="DownloadEmulatorButton"
                                    Content="{DynamicResource DownloadEmulator}"
                                    Click="DownloadEmulatorButtonClickAsync"
                                    IsEnabled="{Binding IsEmulatorDownloaded, Converter={StaticResource InverseBooleanConverter}, UpdateSourceTrigger=PropertyChanged}"
                                    Style="{DynamicResource MahApps.Styles.Button.Square.Accent}"
                                    Height="40"
                                    Margin="5"
                                    AutomationProperties.Name="{DynamicResource DownloadEmulator}"
                                    AutomationProperties.AutomationId="DownloadEmulatorButton"
                                    ToolTip="{DynamicResource TooltipDownloadEmulator}" />

                            <Button x:Name="DownloadCoreButton"
                                    Content="{DynamicResource DownloadCore}"
                                    Click="DownloadCoreButtonClickAsync"
                                    IsEnabled="{Binding IsCoreDownloaded, Converter={StaticResource InverseBooleanConverter}, UpdateSourceTrigger=PropertyChanged}"
                                    Style="{DynamicResource MahApps.Styles.Button.Square.Accent}"
                                    Height="40"
                                    Margin="5"
                                    AutomationProperties.Name="{DynamicResource DownloadCore}"
                                    AutomationProperties.AutomationId="DownloadCoreButton"
                                    ToolTip="{DynamicResource TooltipDownloadCore}" />
                        </UniformGrid>
                    </GroupBox>

                    <!-- Optional Image Packs -->
                    <GroupBox Header="{DynamicResource ImagePacksOptionalHeader}" Margin="0,0,0,15">
                        <StackPanel Margin="5">
                            <UniformGrid Columns="2">
                                <Button x:Name="DownloadImagePackButton1"
                                        Content="{DynamicResource DownloadImagePack1}"
                                        Click="DownloadImagePackButton1ClickAsync"
                                        IsEnabled="{Binding IsImagePack1Downloaded, Converter={StaticResource InverseBooleanConverter}, UpdateSourceTrigger=PropertyChanged}"
                                        Visibility="{Binding IsImagePack1Available, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Style="{DynamicResource MahApps.Styles.Button.Square.Accent}"
                                        Height="40"
                                        Margin="5"
                                        AutomationProperties.Name="{DynamicResource DownloadImagePack1}"
                                        AutomationProperties.AutomationId="DownloadImagePackButton1"
                                        ToolTip="{DynamicResource TooltipDownloadImagePack1}" />

                                <Button x:Name="DownloadImagePackButton2"
                                        Content="{DynamicResource DownloadImagePack2}"
                                        Click="DownloadImagePackButton2ClickAsync"
                                        IsEnabled="{Binding IsImagePack2Downloaded, Converter={StaticResource InverseBooleanConverter}, UpdateSourceTrigger=PropertyChanged}"
                                        Visibility="{Binding IsImagePack2Available, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Style="{DynamicResource MahApps.Styles.Button.Square.Accent}"
                                        Height="40"
                                        Margin="5"
                                        AutomationProperties.Name="{DynamicResource DownloadImagePack2}"
                                        AutomationProperties.AutomationId="DownloadImagePackButton2"
                                        ToolTip="{DynamicResource TooltipDownloadImagePack2}" />

                                <Button x:Name="DownloadImagePackButton3"
                                        Content="{DynamicResource DownloadImagePack3}"
                                        Click="DownloadImagePackButton3ClickAsync"
                                        IsEnabled="{Binding IsImagePack3Downloaded, Converter={StaticResource InverseBooleanConverter}, UpdateSourceTrigger=PropertyChanged}"
                                        Visibility="{Binding IsImagePack3Available, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Style="{DynamicResource MahApps.Styles.Button.Square.Accent}"
                                        Height="40"
                                        Margin="5"
                                        AutomationProperties.Name="{DynamicResource DownloadImagePack3}"
                                        AutomationProperties.AutomationId="DownloadImagePackButton3"
                                        ToolTip="{DynamicResource TooltipDownloadImagePack3}" />

                                <Button x:Name="DownloadImagePackButton4"
                                        Content="{DynamicResource DownloadImagePack4}"
                                        Click="DownloadImagePackButton4ClickAsync"
                                        IsEnabled="{Binding IsImagePack4Downloaded, Converter={StaticResource InverseBooleanConverter}, UpdateSourceTrigger=PropertyChanged}"
                                        Visibility="{Binding IsImagePack4Available, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Style="{DynamicResource MahApps.Styles.Button.Square.Accent}"
                                        Height="40"
                                        Margin="5"
                                        AutomationProperties.Name="{DynamicResource DownloadImagePack4}"
                                        AutomationProperties.AutomationId="DownloadImagePackButton4"
                                        ToolTip="{DynamicResource TooltipDownloadImagePack4}" />

                                <Button x:Name="DownloadImagePackButton5"
                                        Content="{DynamicResource DownloadImagePack5}"
                                        Click="DownloadImagePackButton5ClickAsync"
                                        IsEnabled="{Binding IsImagePack5Downloaded, Converter={StaticResource InverseBooleanConverter}, UpdateSourceTrigger=PropertyChanged}"
                                        Visibility="{Binding IsImagePack5Available, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Style="{DynamicResource MahApps.Styles.Button.Square.Accent}"
                                        Height="40"
                                        Margin="5"
                                        AutomationProperties.Name="{DynamicResource DownloadImagePack5}"
                                        AutomationProperties.AutomationId="DownloadImagePackButton5"
                                        ToolTip="{DynamicResource TooltipDownloadImagePack5}" />
                            </UniformGrid>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- 3. Footer: Progress & Final Action -->
        <Border Grid.Row="2" BorderBrush="{DynamicResource MahApps.Brushes.Gray7}" BorderThickness="0,1,0,0"
                Background="{DynamicResource MahApps.Brushes.Gray10}" Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Progress Info -->
                <Grid Grid.Column="0" Margin="0,0,20,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <ProgressBar x:Name="DownloadProgressBar" Height="20"
                                     AutomationProperties.Name="{DynamicResource DownloadProgress}" />
                        <TextBlock Text="{DynamicResource DownloadProgress}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource MahApps.Brushes.Text}"
                                   FontSize="10" />
                    </Grid>

                    <DockPanel Grid.Row="1" Margin="0,5,0,0">
                        <Button x:Name="StopDownloadButton" Content="{DynamicResource StopDownload}"
                                DockPanel.Dock="Right" Margin="10,0,0,0" Padding="10,2"
                                Click="StopDownloadButton_Click" IsEnabled="False"
                                Style="{DynamicResource MahApps.Styles.Button.Square}"
                                AutomationProperties.Name="{DynamicResource StopDownload}"
                                AutomationProperties.AutomationId="StopDownloadButton"
                                ToolTip="{DynamicResource TooltipStopDownload}" />
                        <TextBlock Text="{Binding DownloadStatus}"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold" />
                    </DockPanel>
                </Grid>

                <!-- Main Action Button -->
                <Button Grid.Column="1" x:Name="AddSystemButton"
                        Content="{DynamicResource AddSystem}"
                        Click="AddSystemButtonClickAsync"
                        IsEnabled="False"
                        Style="{DynamicResource MahApps.Styles.Button.Square.Accent}"
                        FontSize="16" FontWeight="Bold"
                        Padding="30,10"
                        AutomationProperties.Name="{DynamicResource AddSystem}"
                        AutomationProperties.AutomationId="AddSystemButton"
                        ToolTip="{DynamicResource TooltipAddSystem}" />
            </Grid>
        </Border>

        <!-- Loading Overlay -->
        <ContentControl x:Name="LoadingOverlay"
                        Template="{StaticResource LoadingOverlayTemplate}"
                        Visibility="Collapsed"
                        Grid.Row="0" Grid.RowSpan="3" />
    </Grid>

</controls:MetroWindow>