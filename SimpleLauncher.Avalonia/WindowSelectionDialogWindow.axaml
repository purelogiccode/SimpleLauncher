<Window x:Class="SimpleLauncher.Avalonia.WindowSelectionDialogWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:ext="using:SimpleLauncher.Avalonia.Extensions"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="using:SimpleLauncher.Core.Models"
        Title="{ext:Translate SelectaWindow}"
        Width="500" Height="450"
        CanResize="False">
    <Grid Margin="10">
        <ListBox ItemsSource="{Binding WindowItems}"
                 SelectedItem="{Binding SelectedItem}"
                 Margin="10"
                 Padding="5"
                 VerticalAlignment="Stretch"
                 HorizontalAlignment="Stretch"
                 AutomationProperties.Name="Window list">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="models:WindowItem">
                    <StackPanel>
                        <TextBlock Text="{Binding Title}"
                                   Margin="5,2,5,2"
                                   FontSize="14" />
                        <Separator Margin="5,2" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Window>