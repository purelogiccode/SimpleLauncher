<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="using:SimpleLauncher.Avalonia.Converters">

    <!-- ═══════════════════════════════════════════════════════════
         DarkTheme.axaml — OpenEmu-inspired dark palette + app class styles.
         Two-tier system: Color definitions → SolidColorBrush resources.
         All brushes use {DynamicResource} so palette changes propagate.
         Implicit control styles are provided by FluentTheme.
         ═══════════════════════════════════════════════════════════ -->

    <Styles.Resources>

        <!-- ═══ GLOBAL CONVERTERS (shared by all windows) ═══ -->
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <converters:NullToVisibilityConverter x:Key="NullToVisibility" />
        <converters:PathToImageConverter x:Key="PathToImage" />
        <converters:SmartTitleCaseConverter x:Key="SmartTitleCase" />
        <converters:ConsoleToCardHeightConverter x:Key="CardHeightConverter" />
        <converters:BooleanToFavoriteStatusConverter x:Key="FavoriteStatusConverter" />
        <converters:SystemInfoLineBrushConverter x:Key="SystemInfoLineBrush" />

        <!-- ═══ SURFACE COLORS ═══ -->
        <Color x:Key="BgPrimaryColor">#1E1E1E</Color>
        <Color x:Key="BgSecondaryColor">#252525</Color>
        <Color x:Key="BgTertiaryColor">#2E2E2E</Color>
        <Color x:Key="BgQuaternaryColor">#383838</Color>

        <!-- ═══ TEXT COLORS ═══ -->
        <Color x:Key="TextPrimaryColor">#FFFFFF</Color>
        <Color x:Key="TextSecondaryColor">#98989D</Color>
        <Color x:Key="TextMutedColor">#6E6E73</Color>

        <!-- ═══ ACCENT COLORS (OpenEmu signature red) ═══ -->
        <Color x:Key="AccentColor">#D12733</Color>
        <Color x:Key="AccentHoverColor">#E8404C</Color>
        <Color x:Key="AccentPressedColor">#9C1D27</Color>
        <Color x:Key="AccentDisabledColor">#6B1A1F</Color>

        <!-- ═══ SELECTION COLORS ═══ -->
        <Color x:Key="SelectionBackgroundColor">#0A84FF</Color>
        <Color x:Key="SelectionRingColor">#D12733</Color>

        <!-- ═══ BORDER COLORS ═══ -->
        <Color x:Key="BorderSubtleColor">#2A2A2D</Color>
        <Color x:Key="BorderNormalColor">#3A3A3D</Color>

        <!-- ═══ PLACEHOLDER ART COLORS ═══ -->
        <Color x:Key="PlaceholderFillColor">#15FFFFFF</Color>
        <Color x:Key="PlaceholderStrokeColor">#1AFFFFFF</Color>

        <!-- ═══ SEMANTIC OVERLAYS ═══ -->
        <Color x:Key="OverlayProcessingColor">#B3000000</Color>

        <!-- ═══ LINK COLOR ═══ -->
        <Color x:Key="LinkColor">#526BA0</Color>

        <!-- ═══ SHADOW ═══ -->
        <Color x:Key="ShadowColor">#000000</Color>
        <!-- ═══ NOTIFICATION / TOAST ═══ -->
        <Color x:Key="NotificationInfoColor">#0A84FF</Color>
        <Color x:Key="NotificationSuccessColor">#30D158</Color>
        <Color x:Key="NotificationWarningColor">#FF9F0A</Color>
        <Color x:Key="NotificationErrorColor">#FF453A</Color>

        <!-- ═══ FAVORITES HEART ═══ -->
        <Color x:Key="FavoriteHeartColor">#FF6B6B</Color>

        <!-- ═══════════════════════════════════════════════════════════
             SOLID COLOR BRUSHES (consume the Colors above)
             ═══════════════════════════════════════════════════════════ -->

        <!-- Surface brushes -->
        <SolidColorBrush x:Key="BgPrimaryBrush" Color="{DynamicResource BgPrimaryColor}" />
        <SolidColorBrush x:Key="BgSecondaryBrush" Color="{DynamicResource BgSecondaryColor}" />
        <SolidColorBrush x:Key="BgTertiaryBrush" Color="{DynamicResource BgTertiaryColor}" />
        <SolidColorBrush x:Key="BgQuaternaryBrush" Color="{DynamicResource BgQuaternaryColor}" />

        <!-- Text brushes -->
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="{DynamicResource TextPrimaryColor}" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="{DynamicResource TextSecondaryColor}" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="{DynamicResource TextMutedColor}" />

        <!-- Accent brushes -->
        <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource AccentColor}" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="{DynamicResource AccentHoverColor}" />
        <SolidColorBrush x:Key="AccentPressedBrush" Color="{DynamicResource AccentPressedColor}" />
        <SolidColorBrush x:Key="AccentDisabledBrush" Color="{DynamicResource AccentDisabledColor}" />

        <!-- Selection brushes -->
        <SolidColorBrush x:Key="SelectionBackgroundBrush" Color="{DynamicResource SelectionBackgroundColor}" />
        <SolidColorBrush x:Key="SelectionRingBrush" Color="{DynamicResource SelectionRingColor}" />

        <!-- Border brushes -->
        <SolidColorBrush x:Key="BorderSubtleBrush" Color="{DynamicResource BorderSubtleColor}" />
        <SolidColorBrush x:Key="BorderNormalBrush" Color="{DynamicResource BorderNormalColor}" />

        <!-- Placeholder brushes -->
        <SolidColorBrush x:Key="PlaceholderFillBrush" Color="{DynamicResource PlaceholderFillColor}" />
        <SolidColorBrush x:Key="PlaceholderStrokeBrush" Color="{DynamicResource PlaceholderStrokeColor}" />

        <!-- Overlay brushes -->
        <SolidColorBrush x:Key="OverlayProcessingBrush" Color="{DynamicResource OverlayProcessingColor}" />

        <!-- Link brush -->
        <SolidColorBrush x:Key="LinkBrush" Color="{DynamicResource LinkColor}" />

        <!-- Notification brushes -->
        <SolidColorBrush x:Key="NotificationInfoBrush" Color="{DynamicResource NotificationInfoColor}" />
        <SolidColorBrush x:Key="NotificationSuccessBrush" Color="{DynamicResource NotificationSuccessColor}" />
        <SolidColorBrush x:Key="NotificationWarningBrush" Color="{DynamicResource NotificationWarningColor}" />
        <SolidColorBrush x:Key="NotificationErrorBrush" Color="{DynamicResource NotificationErrorColor}" />

        <!-- Favorite heart -->
        <SolidColorBrush x:Key="FavoriteHeartBrush" Color="{DynamicResource FavoriteHeartColor}" />

        <!-- ═══════════════════════════════════════════════════════════
             TYPOGRAPHY
             ═══════════════════════════════════════════════════════════ -->
        <FontFamily x:Key="PrimaryFont">Segoe UI Variable, Segoe UI, sans-serif</FontFamily>

        <!-- ═══════════════════════════════════════════════════════════
             CORNER RADII
             ═══════════════════════════════════════════════════════════ -->
        <CornerRadius x:Key="ButtonCornerRadius">0</CornerRadius>
        <CornerRadius x:Key="CardCornerRadius">10</CornerRadius>
        <CornerRadius x:Key="PillCornerRadius">0</CornerRadius>

        <!-- ═══════════════════════════════════════════════════════════
             FLUENT FLAT OVERRIDES — mimic the original WPF (MahApps) UI
             Fluent's control templates bind these resources for their
             corners; overriding them here makes every standard control
             flat/squared like the original launcher (fully flat, radius 0).
             ═══════════════════════════════════════════════════════════ -->
        <CornerRadius x:Key="ControlCornerRadius">0</CornerRadius>
        <CornerRadius x:Key="OverlayCornerRadius">0</CornerRadius>

    </Styles.Resources>

    <!-- ═══════════════════════════════════════════════════════════
         CLASS STYLES — applied via Classes="..." in the views.
         ═══════════════════════════════════════════════════════════ -->

    <!-- ── SIDEBAR ITEM (for sidebar system entries) ──
         Applied to item containers of any ListBox with Classes="sidebar-list". -->
    <Style Selector="ListBox.sidebar-list ListBoxItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontFamily" Value="{StaticResource PrimaryFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Template">
            <ControlTemplate TargetType="ListBoxItem">
                <Border x:Name="border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="3,0,0,0"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="ListBox.sidebar-list ListBoxItem:pointerover">
        <Setter Property="Background" Value="{DynamicResource BgTertiaryBrush}" />
    </Style>
    <Style Selector="ListBox.sidebar-list ListBoxItem:selected">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Background" Value="{DynamicResource BgTertiaryBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <!-- ── SIDEBAR GROUP HEADER ── -->
    <Style Selector="TextBlock.sidebar-group-header">
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource PrimaryFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="16,12,16,4" />
    </Style>

    <!-- ── PRIMARY BUTTON (Accent fill) ── -->
    <Style Selector="Button.primary">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="20,10" />
        <Setter Property="FontFamily" Value="{StaticResource PrimaryFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate TargetType="Button">
                <Border x:Name="border"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{StaticResource ButtonCornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Button.primary:pointerover">
        <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
    </Style>
    <Style Selector="Button.primary:pressed">
        <Setter Property="Background" Value="{DynamicResource AccentPressedBrush}" />
    </Style>
    <Style Selector="Button.primary:disabled">
        <Setter Property="Background" Value="{DynamicResource AccentDisabledBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    </Style>

    <!-- ── SECONDARY BUTTON (subtle outline) ── -->
    <Style Selector="Button.secondary">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderNormalBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="20,10" />
        <Setter Property="FontFamily" Value="{StaticResource PrimaryFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate TargetType="Button">
                <Border x:Name="border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{StaticResource ButtonCornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Button.secondary:pointerover">
        <Setter Property="Background" Value="{DynamicResource BgTertiaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="Button.secondary:pressed">
        <Setter Property="Background" Value="{DynamicResource BgQuaternaryBrush}" />
    </Style>

    <!-- ── TOOLBAR TOGGLE BUTTON (segmented control item) ── -->
    <Style Selector="ToggleButton.toolbar-toggle">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="FontFamily" Value="{StaticResource PrimaryFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate TargetType="ToggleButton">
                <Border x:Name="border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="0"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="ToggleButton.toolbar-toggle:pointerover">
        <Setter Property="Background" Value="{DynamicResource BgQuaternaryBrush}" />
    </Style>
    <Style Selector="ToggleButton.toolbar-toggle:checked">
        <Setter Property="Background" Value="{DynamicResource BgQuaternaryBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <!-- ── TOOLBAR ICON BUTTON (Home / Random / Sort quick actions) ── -->
    <Style Selector="Button.toolbar-icon">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="FontFamily" Value="{StaticResource PrimaryFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate TargetType="Button">
                <Border x:Name="border"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{StaticResource ButtonCornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Button.toolbar-icon:pointerover">
        <Setter Property="Background" Value="{DynamicResource BgQuaternaryBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="Button.toolbar-icon:pressed">
        <Setter Property="Background" Value="{DynamicResource BgTertiaryBrush}" />
    </Style>
    <!-- Active letter filter selection (Classes="active" toggled by the letter bar) -->
    <Style Selector="Button.toolbar-icon.active">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <!-- ── NAV RAIL ICON BUTTON (left 64px rail — WPF LeftNavigationPanel parity) ── -->
    <Style Selector="Button.nav-icon">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="MinWidth" Value="56" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="FontFamily" Value="{StaticResource PrimaryFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate TargetType="Button">
                <Border x:Name="border"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{StaticResource ButtonCornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Button.nav-icon:pointerover">
        <Setter Property="Background" Value="{DynamicResource BgTertiaryBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="Button.nav-icon:pressed">
        <Setter Property="Background" Value="{DynamicResource BgQuaternaryBrush}" />
    </Style>

    <!-- ── 3D BUTTON EFFECT (WPF GameButton3DTemplate / SystemButton3DTemplate parity) ──
         Raised card using Avalonia's native Border.BoxShadow (GPU-composited, layered):
         rest → soft drop shadow; hover → accent ring + glow + 1.02 scale;
         pressed → inset shadow + nudge. -->
    <Style Selector="Button.game-button-3d">
        <Setter Property="Background" Value="{DynamicResource BgTertiaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Margin" Value="5" />
        <Setter Property="Padding" Value="0,5,0,0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="RootBorder"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      Margin="{TemplateBinding Padding}"
                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                </Border>
            </ControlTemplate>
        </Setter>
        <Style.Animations>
            <!-- Fade-in on attach (WPF GameButtonStyle Loaded storyboard parity) -->
            <Animation Duration="0:0:0.5" FillMode="Forward">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0" />
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="1" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <!-- Elevation: native BoxShadow layers (offsetX offsetY blur spread color) -->
    <Style Selector="Button.game-button-3d /template/ Border#RootBorder">
        <Setter Property="BoxShadow" Value="0 2 6 0 #4D000000" />
    </Style>
    <Style Selector="Button.game-button-3d:pointerover /template/ Border#RootBorder">
        <Setter Property="BoxShadow" Value="0 0 0 1.5 #FFD12733, 0 3 16 2 #80D12733" />
    </Style>
    <Style Selector="Button.game-button-3d:pressed /template/ Border#RootBorder">
        <Setter Property="BoxShadow" Value="inset 0 2 8 0 #66000000, 0 1 2 0 #66000000" />
    </Style>
    <Style Selector="Button.game-button-3d:pointerover">
        <Setter Property="Background" Value="{DynamicResource BgQuaternaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}" />
        <Setter Property="RenderTransform">
            <Setter.Value>
                <ScaleTransform ScaleX="1.02" ScaleY="1.02" />
            </Setter.Value>
        </Setter>
    </Style>
    <Style Selector="Button.game-button-3d:pressed">
        <Setter Property="Background" Value="{DynamicResource AccentPressedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}" />
        <Setter Property="RenderTransform">
            <Setter.Value>
                <TranslateTransform X="1" Y="1" />
            </Setter.Value>
        </Setter>
    </Style>
    <Style Selector="Button.game-button-3d:focus /template/ Border#RootBorder">
        <Setter Property="BoxShadow" Value="0 0 0 2 #66D12733, 0 2 6 0 #4D000000" />
    </Style>

    <!-- ── SEARCH TEXTBOX (bordered WPF-style field) ── -->
    <Style Selector="TextBox.search-textbox">
        <Setter Property="Background" Value="{DynamicResource BgQuaternaryBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontFamily" Value="{StaticResource PrimaryFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource SelectionBackgroundBrush}" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>

    <!-- ── GROUP BOX (form section in emulator config dialogs) ──
         Matches the section Border look used across the port (BgSecondary + subtle border). -->
    <Style Selector="GroupBox">
        <Setter Property="Background" Value="{DynamicResource BgSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="14" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <!-- ── IMPORTANT SETTING (accent-tinted critical section in emulator config dialogs) ── -->
    <Style Selector="Border.important-setting">
        <Setter Property="Background" Value="#1AD12733" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="14" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>
    <Style Selector="TextBlock.important-setting-header">
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <!-- ── FORM FIELD (label + control rows in emulator config dialogs) ── -->
    <Style Selector="TextBlock.form-label">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBox.dialog-textbox">
        <Setter Property="Background" Value="{DynamicResource BgTertiaryBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderNormalBrush}" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="FontFamily" Value="{StaticResource PrimaryFont}" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <!-- ── SECTION HEADER (collapsible sidebar groups) ── -->
    <Style Selector="ToggleButton.section-header">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="16,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="FontFamily" Value="{StaticResource PrimaryFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Template">
            <ControlTemplate TargetType="ToggleButton">
                <Grid Background="Transparent" ColumnDefinitions="Auto,*">
                    <Path x:Name="Chevron"
                          Grid.Column="0"
                          Width="8" Height="8"
                          Stroke="{TemplateBinding Foreground}"
                          StrokeThickness="1.5"
                          Data="M 1,3 L 4,6 L 7,3"
                          VerticalAlignment="Center"
                          Margin="0,0,6,0"
                          RenderTransformOrigin="0.5,0.5">
                        <Path.RenderTransform>
                            <RotateTransform Angle="-90" />
                        </Path.RenderTransform>
                    </Path>
                    <ContentPresenter Grid.Column="1"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      VerticalAlignment="Center" />
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="ToggleButton.section-header:checked /template/ Path">
        <Setter Property="RenderTransform">
            <RotateTransform Angle="0" />
        </Setter>
    </Style>
    <Style Selector="ToggleButton.section-header:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════════
         GLOBAL CONTROL STYLES — MahApps-flat look over Fluent.
         Class styles (.primary/.secondary/.toolbar-toggle/...) and
         local window styles have higher specificity and win over
         these; these only restyle plain/unclassed controls.
         ═══════════════════════════════════════════════════════════ -->

    <!-- ── BUTTON (flat industrial; accent via Button.primary) ── -->
    <Style Selector="Button">
        <Setter Property="Background" Value="{DynamicResource BgTertiaryBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderNormalBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="FontFamily" Value="{StaticResource PrimaryFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button:pointerover">
        <Setter Property="Background" Value="{DynamicResource BgQuaternaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="Button:pressed">
        <Setter Property="Background" Value="{DynamicResource BgSecondaryBrush}" />
    </Style>
    <Style Selector="Button:disabled">
        <Setter Property="Opacity" Value="0.5" />
    </Style>

    <!-- ── TEXTBOX (flat, subtle border) ── -->
    <Style Selector="TextBox">
        <Setter Property="Background" Value="{DynamicResource BgTertiaryBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderNormalBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="FontFamily" Value="{StaticResource PrimaryFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource SelectionBackgroundBrush}" />
    </Style>

    <!-- ── COMBOBOX (flat) ── -->
    <Style Selector="ComboBox">
        <Setter Property="Background" Value="{DynamicResource BgTertiaryBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderNormalBrush}" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="FontFamily" Value="{StaticResource PrimaryFont}" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <!-- ── MENU BAR + MENU ITEMS (dark, flat) ── -->
    <Style Selector="Menu">
        <Setter Property="Background" Value="{DynamicResource BgSecondaryBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource PrimaryFont}" />
        <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource PrimaryFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="10,5" />
    </Style>

    <!-- ── LISTBOX ITEM (flat selection) ── -->
    <Style Selector="ListBoxItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="FontFamily" Value="{StaticResource PrimaryFont}" />
        <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="ListBoxItem:pointerover">
        <Setter Property="Background" Value="{DynamicResource BgTertiaryBrush}" />
    </Style>
    <Style Selector="ListBoxItem:selected">
        <Setter Property="Background" Value="{DynamicResource BgQuaternaryBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <!-- ── TOOLTIP (dark flat) ── -->
    <Style Selector="ToolTip">
        <Setter Property="Background" Value="{DynamicResource BgTertiaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderNormalBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource PrimaryFont}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- ── WINDOW (consistent app background for every window) ── -->
    <Style Selector="Window">
        <Setter Property="Background" Value="{DynamicResource BgPrimaryBrush}" />
    </Style>

</Styles>