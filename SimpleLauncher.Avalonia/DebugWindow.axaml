<Window x:Class="SimpleLauncher.Avalonia.DebugWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:ext="using:SimpleLauncher.Avalonia.Extensions"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{ext:Translate Debugger}"
        Height="400" Width="800"
        WindowStartupLocation="Manual"
        Position="100,100">
    <Grid RowDefinitions="*,Auto">

        <TextBox x:Name="LogTextBox"
                 Grid.Row="0"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 TextWrapping="NoWrap"
                 Margin="5"
                 FontSize="12"
                 FontFamily="Consolas, Courier New, monospace"
                 Text="{Binding LogText, Mode=OneWay}"
                 AutomationProperties.Name="Debug log" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="5">
            <Button Content="{ext:Translate ClearLog}" Margin="5,0" Classes="secondary"
                    Command="{Binding ClearLogCommand}"
                    AutomationProperties.Name="{ext:Translate ClearLog}" />
            <Button Content="{ext:Translate CopyLog}" Margin="5,0" Classes="secondary"
                    Command="{Binding CopyLogCommand}"
                    AutomationProperties.Name="{ext:Translate CopyLog}" />
            <Button Content="{ext:Translate Close}" Margin="5,0" Classes="secondary"
                    Click="CloseButton_Click"
                    AutomationProperties.Name="{ext:Translate Close}" />
        </StackPanel>
    </Grid>
</Window>