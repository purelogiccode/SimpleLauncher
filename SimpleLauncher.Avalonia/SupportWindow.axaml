<Window x:Class="SimpleLauncher.Avalonia.SupportWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:ext="using:SimpleLauncher.Avalonia.Extensions"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{ext:Translate Support}"
        Width="600" Height="450"
        CanResize="False"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid x:Name="MainContentGrid" RowDefinitions="Auto,Auto,Auto,*,Auto">

            <TextBlock Grid.Row="0" Margin="10,10,10,20"
                       Text="{ext:Translate UsetheformbelowToGetSupport}"
                       TextWrapping="Wrap" />

            <StackPanel Grid.Row="1" Margin="10,0,10,10" Orientation="Horizontal">
                <TextBlock Width="95" VerticalAlignment="Center" Text="{ext:Translate Name}"
                           Classes="form-label" />
                <TextBox x:Name="NameTextBox" Width="270"
                         Text="{Binding Name}"
                         AutomationProperties.Name="{ext:Translate Name}" />
            </StackPanel>

            <StackPanel Grid.Row="2" Margin="10,0,10,20" Orientation="Horizontal">
                <TextBlock Width="95" VerticalAlignment="Center" Text="{ext:Translate Email}"
                           Classes="form-label" />
                <TextBox x:Name="EmailTextBox" Width="270"
                         Text="{Binding Email}"
                         AutomationProperties.Name="{ext:Translate Email}" />
            </StackPanel>

            <TextBox x:Name="SupportTextBox"
                     Grid.Row="3"
                     Height="200"
                     Margin="10,0,10,20"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     Text="{Binding SupportRequest}"
                     AutomationProperties.Name="Support request" />

            <StackPanel Grid.Row="4" Margin="10,0,10,20"
                        HorizontalAlignment="Center"
                        Orientation="Horizontal">
                <Button Classes="primary"
                        IsDefault="True"
                        Command="{Binding SendSupportRequestCommand}"
                        Content="{ext:Translate SendSupportRequest}"
                        AutomationProperties.Name="{ext:Translate SendSupportRequest}" />
                <Button Classes="secondary"
                        IsCancel="True"
                        Margin="10,0,0,0"
                        Command="{Binding CloseCommand}"
                        Content="{ext:Translate Close}"
                        AutomationProperties.Name="{ext:Translate Close}" />
            </StackPanel>
        </Grid>

        <!-- Overlay for loading -->
        <Border x:Name="LoadingOverlay"
                Background="#B31E1E1E"
                IsVisible="False"
                ZIndex="10">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="220"
                             AutomationProperties.Name="{ext:Translate SendingSupportRequest}" />
                <TextBlock x:Name="LoadingOverlayMessage"
                           Text="{ext:Translate SendingSupportRequest}"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           FontSize="14"
                           HorizontalAlignment="Center"
                           Margin="0,12,0,0" />
                <Button x:Name="EmergencyButton"
                        Content="{ext:Translate YumirConfig_Cancel_Button}" Width="100" Margin="0,16,0,0"
                        Classes="secondary"
                        Click="EmergencyOverlayRelease_Click"
                        HorizontalAlignment="Center"
                        AutomationProperties.Name="{ext:Translate YumirConfig_Cancel_Button}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>