<Window x:Class="SimpleLauncher.Avalonia.AboutWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:ext="using:SimpleLauncher.Avalonia.Extensions"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{ext:Translate About}"
        Width="450" Height="420"
        CanResize="False"
        WindowStartupLocation="CenterScreen">
    <Grid RowDefinitions="Auto,Auto,Auto">

        <StackPanel Grid.Row="0" Margin="10"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal">
            <Image Width="150" Height="150"
                   Source="{Binding LogoPath, Converter={StaticResource PathToImage}}" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="10">
            <TextBlock Text="{ext:Translate AboutWindow_Simple_Launcher}" FontWeight="Bold" />
            <TextBlock Text="{ext:Translate AboutWindow_An_open_source_emulator_frontend}"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
            <TextBlock Margin="0,10,0,0" Text="{Binding AppVersion}" />
            <Button Margin="0,10,0,0" Padding="0"
                    Background="Transparent" BorderThickness="0"
                    Foreground="{DynamicResource LinkBrush}"
                    HorizontalAlignment="Left"
                    Command="{Binding OpenWebsiteCommand}"
                    CommandParameter="https://www.purelogiccode.com"
                    Content="https://www.purelogiccode.com" />
            <Button Margin="0,10,0,0" Padding="0"
                    Background="Transparent" BorderThickness="0"
                    Foreground="{DynamicResource LinkBrush}"
                    HorizontalAlignment="Left"
                    Command="{Binding OpenWebsiteCommand}"
                    CommandParameter="https://github.com/purelogiccode/SimpleLauncher"
                    Content="https://github.com/purelogiccode/SimpleLauncher" />
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="10"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal">
            <Button Classes="secondary" Content="{ext:Translate CheckForUpdate}"
                    Command="{Binding CheckForUpdatesCommand}"
                    AutomationProperties.Name="{ext:Translate CheckForUpdate}" />
            <Button Classes="secondary" Margin="10,0,0,0" Content="{ext:Translate UpdateHistory}"
                    Command="{Binding OpenUpdateHistoryCommand}"
                    AutomationProperties.Name="{ext:Translate UpdateHistory}" />
            <Button Classes="secondary" Margin="10,0,0,0" Content="{ext:Translate Close}"
                    Command="{Binding CloseCommand}" IsCancel="True"
                    AutomationProperties.Name="{ext:Translate Close}" />
        </StackPanel>
    </Grid>
</Window>