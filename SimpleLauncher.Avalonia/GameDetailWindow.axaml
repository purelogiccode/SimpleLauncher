<Window x:Class="SimpleLauncher.Avalonia.GameDetailWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:ext="using:SimpleLauncher.Avalonia.Extensions"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{ext:Translate GameDetails}"
        Width="500" Height="450"
        MinWidth="400" MinHeight="350"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgPrimaryBrush}">

    <Grid Margin="16" RowDefinitions="Auto,*,Auto">

        <!-- Header: Cover + Info -->
        <Border Grid.Row="0" Background="{DynamicResource BgSecondaryBrush}"
                CornerRadius="{DynamicResource CardCornerRadius}" Padding="16">
            <Grid ColumnDefinitions="120,*">

                <!-- Cover art -->
                <Border Grid.Column="0" CornerRadius="4" ClipToBounds="True"
                        Width="120" Height="168" Background="{DynamicResource BgTertiaryBrush}"
                        Cursor="Hand"
                        ToolTip.Tip="{ext:Translate ClickToViewFullSize}"
                        PointerPressed="CoverImage_PointerPressed">
                    <Image x:Name="CoverImage"
                           Source="{Binding CoverPath, Converter={StaticResource PathToImage}}"
                           Stretch="Uniform"
                           RenderOptions.BitmapInterpolationMode="HighQuality" />
                </Border>

                <!-- Game info -->
                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText"
                               Text="{Binding DisplayTitle, Converter={StaticResource SmartTitleCase}}"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontSize="18" FontWeight="SemiBold"
                               TextWrapping="Wrap" MaxHeight="56" />
                    <TextBlock x:Name="SystemText"
                               Text="{Binding SystemName}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="13" Margin="0,8,0,0" />
                    <TextBlock x:Name="FilePathText"
                               Text="{Binding FilePath}"
                               Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="11" Margin="0,4,0,0"
                               TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{Binding FilePath}" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="{ext:Translate GameDetailWindow_Played}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                        <TextBlock Text="{Binding PlayCount}" Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="12" FontWeight="SemiBold" />
                        <TextBlock Text="{ext:Translate GameDetailWindow_times}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                    </StackPanel>
                    <TextBlock x:Name="LastPlayedText"
                               Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="11" Margin="0,2,0,0">
                        <Run Text="{ext:Translate GameDetailWindow_Last_played}" />
                        <Run Text="{Binding LastPlayed}" />
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Description -->
        <Border Grid.Row="1" Background="{DynamicResource BgSecondaryBrush}"
                CornerRadius="6" Padding="14" Margin="0,12,0,0">
            <Grid RowDefinitions="Auto,*">
                <TextBlock Text="{ext:Translate HeaderDescription}"
                           Foreground="{DynamicResource TextMutedBrush}"
                           FontSize="11" FontWeight="SemiBold" Margin="0,0,0,8" />
                <TextBlock Grid.Row="1"
                           x:Name="DescriptionBlock"
                           Text="{ext:Translate GameDetailWindow_No_additional_information_available_for_}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="13" TextWrapping="Wrap"
                           VerticalAlignment="Top" />
            </Grid>
        </Border>

        <!-- Action bar -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button x:Name="RemoveButton"
                    Content="{ext:Translate Remove}"
                    Classes="secondary"
                    Padding="14,8" Margin="0,0,8,0"
                    Click="RemoveButton_Click"
                    AutomationProperties.Name="{ext:Translate Remove}" />
            <Button x:Name="FavoriteButton"
                    Content="{ext:Translate GameDetailWindow_Favorite}"
                    Classes="secondary"
                    Padding="14,8" Margin="0,0,8,0"
                    Click="FavoriteButton_Click"
                    AutomationProperties.Name="{ext:Translate GameDetailWindow_Favorite}" />
            <Button x:Name="PlayButton"
                    Content="{ext:Translate GameDetailWindow_Play}"
                    Classes="primary"
                    Padding="20,8"
                    Click="PlayButton_Click"
                    AutomationProperties.Name="{ext:Translate GameDetailWindow_Play}" />
        </StackPanel>
    </Grid>
</Window>