<Window x:Class="SimpleLauncher.Avalonia.SystemSelectionWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:ext="using:SimpleLauncher.Avalonia.Extensions"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{ext:Translate SelectRetroAchievementsSystemTitle}"
        Height="220" Width="420"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        CanResize="False"
        Background="{DynamicResource BgPrimaryBrush}">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="{ext:Translate SystemSelectionWindow_The_system_for_this_game_could_not_be_de}"
                       TextWrapping="Wrap" Margin="0,0,0,10"
                       Foreground="{DynamicResource TextSecondaryBrush}" />

            <TextBlock Text="{ext:Translate SystemSelectionWindow_Select_the_system_for_this_game}" FontWeight="Bold"
                       Margin="0,0,0,5"
                       Foreground="{DynamicResource TextPrimaryBrush}" />

            <ComboBox ItemsSource="{Binding Systems}"
                      SelectedItem="{Binding SelectedSystem}"
                      Margin="0,0,0,30"
                      ToolTip.Tip="{ext:Translate SystemSelectionWindow_Choose_the_system_for_this_game}"
                      AutomationProperties.Name="{ext:Translate SystemSelectionWindow_Choose_the_system_for_this_game}" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="{ext:Translate Confirm}" Command="{Binding ConfirmCommand}" IsDefault="True"
                        Classes="primary" Margin="0,0,10,0" Width="120"
                        ToolTip.Tip="{ext:Translate SystemSelectionWindow_Confirm_the_selected_system}"
                        AutomationProperties.Name="{ext:Translate SystemSelectionWindow_Confirm_the_selected_system}" />
                <Button Content="{ext:Translate YumirConfig_Cancel_Button}" Command="{Binding CancelCommand}"
                        IsCancel="True"
                        Classes="secondary" Width="80" ToolTip.Tip="{ext:Translate YumirConfig_Cancel_Button}"
                        AutomationProperties.Name="{ext:Translate YumirConfig_Cancel_Button}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>