<Window x:Class="SimpleLauncher.Avalonia.PreferencesWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:ext="using:SimpleLauncher.Avalonia.Extensions"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{ext:Translate Sidebar.Preferences}"
        Width="800" Height="550"
        MinWidth="700" MinHeight="450"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgPrimaryBrush}">

    <Grid RowDefinitions="Auto,*">

        <!-- Row 0: header + Close button (matches EditSystemWindow) -->
        <Border Grid.Row="0" Background="{DynamicResource BgTertiaryBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1"
                Padding="12,10">
            <Grid ColumnDefinitions="*,Auto">

                <TextBlock Text="{ext:Translate Sidebar.Preferences}" FontSize="14" FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextPrimaryBrush}" />

                <Button Grid.Column="1" Content="{ext:Translate Close}"
                        Classes="secondary"
                        Padding="14,6" Margin="4,0"
                        AutomationProperties.Name="{ext:Translate Close}"
                        Click="CloseButton_Click" />
            </Grid>
        </Border>

        <!-- Row 1: body -->
        <Grid Grid.Row="1" ColumnDefinitions="180,Auto,*">

            <!-- Nav strip -->
            <Border Grid.Column="0" Background="{DynamicResource BgSecondaryBrush}">
                <ListBox x:Name="NavList" Margin="0,8,0,0"
                         Background="Transparent" BorderThickness="0"
                         SelectionChanged="NavList_SelectionChanged"
                         AutomationProperties.Name="Preferences navigation">
                    <ListBoxItem Tag="general" IsSelected="True">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚙  " FontSize="14" />
                            <TextBlock Text="{ext:Translate RaineConfig_General_Header}" FontSize="13" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="systems">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🎮  " FontSize="14" />
                            <TextBlock Text="{ext:Translate Preferences.Systems}" FontSize="13" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="emulators">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🖥  " FontSize="14" />
                            <TextBlock Text="{ext:Translate Preferences.Emulators}" FontSize="13" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="images">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🖼  " FontSize="14" />
                            <TextBlock Text="{ext:Translate Images}" FontSize="13" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="view">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="👁  " FontSize="14" />
                            <TextBlock Text="{ext:Translate Preferences.View}" FontSize="13" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="sound">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔊  " FontSize="14" />
                            <TextBlock Text="{ext:Translate SoundIcon}" FontSize="13" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="retroachievements">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🏆  " FontSize="14" />
                            <TextBlock Text="{ext:Translate RetroArchConfig_RetroAchievements_Header}" FontSize="13" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="updates">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="↓  " FontSize="14" />
                            <TextBlock Text="{ext:Translate Preferences.Updates}" FontSize="13" />
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </Border>

            <!-- Separator -->
            <Border Grid.Column="1" Width="1" Background="{DynamicResource BorderSubtleBrush}" />

            <!-- Content area -->
            <Border Grid.Column="2" Background="{DynamicResource BgPrimaryBrush}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ContentPanel" Margin="24,16">

                        <!-- GENERAL -->
                        <StackPanel x:Name="GeneralPanel" IsVisible="True">
                            <TextBlock Text="{ext:Translate RaineConfig_General_Header}" FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,16" />

                            <TextBlock Text="{ext:Translate LanguageIcon}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
                            <ComboBox x:Name="LanguageCombo" Width="200" Margin="0,0,0,20"
                                      SelectionChanged="LanguageCombo_SelectionChanged"
                                      AutomationProperties.Name="{ext:Translate LanguageIcon}">
                                <ComboBoxItem Content="English" Tag="en" />
                                <ComboBoxItem Content="Português" Tag="pt" />
                                <ComboBoxItem Content="Español" Tag="es" />
                                <ComboBoxItem Content="Français" Tag="fr" />
                                <ComboBoxItem Content="Deutsch" Tag="de" />
                                <ComboBoxItem Content="日本語" Tag="ja" />
                            </ComboBox>
                        </StackPanel>

                        <!-- SYSTEMS -->
                        <StackPanel x:Name="SystemsPanel" IsVisible="False">
                            <TextBlock Text="{ext:Translate Preferences.Systems}" FontSize="18" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6" />
                            <TextBlock
                                Text="{ext:Translate PreferencesWindow_Add_edit_and_delete_systems_in_system_xm}"
                                FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,16" />
                            <Button Content="{ext:Translate PreferencesWindow_Add_Edit_Systems_Expert_Mode}"
                                    Classes="primary"
                                    HorizontalAlignment="Left"
                                    Padding="20,10"
                                    AutomationProperties.Name="{ext:Translate PreferencesWindow_Add_Edit_Systems_Expert_Mode}"
                                    Click="OpenEditSystem_Click" />
                            <Button Content="{ext:Translate PreferencesWindow_Easy_Mode_Download_a_Ready_Made_System}"
                                    Classes="secondary"
                                    HorizontalAlignment="Left"
                                    Padding="20,10"
                                    Margin="0,10,0,0"
                                    AutomationProperties.Name="{ext:Translate PreferencesWindow_Easy_Mode_Download_a_Ready_Made_System}"
                                    Click="OpenEasyMode_Click" />
                        </StackPanel>

                        <!-- EMULATORS -->
                        <StackPanel x:Name="EmulatorsPanel" IsVisible="False">
                            <TextBlock Text="{ext:Translate Preferences.Emulators}" FontSize="18" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6" />
                            <TextBlock
                                Text="{ext:Translate PreferencesWindow_Configure_emulator_paths_and_parameters_}"
                                FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,16" />
                            <Button Content="{ext:Translate PreferencesWindow_Open_Edit_System_Expert_Mode}"
                                    Classes="primary"
                                    HorizontalAlignment="Left"
                                    Padding="20,10"
                                    AutomationProperties.Name="{ext:Translate PreferencesWindow_Open_Edit_System_Expert_Mode}"
                                    Click="OpenEditSystem_Click" />
                            <TextBlock
                                Text="{ext:Translate PreferencesWindow_Emulator_1_5_paths_launch_parameters_and}"
                                FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                TextWrapping="Wrap" Margin="0,12,0,0" />
                        </StackPanel>

                        <!-- IMAGES -->
                        <StackPanel x:Name="ImagesPanel" IsVisible="False">
                            <TextBlock Text="{ext:Translate Images}" FontSize="18" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6" />
                            <TextBlock
                                Text="{ext:Translate PreferencesWindow_Cover_art_is_matched_to_games_by_filenam}"
                                FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                                TextWrapping="Wrap" Margin="0,0,0,16" />
                            <Button Content="{ext:Translate DownloadImagePack}"
                                    Classes="primary"
                                    HorizontalAlignment="Left"
                                    Padding="20,10"
                                    AutomationProperties.Name="{ext:Translate DownloadImagePack}"
                                    Click="DownloadImagePack_Click" />
                        </StackPanel>

                        <!-- VIEW -->
                        <StackPanel x:Name="ViewPanel" IsVisible="False">
                            <TextBlock Text="{ext:Translate Preferences.View}" FontSize="18" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,16" />

                            <TextBlock Text="{ext:Translate PreferencesWindow_Default_View}" FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
                            <ComboBox x:Name="DefaultViewCombo" Width="200" Margin="0,0,0,20"
                                      AutomationProperties.Name="{ext:Translate PreferencesWindow_Default_View}">
                                <ComboBoxItem Content="{ext:Translate GridView}" Tag="GridView" />
                                <ComboBoxItem Content="{ext:Translate ListView}" Tag="ListView" />
                            </ComboBox>

                            <TextBlock Text="{ext:Translate PreferencesWindow_Default_Card_Width}" FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBox x:Name="CardWidthBox" Width="60" Text="168"
                                         AutomationProperties.Name="{ext:Translate PreferencesWindow_Default_Card_Width}" />
                                <TextBlock Text="{ext:Translate PreferencesWindow_pixels_148_280}"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0" />
                            </StackPanel>
                            <TextBlock
                                Text="{ext:Translate PreferencesWindow_Default_width_for_game_cards_in_grid_vie}"
                                FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,20" />

                            <TextBlock Text="{ext:Translate PreferencesWindow_Gamepad_Navigation}" FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
                            <CheckBox x:Name="GamepadNavCheck"
                                      Content="{ext:Translate PreferencesWindow_Enable_gamepad_navigation}"
                                      Margin="0,0,0,8" />
                            <CheckBox x:Name="DisplayMachineNameCheck"
                                      Content="{ext:Translate PreferencesWindow_Show_machine_ROM_names}"
                                      Margin="0,0,0,20" />
                        </StackPanel>

                        <!-- SOUND -->
                        <StackPanel x:Name="SoundPanel" IsVisible="False">
                            <TextBlock Text="{ext:Translate SoundIcon}" FontSize="18" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,16" />

                            <CheckBox x:Name="NotificationSoundCheck"
                                      Content="{ext:Translate PreferencesWindow_Enable_notification_sounds}"
                                      Margin="0,0,0,8" />
                            <TextBlock
                                Text="{ext:Translate PreferencesWindow_Custom_sounds_and_per_system_sound_files}"
                                FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- RETROACHIEVEMENTS -->
                        <StackPanel x:Name="RetroAchievementsPanel" IsVisible="False">
                            <TextBlock Text="{ext:Translate RetroArchConfig_RetroAchievements_Header}" FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6" />
                            <TextBlock
                                Text="{ext:Translate PreferencesWindow_Connect_to_RetroAchievements_for_achieve}"
                                FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,16" />

                            <TextBlock Text="{ext:Translate Username}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
                            <TextBox x:Name="RaUsernameBox" Width="250" Margin="0,0,0,12"
                                     AutomationProperties.Name="{ext:Translate Username}" />

                            <TextBlock Text="{ext:Translate PreferencesWindow_API_Key}" FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
                            <TextBox x:Name="RaApiKeyBox" Width="350" Margin="0,0,0,20"
                                     AutomationProperties.Name="{ext:Translate PreferencesWindow_API_Key}" />

                            <Button x:Name="RaTestButton" Content="{ext:Translate PreferencesWindow_Test_Connection}"
                                    Classes="secondary"
                                    Width="140"
                                    AutomationProperties.Name="{ext:Translate PreferencesWindow_Test_Connection}"
                                    Click="RaTestButton_Click" />
                        </StackPanel>

                        <!-- UPDATES -->
                        <StackPanel x:Name="UpdatesPanel" IsVisible="False">
                            <TextBlock Text="{ext:Translate Preferences.Updates}" FontSize="18" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6" />
                            <TextBlock
                                Text="{ext:Translate PreferencesWindow_Updates_are_checked_on_demand_When_a_new}"
                                FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                                TextWrapping="Wrap" Margin="0,0,0,16" />
                            <Button x:Name="CheckUpdatesButton"
                                    Content="{ext:Translate PreferencesWindow_Check_for_Updates_Now}"
                                    Classes="primary"
                                    HorizontalAlignment="Left"
                                    Padding="20,10"
                                    AutomationProperties.Name="{ext:Translate PreferencesWindow_Check_for_Updates_Now}"
                                    Click="CheckUpdates_Click" />
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>