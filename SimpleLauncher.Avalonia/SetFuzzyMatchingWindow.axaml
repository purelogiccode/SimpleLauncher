<Window x:Class="SimpleLauncher.Avalonia.SetFuzzyMatchingWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:ext="using:SimpleLauncher.Avalonia.Extensions"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{ext:Translate SetFuzzyMatchingThresholdTitle}"
        Height="350" Width="500"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="15" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="Auto,*">

        <!-- Current Threshold -->
        <TextBlock Grid.Row="0" Grid.Column="0" Text="{ext:Translate CurrentThresholdLabel}"
                   Classes="form-label" FontWeight="Bold" VerticalAlignment="Center" />
        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CurrentThresholdText}" Margin="10,0,0,0"
                   VerticalAlignment="Center" />

        <!-- New Threshold Input (Slider) -->
        <TextBlock Grid.Row="1" Grid.Column="0" Text="{ext:Translate NewThresholdLabel}"
                   Classes="form-label" FontWeight="Bold" VerticalAlignment="Center" />
        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
            <Slider Value="{Binding ThresholdValue}"
                    Minimum="{Binding Minimum}"
                    Maximum="{Binding Maximum}"
                    TickFrequency="{Binding TickFrequencyValue}"
                    IsSnapToTickEnabled="True"
                    Width="200"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="{ext:Translate NewThresholdLabel}" />
            <TextBlock Text="{Binding ThresholdPercentage}" Margin="10" VerticalAlignment="Center" />
        </StackPanel>

        <!-- Description -->
        <TextBlock Grid.Row="2" Grid.Column="1"
                   Text="{ext:Translate SetFuzzyMatchingWindow_Lower_values_make_matching_more_lenient_}"
                   TextWrapping="Wrap" FontStyle="Italic"
                   Foreground="{DynamicResource TextSecondaryBrush}" />

        <!-- Threshold Explanation -->
        <TextBlock Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" TextWrapping="Wrap" Margin="10,20,10,0">
            <Run FontWeight="Bold" Text="{ext:Translate SetFuzzyMatchingWindow_Low_threshold_70}" />
            <Run Text="{ext:Translate SetFuzzyMatchingWindow_More_games_will_match_but_with_a_higher_}" />
        </TextBlock>
        <TextBlock Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" TextWrapping="Wrap" Margin="10,10,10,10">
            <Run FontWeight="Bold" Text="{ext:Translate SetFuzzyMatchingWindow_High_threshold_95}" />
            <Run Text="{ext:Translate SetFuzzyMatchingWindow_Fewer_games_will_match_but_matches_will_}" />
        </TextBlock>

        <!-- Buttons -->
        <StackPanel Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal"
                    HorizontalAlignment="Center" Margin="10,20,10,10">
            <Button Content="{ext:Translate OkButtonText}" Command="{Binding SaveCommand}"
                    Classes="primary" Padding="10" Margin="0,0,10,0" IsDefault="True"
                    AutomationProperties.Name="{ext:Translate OkButtonText}" />
            <Button Content="{ext:Translate YumirConfig_Cancel_Button}" Command="{Binding CancelCommand}"
                    Classes="secondary" Padding="10" IsCancel="True"
                    AutomationProperties.Name="{ext:Translate YumirConfig_Cancel_Button}" />
        </StackPanel>
    </Grid>
</Window>