<Window x:Class="SimpleLauncher.Avalonia.EasyModeWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ext="using:SimpleLauncher.Avalonia.Extensions"
        xmlns:views="using:SimpleLauncher.Avalonia.Views"
        Title="{ext:Translate AddNewSystem}"
        Width="900" MinWidth="700"
        Height="610" MinHeight="550"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgPrimaryBrush}"
        Opened="Window_Opened"
        Closed="Window_Closed">

    <Grid>
        <views:EasyModeView x:Name="EasyModeViewControl" />

        <Button Content="{ext:Translate Close}"
                Classes="secondary"
                Padding="14,6" Margin="0,14,14,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Click="CloseButton_Click"
                AutomationProperties.Name="{ext:Translate Close}" />
    </Grid>
</Window>
