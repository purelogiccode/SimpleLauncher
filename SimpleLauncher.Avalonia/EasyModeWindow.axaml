<Window x:Class="SimpleLauncher.Avalonia.EasyModeWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="using:SimpleLauncher.Avalonia.Converters"
        xmlns:models="using:SimpleLauncher.Core.Models"
        xmlns:ext="using:SimpleLauncher.Avalonia.Extensions"
        Title="{ext:Translate AddNewSystem}"
        Width="900" MinWidth="700"
        Height="610" MinHeight="550"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgPrimaryBrush}"
        Opened="Window_Opened"
        Closed="Window_Closed">

    <Window.Resources>
        <converters:InverseBoolConverter x:Key="InverseBool" />
    </Window.Resources>

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Row 0: Header + Close button -->
        <Grid Grid.Row="0" Margin="24,20,24,12" ColumnDefinitions="*,Auto">

            <StackPanel>
                <TextBlock Text="{ext:Translate AddNewSystem}" FontSize="22" FontWeight="Light"
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" />
                <TextBlock Text="{ext:Translate InThisWindowYouCanDownload}"
                           TextWrapping="Wrap" FontSize="12"
                           Foreground="{DynamicResource TextMutedBrush}" />
                <TextBlock Text="{ext:Translate WeAlsoSupportSystems}"
                           TextWrapping="Wrap" FontSize="12"
                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,6,0,0" />
            </StackPanel>

            <Button Grid.Column="1" Content="{ext:Translate Close}"
                    Classes="secondary"
                    Padding="14,6" Margin="4,0"
                    VerticalAlignment="Top"
                    Click="CloseButton_Click"
                    AutomationProperties.Name="{ext:Translate Close}" />
        </Grid>

        <!-- Row 1: Main content (two columns) -->
        <Grid Grid.Row="1" Margin="24,12,24,12"
              IsEnabled="{Binding IsContentEnabled}"
              ColumnDefinitions="*,20,*">

            <!-- Left column: Configuration -->
            <StackPanel Grid.Column="0">
                <TextBlock Text="{ext:Translate ChooseASystemToAdd}" FontWeight="SemiBold" FontSize="13"
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6" />
                <ComboBox x:Name="SystemNameCombo"
                          ItemsSource="{Binding Systems}"
                          SelectedItem="{Binding SelectedSystem}"
                          HorizontalAlignment="Stretch"
                          Height="32"
                          Background="{DynamicResource BgSecondaryBrush}"
                          Foreground="{DynamicResource TextPrimaryBrush}"
                          BorderBrush="{DynamicResource BorderNormalBrush}"
                          Margin="0,0,0,20"
                          AutomationProperties.Name="{ext:Translate ChooseASystemToAdd}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="models:EasyModeSystemConfig">
                            <TextBlock Text="{Binding SystemName}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBlock Text="{ext:Translate ChooseFolderWithROMsOrIsos}" FontWeight="SemiBold" FontSize="13"
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6" />
                <TextBlock Text="{ext:Translate Ifyouleaveitempty}"
                           TextWrapping="Wrap" FontSize="12"
                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6" />
                <Grid ColumnDefinitions="*,Auto">
                    <TextBox Grid.Column="0"
                             Text="{Binding SystemFolderPath}"
                             VerticalContentAlignment="Center"
                             Height="32"
                             Background="{DynamicResource BgSecondaryBrush}"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             BorderBrush="{DynamicResource BorderNormalBrush}"
                             AutomationProperties.Name="{ext:Translate ChooseFolderWithROMsOrIsos}" />
                    <Button Grid.Column="1" Content="..."
                            Width="40" Height="32"
                            Padding="0"
                            Margin="6,0,0,0"
                            Classes="secondary"
                            Click="BrowseFolder_Click"
                            ToolTip.Tip="{ext:Translate TooltipChooseFolder}" />
                </Grid>

                <!-- Links section -->
                <StackPanel Margin="0,24,0,0">
                    <TextBlock Text="{ext:Translate Resources}" FontWeight="SemiBold" FontSize="13"
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10" />
                    <TextBlock Text="{ext:Translate IncasetheImagePackisnotavailable}"
                               TextWrapping="Wrap" FontSize="12"
                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6" />
                    <HyperlinkButton NavigateUri="https://github.com/libretro-thumbnails/libretro-thumbnails"
                                     Content="{ext:Translate DownloadImagePackWindow_Libretro_Thumbnails_GitHub}"
                                     Foreground="{DynamicResource LinkBrush}"
                                     Margin="0,2"
                                     AutomationProperties.Name="{ext:Translate DownloadImagePackWindow_Libretro_Thumbnails_GitHub}" />
                    <HyperlinkButton NavigateUri="https://emumovies.com/files/"
                                     Content="{ext:Translate DownloadImagePackWindow_EmuMovies_Files}"
                                     Foreground="{DynamicResource LinkBrush}"
                                     Margin="0,2"
                                     AutomationProperties.Name="{ext:Translate DownloadImagePackWindow_EmuMovies_Files}" />
                </StackPanel>
            </StackPanel>

            <!-- Right column: Downloads -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="{ext:Translate Install}" FontWeight="SemiBold" FontSize="13"
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10" />

                    <!-- Essential components -->
                    <Border Background="{DynamicResource BgSecondaryBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="1" CornerRadius="6"
                            Padding="12" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="{ext:Translate EssentialsHeader}" FontWeight="SemiBold" FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8" />
                            <UniformGrid Columns="2" Rows="1">
                                <Button Content="{ext:Translate DownloadEmulator}"
                                        Command="{Binding DownloadEmulatorCommand}"
                                        IsEnabled="{Binding IsEmulatorDownloaded, Converter={StaticResource InverseBool}}"
                                        Height="38" Margin="4"
                                        Classes="primary"
                                        AutomationProperties.Name="{ext:Translate DownloadEmulator}" />
                                <Button Content="{ext:Translate DownloadCore}"
                                        Command="{Binding DownloadCoreCommand}"
                                        IsEnabled="{Binding IsCoreDownloaded, Converter={StaticResource InverseBool}}"
                                        Height="38" Margin="4"
                                        Classes="primary"
                                        AutomationProperties.Name="{ext:Translate DownloadCore}" />
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <!-- Image packs -->
                    <Border Background="{DynamicResource BgSecondaryBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="1" CornerRadius="6"
                            Padding="12">
                        <StackPanel>
                            <TextBlock Text="{ext:Translate ImagePacksOptionalHeader}" FontWeight="SemiBold"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8" />
                            <UniformGrid Columns="2">
                                <Button Content="{ext:Translate DownloadImagePack1}"
                                        Command="{Binding DownloadImagePack1Command}"
                                        IsEnabled="{Binding IsImagePack1Downloaded, Converter={StaticResource InverseBool}}"
                                        IsVisible="{Binding IsImagePack1Available, Converter={StaticResource BoolToVisibility}}"
                                        Height="38" Margin="4"
                                        Classes="primary"
                                        AutomationProperties.Name="{ext:Translate DownloadImagePack1}" />
                                <Button Content="{ext:Translate DownloadImagePack2}"
                                        Command="{Binding DownloadImagePack2Command}"
                                        IsEnabled="{Binding IsImagePack2Downloaded, Converter={StaticResource InverseBool}}"
                                        IsVisible="{Binding IsImagePack2Available, Converter={StaticResource BoolToVisibility}}"
                                        Height="38" Margin="4"
                                        Classes="primary"
                                        AutomationProperties.Name="{ext:Translate DownloadImagePack2}" />
                                <Button Content="{ext:Translate DownloadImagePack3}"
                                        Command="{Binding DownloadImagePack3Command}"
                                        IsEnabled="{Binding IsImagePack3Downloaded, Converter={StaticResource InverseBool}}"
                                        IsVisible="{Binding IsImagePack3Available, Converter={StaticResource BoolToVisibility}}"
                                        Height="38" Margin="4"
                                        Classes="primary"
                                        AutomationProperties.Name="{ext:Translate DownloadImagePack3}" />
                                <Button Content="{ext:Translate DownloadImagePack4}"
                                        Command="{Binding DownloadImagePack4Command}"
                                        IsEnabled="{Binding IsImagePack4Downloaded, Converter={StaticResource InverseBool}}"
                                        IsVisible="{Binding IsImagePack4Available, Converter={StaticResource BoolToVisibility}}"
                                        Height="38" Margin="4"
                                        Classes="primary"
                                        AutomationProperties.Name="{ext:Translate DownloadImagePack4}" />
                                <Button Content="{ext:Translate DownloadImagePack5}"
                                        Command="{Binding DownloadImagePack5Command}"
                                        IsEnabled="{Binding IsImagePack5Downloaded, Converter={StaticResource InverseBool}}"
                                        IsVisible="{Binding IsImagePack5Available, Converter={StaticResource BoolToVisibility}}"
                                        Height="38" Margin="4"
                                        Classes="primary"
                                        AutomationProperties.Name="{ext:Translate DownloadImagePack5}" />
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Row 2: Footer (progress + action) -->
        <Border Grid.Row="2"
                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0"
                Background="{DynamicResource BgSecondaryBrush}" Padding="20">
            <Grid ColumnDefinitions="*,Auto">

                <!-- Progress -->
                <Grid Grid.Column="0" Margin="0,0,20,0" RowDefinitions="Auto,Auto">

                    <Grid>
                        <ProgressBar Height="20"
                                     Value="{Binding DownloadProgress, Mode=OneWay}"
                                     Minimum="0" Maximum="100"
                                     AutomationProperties.Name="{ext:Translate DownloadProgress}" />
                        <TextBlock Text="{ext:Translate DownloadProgress}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="10" />
                    </Grid>

                    <DockPanel Grid.Row="1" Margin="0,6,0,0">
                        <Button DockPanel.Dock="Right"
                                Content="{ext:Translate StopDownload}"
                                Margin="10,0,0,0" Padding="10,4"
                                Command="{Binding StopDownloadCommand}"
                                IsEnabled="{Binding CanStopDownload}"
                                Classes="secondary"
                                AutomationProperties.Name="{ext:Translate StopDownload}" />
                        <TextBlock Text="{Binding DownloadStatus}"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                    </DockPanel>
                </Grid>

                <!-- Add System button -->
                <Button Grid.Column="1"
                        Content="{ext:Translate AddSystem}"
                        Command="{Binding AddSystemCommand}"
                        IsEnabled="{Binding IsAddSystemEnabled}"
                        FontSize="16" FontWeight="Bold"
                        Padding="32,12"
                        Classes="primary"
                        AutomationProperties.Name="{ext:Translate AddSystem}" />
            </Grid>
        </Border>

        <!-- Loading overlay -->
        <Border x:Name="LoadingOverlay"
                Grid.Row="0" Grid.RowSpan="3"
                Background="#B31E1E1E"
                IsVisible="False">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="LoadingText"
                           Text="{Binding LoadingMessage}"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           FontSize="14"
                           HorizontalAlignment="Center" />
                <Button x:Name="EmergencyButton"
                        Content="{ext:Translate Cancel}"
                        Width="100" Margin="0,16,0,0"
                        Classes="secondary"
                        Click="EmergencyOverlay_Click"
                        HorizontalAlignment="Center"
                        AutomationProperties.Name="{ext:Translate Cancel}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>