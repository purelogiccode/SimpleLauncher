        <Using Include="Serilog" />
    </ItemGroup>

    <!-- ── Single updater (Updater.exe, shared by the WPF and Avalonia apps) ──
         The updater is a standalone executable (no compile reference — ReferenceOutputAssembly=false),
         but it must ship in the same folder as both apps so updates can replace the app files while
         the updater itself stays locked/running. It is published framework-dependent single-file so
         the same Updater.exe works from either app's folder and in older WPF-only installs. -->
    <ItemGroup>
        <ProjectReference Include="..\SimpleLauncher.Avalonia.Updater\SimpleLauncher.Avalonia.Updater.csproj"
                          ReferenceOutputAssembly="false"
                          Private="false" />
    </ItemGroup>
    <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
        <PackageReference Include="System.Drawing.Common" Version="10.0.12" />
    </ItemGroup>

    <!-- ── Staging path for the app payload's copy of the updater ──
         The updater is published into the app's obj folder instead of its own bin/publish so that
         stale runtime files from earlier publishes (incremental publish over a changed runtime pack
         can retain newer-timestamped files) can never leak into the app payload. The runtime
         version is part of the path, so changing RuntimeFrameworkVersion starts from a fresh tree. -->
    <PropertyGroup Condition="'$(TargetFramework)' != ''">
        <AvaloniaUpdaterPublishDir>$(MSBuildThisFileDirectory)$(BaseIntermediateOutputPath)avalonia-updater\$(RuntimeFrameworkVersion)\$(Configuration)\$(TargetFramework)\</AvaloniaUpdaterPublishDir>
        <AvaloniaUpdaterPublishDir Condition="'$(RuntimeIdentifier)' != ''">$(AvaloniaUpdaterPublishDir)$(RuntimeIdentifier)\publish\</AvaloniaUpdaterPublishDir>
        <AvaloniaUpdaterPublishDir Condition="'$(RuntimeIdentifier)' == ''">$(AvaloniaUpdaterPublishDir)publish\</AvaloniaUpdaterPublishDir>
    </PropertyGroup>

    <!-- The updater's publish tree always starts at publish\, so %(RecursiveDir) is carried to the
         destination; flattening with bare %(Filename) would drop subfolders (satellites, runtimes\...).

         Publishing:
         - PublishAvaloniaUpdater (BeforeTargets=CopyAvaloniaUpdaterToPublishDir) publishes the
           updater for the same Configuration/TFM/RID into the staging folder as a
           framework-dependent single file (Updater.exe). With ReferenceOutputAssembly=false the
           SDK only contributes the updater's apphost/deps/runtimeconfig to the app publish (no
           managed dll), so without this target a fresh checkout would produce an updater that
           cannot run. RuntimeFrameworkVersion is passed through so the updater's own output
           follows the apps' runtime pin. The Avalonia native libraries the updater needs to start
           (libSkiaSharp, libHarfBuzzSharp, av_libglesv2) are bundled into the single file and
           self-extracted at launch: updater_{rid}.zip ships Updater.exe alone, so it must run on
           legacy WPF-only installs that have no Avalonia natives in the application folder.
         - CopyAvaloniaUpdaterToPublishDir (AfterTargets=Publish) copies the staging tree into the
           app publish folder; the Error guard makes a missing updater publish a build failure
           instead of a silently broken updater in the payload.
         - CopyAvaloniaUpdaterToOutput (AfterTargets=Build) mirrors an existing staging tree into
           the plain build output. -->
    <Target Name="CopyAvaloniaUpdaterToOutput" AfterTargets="Build" Condition="'$(TargetFramework)' != ''">
        <ItemGroup>
            <AvaloniaUpdaterFiles Include="$(AvaloniaUpdaterPublishDir)**\*.*" />
        </ItemGroup>
        <Copy SourceFiles="@(AvaloniaUpdaterFiles)"
              DestinationFiles="@(AvaloniaUpdaterFiles->'$(OutDir)%(RecursiveDir)%(Filename)%(Extension)')"
              SkipUnchangedFiles="true" />
    </Target>
    <Target Name="PublishAvaloniaUpdater"
            BeforeTargets="CopyAvaloniaUpdaterToPublishDir"
            Condition="'$(TargetFramework)' != ''">
        <!-- PublishDir is set explicitly so the app's own output directory (-o) is not propagated
             into the updater publish, which would leave the staging path empty. The staging tree
             is removed first: publish overwrites but never deletes, so files produced by earlier
             publishes with different options (for example an Updater.runtimeconfig.json from a
             non-single-file run) would otherwise stay and leak into the app payload. -->
        <RemoveDir Directories="$(AvaloniaUpdaterPublishDir)"
                   Condition="Exists('$(AvaloniaUpdaterPublishDir)')"
                   ContinueOnError="true" />
        <MSBuild Projects="..\SimpleLauncher.Avalonia.Updater\SimpleLauncher.Avalonia.Updater.csproj"
                 Targets="Publish"
                 Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework);RuntimeIdentifier=$(RuntimeIdentifier);SelfContained=false;PublishSingleFile=true;IncludeNativeLibrariesForSelfExtract=true;RuntimeFrameworkVersion=$(RuntimeFrameworkVersion);PublishDir=$(AvaloniaUpdaterPublishDir)"
                 Condition="'$(RuntimeIdentifier)' != ''" />
        <MSBuild Projects="..\SimpleLauncher.Avalonia.Updater\SimpleLauncher.Avalonia.Updater.csproj"
                 Targets="Publish"
                 Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework);SelfContained=false;PublishSingleFile=true;IncludeNativeLibrariesForSelfExtract=true;RuntimeFrameworkVersion=$(RuntimeFrameworkVersion);PublishDir=$(AvaloniaUpdaterPublishDir)"
                 Condition="'$(RuntimeIdentifier)' == ''" />
    </Target>
    <Target Name="CopyAvaloniaUpdaterToPublishDir" AfterTargets="Publish" Condition="'$(PublishDir)' != ''">
        <ItemGroup>
            <AvaloniaUpdaterPublishFiles Include="$(AvaloniaUpdaterPublishDir)**\*.*" />
        </ItemGroup>
        <Error Condition="'@(AvaloniaUpdaterPublishFiles)' == ''"
               Text="The Avalonia updater publish output was not found under '$(AvaloniaUpdaterPublishDir)'. PublishAvaloniaUpdater should have produced it; check the updater publish for errors." />
        <Copy SourceFiles="@(AvaloniaUpdaterPublishFiles)"
              DestinationFiles="@(AvaloniaUpdaterPublishFiles->'$(PublishDir)%(RecursiveDir)%(Filename)%(Extension)')"
              SkipUnchangedFiles="true" />
    </Target>
</Project>