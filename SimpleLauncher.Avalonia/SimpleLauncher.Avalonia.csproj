<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>net10.0;net10.0-windows</TargetFrameworks>
        <RuntimeFrameworkVersion>10.0.2</RuntimeFrameworkVersion>
        <OutputType>WinExe</OutputType>
        <ImplicitUsings>enable</ImplicitUsings>
        <IsPackable>false</IsPackable>
        <Company>PureLogicCode.com</Company>
        <Product>Simple Launcher</Product>
        <LangVersion>14</LangVersion>
        <Nullable>enable</Nullable>
        <NeutralLanguage>en</NeutralLanguage>
        <RuntimeIdentifiers Condition="'$(TargetFramework)' == 'net10.0-windows'">win-x64;win-arm64</RuntimeIdentifiers>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <DebugType>embedded</DebugType>
        <DebugSymbols>true</DebugSymbols>
        <NoWarn>NU1903;CS0436</NoWarn>
        <AssemblyName>SimpleLauncher.Avalonia</AssemblyName>
        <RootNamespace>SimpleLauncher.Avalonia</RootNamespace>
        <SupportedOSPlatformVersion>7.0</SupportedOSPlatformVersion>
        <AssemblyVersion>5.7.0</AssemblyVersion>
        <FileVersion>5.7.0</FileVersion>
        <Version>5.7.0</Version>
        <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
        <ApplicationIcon>icon\icon.ico</ApplicationIcon>
        <PackageIcon>icon\icon2.png</PackageIcon>
        <RepositoryUrl>https://github.com/purelogiccode/SimpleLauncher</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageProjectUrl>https://github.com/purelogiccode/SimpleLauncher</PackageProjectUrl>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <UseWindowsForms>False</UseWindowsForms>
        <StartupObject>SimpleLauncher.Avalonia.Program</StartupObject>
        <!-- Avalonia single-project (no .xaml split) -->
        <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    </PropertyGroup>

    <!-- Linux target (net10.0): linux RIDs only. A Windows RID on this TFM builds
         WITHOUT the WINDOWS symbol, so Core's PlaySoundEffects silently takes the
         libsndfile/SoundFileReader path and crashes on Windows with
         DllNotFoundException: libsndfile (no Windows native binary is shipped).
         Fail loudly instead of producing a broken publish. -->
    <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
        <RuntimeIdentifiers>linux-x64;linux-arm64</RuntimeIdentifiers>
    </PropertyGroup>

    <Target Name="GuardWindowsRidOnLinuxTfm" BeforeTargets="Build;Publish">
        <Error
            Condition="'$(TargetFramework)' == 'net10.0' and $([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('win'))"
            Text="Cannot build/publish net10.0 with a Windows RuntimeIdentifier '$([System.String]::Copy('$(RuntimeIdentifier)'))'. The net10.0 TFM is Linux-only (audio uses libsndfile). For Windows, use the net10.0-windows TFM, e.g. `dotnet publish -f net10.0-windows -r $(RuntimeIdentifier)`." />
    </Target>

    <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
        <PlatformTarget>AnyCPU</PlatformTarget>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
        <IsPublishable>False</IsPublishable>
        <PlatformTarget>AnyCPU</PlatformTarget>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\SimpleLauncher.Core\SimpleLauncher.Core.csproj" />
    </ItemGroup>

    <ItemGroup>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
            <_Parameter1>SimpleLauncher.Avalonia.Tests</_Parameter1>
        </AssemblyAttribute>
    </ItemGroup>

