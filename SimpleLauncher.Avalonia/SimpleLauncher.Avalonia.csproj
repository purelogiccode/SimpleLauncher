    <!-- ── Avalonia Updater (phase 1.1: ship the updater next to the app) ──
         The updater is a standalone executable (no compile reference — ReferenceOutputAssembly=false),
         but it must ship in the same folder as the app so updates can replace the app files while
         the updater itself stays locked/running. -->
    <ItemGroup>
        <ProjectReference Include="..\SimpleLauncher.Avalonia.Updater\SimpleLauncher.Avalonia.Updater.csproj"
                          ReferenceOutputAssembly="false" />
    </ItemGroup>
    <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
      <PackageReference Include="System.Drawing.Common" Version="10.0.12" />
    </ItemGroup>

    <!-- $(OutDir) already ends with the RID folder (e.g. net10.0\linux-x64\); globbing the
         updater's publish tree directly and flattening with %(Filename) avoids the
         RecursiveDir RID-doubling the previous **-glob produced (linux-x64\linux-x64\).
         AfterTargets=Build refreshes the plain build output; AfterTargets=Publish is
         required because with ReferenceOutputAssembly=false the SDK publish payload only
         carries the updater's apphost+runtimeconfig, not its managed dll/deps — without
         this, a fresh checkout would publish an updater that cannot run. -->
    <Target Name="CopyAvaloniaUpdaterToOutput" AfterTargets="Build" Condition="'$(TargetFramework)' != ''">
        <ItemGroup>
            <AvaloniaUpdaterFiles
                Include="..\SimpleLauncher.Avalonia.Updater\bin\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\publish\**\*.*"
                Condition="'$(RuntimeIdentifier)' != ''" />
            <AvaloniaUpdaterFiles
                Include="..\SimpleLauncher.Avalonia.Updater\bin\$(Configuration)\$(TargetFramework)\publish\**\*.*"
                Condition="'$(RuntimeIdentifier)' == ''" />
        </ItemGroup>
        <Copy SourceFiles="@(AvaloniaUpdaterFiles)"
              DestinationFiles="@(AvaloniaUpdaterFiles->'$(OutDir)%(Filename)%(Extension)')"
              SkipUnchangedFiles="true" />
    </Target>
    <Target Name="CopyAvaloniaUpdaterToPublishDir" AfterTargets="Publish" Condition="'$(PublishDir)' != ''">
        <ItemGroup>
            <AvaloniaUpdaterPublishFiles
                Include="..\SimpleLauncher.Avalonia.Updater\bin\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\publish\**\*.*"
                Condition="'$(RuntimeIdentifier)' != ''" />
            <AvaloniaUpdaterPublishFiles
                Include="..\SimpleLauncher.Avalonia.Updater\bin\$(Configuration)\$(TargetFramework)\publish\**\*.*"
                Condition="'$(RuntimeIdentifier)' == ''" />
        </ItemGroup>
        <Copy SourceFiles="@(AvaloniaUpdaterPublishFiles)"
              DestinationFiles="@(AvaloniaUpdaterPublishFiles->'$(PublishDir)%(Filename)%(Extension)')"
              SkipUnchangedFiles="true" />
    </Target>
</Project>