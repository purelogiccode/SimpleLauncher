    <!-- UI icons (root of images\) — embedded into the binary (Avalonia equivalent of the WPF
         <Resource Include="images\*.png" /> entries) and loaded via
         avares://SimpleLauncher.Avalonia/images/*.png. Only images\default.png is copied loose:
         appsettings.json (RequiredFiles/DefaultImagePath), PathToImageConverter and the system
         image resolver load it from disk by path, exactly like the WPF app ships it. -->
    <ItemGroup>
        <AvaloniaResource Include="images\*.png" />
        <AvaloniaResource Include="icon\icon.ico" />
        <None Update="images\default.png">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
    </ItemGroup>

