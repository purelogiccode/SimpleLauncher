<Window x:Class="SimpleLauncher.Avalonia.SoundConfigurationWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:ext="using:SimpleLauncher.Avalonia.Extensions"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{ext:Translate SoundConfiguration}"
        Width="500" Height="300"
        WindowStartupLocation="CenterScreen"
        CanResize="False">
    <Grid Margin="15" ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">

        <CheckBox Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                  Content="{ext:Translate EnableNotificationSound}"
                  Margin="0,0,0,10"
                  IsChecked="{Binding EnableNotificationSound}" />

        <TextBlock Grid.Row="1" Grid.Column="0"
                   Classes="form-label"
                   Text="{ext:Translate SoundConfigurationWindow_Notification_sound_file}" />
        <TextBox Grid.Row="1" Grid.Column="1"
                 IsReadOnly="True"
                 Text="{Binding NotificationSoundFile}"
                 Margin="5,0,5,0"
                 VerticalAlignment="Center"
                 IsEnabled="{Binding IsSoundControlsEnabled}"
                 AutomationProperties.Name="{ext:Translate SoundConfigurationWindow_Notification_sound_file}" />
        <Button Grid.Row="1" Grid.Column="2"
                Content="{ext:Translate ChooseFile}"
                Command="{Binding ChooseSoundFileCommand}"
                VerticalAlignment="Center"
                Width="100"
                IsEnabled="{Binding IsSoundControlsEnabled}"
                AutomationProperties.Name="{ext:Translate ChooseFile}" />

        <Button Grid.Row="2" Grid.Column="1"
                Content="{ext:Translate PlayCurrentSound}"
                Command="{Binding PlayCurrentSoundCommand}"
                Margin="5,10,5,0"
                HorizontalAlignment="Left"
                Width="150"
                IsEnabled="{Binding IsSoundControlsEnabled}"
                AutomationProperties.Name="{ext:Translate PlayCurrentSound}" />

        <Button Grid.Row="3" Grid.Column="1"
                Content="{ext:Translate ResetToDefault}"
                Command="{Binding ResetToDefaultCommand}"
                Margin="5,10,5,0"
                HorizontalAlignment="Left"
                Width="150"
                IsEnabled="{Binding IsSoundControlsEnabled}"
                AutomationProperties.Name="{ext:Translate ResetToDefault}" />

        <StackPanel Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Classes="primary"
                    Content="{ext:Translate Save}"
                    Command="{Binding SaveCommand}"
                    IsDefault="True"
                    Width="100" Margin="0,0,10,0"
                    AutomationProperties.Name="{ext:Translate Save}" />
            <Button Classes="secondary"
                    Content="{ext:Translate Cancel}"
                    Command="{Binding CancelCommand}"
                    IsCancel="True"
                    Width="100"
                    AutomationProperties.Name="{ext:Translate Cancel}" />
        </StackPanel>
    </Grid>
</Window>