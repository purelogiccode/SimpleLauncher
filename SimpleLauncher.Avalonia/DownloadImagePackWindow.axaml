<Window x:Class="SimpleLauncher.Avalonia.DownloadImagePackWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:ext="using:SimpleLauncher.Avalonia.Extensions"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="using:SimpleLauncher.Core.Models"
        Title="{ext:Translate DownloadImagePack}"
        Width="650" MinWidth="550"
        Height="600" MinHeight="500"
        WindowStartupLocation="CenterScreen">
    <Grid RowDefinitions="Auto,*,Auto">

        <!-- 1. Header Section -->
        <StackPanel Grid.Row="0" Margin="20,20,20,10">
            <TextBlock Text="{ext:Translate DownloadImagePack}" FontSize="24" FontWeight="Light" Margin="0,0,0,10" />
            <TextBlock Text="{ext:Translate DownloadImagePackWindow_Download_high_quality_artwork_for_your_g}"
                       TextWrapping="Wrap" FontSize="12" Opacity="0.6" />
        </StackPanel>

        <!-- 2. Main Content -->
        <Grid Grid.Row="1" Margin="20,10,20,10"
              ColumnDefinitions="*,20,*"
              IsEnabled="{Binding IsMainContentEnabled}">

            <!-- Left Column: Selection & Info -->
            <StackPanel Grid.Column="0">
                <TextBlock Text="{ext:Translate PleaseselectanImagePack}" FontWeight="SemiBold" Margin="0,0,0,10" />
                <ComboBox HorizontalAlignment="Stretch"
                          Margin="0,5,0,0"
                          ItemsSource="{Binding SystemNames}"
                          SelectedItem="{Binding SelectedSystemName}"
                          IsEnabled="{Binding IsSystemDropdownEnabled}"
                          AutomationProperties.Name="{ext:Translate PleaseselectanImagePack}" />

                <!-- Resources Links -->
                <StackPanel Margin="0,20,0,0">
                    <TextBlock Text="{ext:Translate Resources}" FontWeight="SemiBold" Margin="0,0,0,10" />
                    <TextBlock Text="{ext:Translate DownloadImagePackWindow_In_case_the_image_pack_is_not_available_}"
                               TextWrapping="Wrap" FontSize="12" Opacity="0.6" Margin="0,0,0,5" />
                    <Button Margin="0,0,0,5" Padding="0"
                            Background="Transparent" BorderThickness="0"
                            Foreground="{DynamicResource LinkBrush}"
                            HorizontalAlignment="Left"
                            Command="{Binding HyperlinkNavigateCommand}"
                            CommandParameter="https://github.com/libretro-thumbnails/libretro-thumbnails"
                            Content="{ext:Translate DownloadImagePackWindow_Libretro_Thumbnails_GitHub}"
                            AutomationProperties.Name="{ext:Translate DownloadImagePackWindow_Libretro_Thumbnails_GitHub}" />
                    <Button Padding="0"
                            Background="Transparent" BorderThickness="0"
                            Foreground="{DynamicResource LinkBrush}"
                            HorizontalAlignment="Left"
                            Command="{Binding HyperlinkNavigateCommand}"
                            CommandParameter="https://emumovies.com/files/"
                            Content="{ext:Translate DownloadImagePackWindow_EmuMovies_Files}"
                            AutomationProperties.Name="{ext:Translate DownloadImagePackWindow_EmuMovies_Files}" />
                </StackPanel>
            </StackPanel>

            <!-- Right Column: Download Actions -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="{ext:Translate InstallImagePack}" FontWeight="SemiBold" Margin="0,0,0,10" />

                    <Border BorderBrush="{DynamicResource BorderNormalBrush}" BorderThickness="1" CornerRadius="3"
                            Padding="10">
                        <ItemsControl ItemsSource="{Binding ImagePacksToDisplay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" HorizontalAlignment="Left" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:ImagePackDownloadItem">
                                    <Button Content="{Binding DisplayName}"
                                            AutomationProperties.Name="{Binding DisplayName}"
                                            Height="40"
                                            Margin="5"
                                            Command="{Binding $parent[Window].DataContext.DownloadImagePackCommand, FallbackValue={x:Null}}"
                                            CommandParameter="{Binding}"
                                            IsEnabled="{Binding CanStartDownload}"
                                            Classes="primary" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <TextBlock Text="{ext:Translate DownloadImagePackWindow_Image_packs_are_downloaded_and_installed}"
                               TextWrapping="Wrap" FontSize="11" Opacity="0.6" Margin="5,10,5,0" FontStyle="Italic" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- 3. Footer: Progress -->
        <Border Grid.Row="2" BorderBrush="{DynamicResource BorderNormalBrush}" BorderThickness="0,1,0,0"
                Background="{DynamicResource BgSecondaryBrush}" Padding="20">
            <Grid ColumnDefinitions="*,Auto">

                <!-- Progress Info -->
                <Grid Grid.Column="0" Margin="0,0,20,0" RowDefinitions="Auto,Auto">
                    <Grid>
                        <ProgressBar Value="{Binding ProgressPercentage, Mode=OneWay}" Height="20" Minimum="0"
                                     Maximum="100"
                                     AutomationProperties.Name="{ext:Translate DownloadProgress}" />
                        <TextBlock Text="{ext:Translate DownloadProgress}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="10" />
                    </Grid>

                    <TextBlock Grid.Row="1" Margin="0,5,0,0"
                               Text="{Binding StatusMessage}"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold" />
                </Grid>

                <!-- Stop Button -->
                <Button Grid.Column="1"
                        Content="{ext:Translate StopDownload}"
                        Command="{Binding StopDownloadCommand}"
                        IsEnabled="{Binding IsStopEnabled}"
                        Classes="secondary"
                        Padding="20,10"
                        VerticalAlignment="Top"
                        AutomationProperties.Name="{ext:Translate StopDownload}" />
            </Grid>
        </Border>

        <!-- Loading Overlay -->
        <Border Grid.Row="0" Grid.RowSpan="3"
                Background="{DynamicResource OverlayProcessingBrush}"
                IsVisible="{Binding IsLoading}"
                ZIndex="10">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="220"
                             AutomationProperties.Name="Loading" />
                <TextBlock Text="{Binding LoadingMessage}"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           FontSize="14"
                           HorizontalAlignment="Center"
                           Margin="0,12,0,0" />
                <Button x:Name="EmergencyButton" Content="{ext:Translate EditSystemWindow_Return}" Width="100"
                        Margin="0,16,0,0"
                        Classes="secondary"
                        Click="EmergencyOverlayRelease_Click"
                        HorizontalAlignment="Center"
                        AutomationProperties.Name="{ext:Translate EditSystemWindow_Return}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>