<Window x:Class="SimpleLauncher.Avalonia.InjectConfigWindows.InjectRetroArchConfigWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:ext="using:SimpleLauncher.Avalonia.Extensions"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{ext:Translate RetroArchConfig_Title}"
        Height="800" Width="700"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgPrimaryBrush}">

    <Grid Margin="10" RowDefinitions="*,Auto">

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Video Section -->
                <GroupBox Header="{ext:Translate RetroArchConfig_Video_Header}" Margin="0,0,0,10">
                    <StackPanel Margin="5">
                        <Grid ColumnDefinitions="*,*" Margin="0,0,0,5">
                            <TextBlock Text="{ext:Translate RetroArchConfig_VideoDriver_Label}" Classes="form-label" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding VideoDriverOptions}"
                                      SelectedItem="{Binding VideoDriver}"
                                      AutomationProperties.Name="{ext:Translate RetroArchConfig_VideoDriver_Tooltip}"
                                      ToolTip.Tip="{ext:Translate RetroArchConfig_VideoDriver_Tooltip}" />
                        </Grid>
                        <CheckBox IsChecked="{Binding Fullscreen}"
                                  Content="{ext:Translate RetroArchConfig_Fullscreen_Checkbox}"
                                  Margin="0,5"
                                  ToolTip.Tip="{ext:Translate RetroArchConfig_Fullscreen_Tooltip}" />
                        <CheckBox IsChecked="{Binding Vsync}"
                                  Content="{ext:Translate RetroArchConfig_VSync_Checkbox}"
                                  Margin="0,5"
                                  ToolTip.Tip="{ext:Translate RetroArchConfig_VSync_Tooltip}" />
                        <CheckBox IsChecked="{Binding ThreadedVideo}"
                                  Content="{ext:Translate RetroArchConfig_ThreadedVideo_Checkbox}"
                                  Margin="0,5"
                                  ToolTip.Tip="{ext:Translate RetroArchConfig_ThreadedVideo_Tooltip}" />
                        <CheckBox IsChecked="{Binding Bilinear}"
                                  Content="{ext:Translate RetroArchConfig_Bilinear_Checkbox}"
                                  Margin="0,5"
                                  ToolTip.Tip="{ext:Translate RetroArchConfig_Bilinear_Tooltip}" />
                        <Grid ColumnDefinitions="*,*" Margin="0,0,0,5">
                            <TextBlock Text="{ext:Translate RetroArchConfig_AspectRatio_Label}" Classes="form-label" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding AspectRatioIndexOptions}"
                                      SelectedItem="{Binding AspectRatioIndex}"
                                      AutomationProperties.Name="{ext:Translate RetroArchConfig_AspectRatio_Tooltip}"
                                      ToolTip.Tip="{ext:Translate RetroArchConfig_AspectRatio_Tooltip}" />
                        </Grid>
                        <CheckBox IsChecked="{Binding ScaleInteger}"
                                  Content="{ext:Translate RetroArchConfig_IntegerScale_Checkbox}"
                                  Margin="0,5"
                                  ToolTip.Tip="{ext:Translate RetroArchConfig_IntegerScale_Tooltip}" />
                        <CheckBox IsChecked="{Binding ShaderEnable}"
                                  Content="{ext:Translate RetroArchConfig_Shaders_Checkbox}"
                                  Margin="0,5"
                                  ToolTip.Tip="{ext:Translate RetroArchConfig_Shaders_Tooltip}" />
                        <CheckBox IsChecked="{Binding HardSync}"
                                  Content="{ext:Translate RetroArchConfig_HardSync_Checkbox}"
                                  Margin="0,5"
                                  ToolTip.Tip="{ext:Translate RetroArchConfig_HardSync_Tooltip}" />
                    </StackPanel>
                </GroupBox>

                <!-- Audio Section -->
                <GroupBox Header="{ext:Translate RetroArchConfig_Audio_Header}" Margin="0,0,0,10">
                    <StackPanel Margin="5">
                        <CheckBox IsChecked="{Binding AudioEnable}"
                                  Content="{ext:Translate RetroArchConfig_AudioEnabled_Checkbox}"
                                  Margin="0,5"
                                  ToolTip.Tip="{ext:Translate RetroArchConfig_AudioEnable_Tooltip}" />
                        <CheckBox IsChecked="{Binding AudioMute}"
                                  Content="{ext:Translate RetroArchConfig_Mute_Checkbox}"
                                  Margin="0,5"
                                  ToolTip.Tip="{ext:Translate RetroArchConfig_AudioMute_Tooltip}" />
                    </StackPanel>
                </GroupBox>

                <!-- Automation & Misc -->
                <GroupBox Header="{ext:Translate RetroArchConfig_AutomationBehavior_Header}" Margin="0,0,0,10">
                    <StackPanel Margin="5">
                        <CheckBox IsChecked="{Binding PauseNonActive}"
                                  Content="{ext:Translate RetroArchConfig_PauseNonActive_Checkbox}"
                                  Margin="0,5"
                                  ToolTip.Tip="{ext:Translate RetroArchConfig_PauseNonActive_Tooltip}" />
                        <CheckBox IsChecked="{Binding SaveOnExit}"
                                  Content="{ext:Translate RetroArchConfig_SaveOnExit_Checkbox}"
                                  Margin="0,5"
                                  ToolTip.Tip="{ext:Translate RetroArchConfig_SaveOnExit_Tooltip}" />
                        <CheckBox IsChecked="{Binding AutoSaveState}"
                                  Content="{ext:Translate RetroArchConfig_AutoSaveState_Checkbox}"
                                  Margin="0,5"
                                  ToolTip.Tip="{ext:Translate RetroArchConfig_AutoSaveState_Tooltip}" />
                        <CheckBox IsChecked="{Binding AutoLoadState}"
                                  Content="{ext:Translate RetroArchConfig_AutoLoadState_Checkbox}"
                                  Margin="0,5"
                                  ToolTip.Tip="{ext:Translate RetroArchConfig_AutoLoadState_Tooltip}" />
                        <CheckBox IsChecked="{Binding Rewind}"
                                  Content="{ext:Translate RetroArchConfig_Rewind_Checkbox}"
                                  Margin="0,5"
                                  ToolTip.Tip="{ext:Translate RetroArchConfig_Rewind_Tooltip}" />
                        <CheckBox IsChecked="{Binding RunAhead}"
                                  Content="{ext:Translate RetroArchConfig_RunAhead_Checkbox}"
                                  Margin="0,5"
                                  ToolTip.Tip="{ext:Translate RetroArchConfig_RunAhead_Tooltip}" />
                    </StackPanel>
                </GroupBox>

                <!-- UI Section -->
                <GroupBox Header="{ext:Translate RetroArchConfig_UI_Header}" Margin="0,0,0,10">
                    <StackPanel Margin="5">
                        <Grid ColumnDefinitions="*,*" Margin="0,0,0,5">
                            <TextBlock Text="{ext:Translate RetroArchConfig_MenuDriver_Label}" Classes="form-label" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding MenuDriverOptions}"
                                      SelectedItem="{Binding MenuDriver}"
                                      AutomationProperties.Name="{ext:Translate RetroArchConfig_MenuDriver_Tooltip}"
                                      ToolTip.Tip="{ext:Translate RetroArchConfig_MenuDriver_Tooltip}" />
                        </Grid>
                        <CheckBox IsChecked="{Binding ShowAdvancedSettings}"
                                  Content="{ext:Translate RetroArchConfig_AdvancedSettings_Checkbox}"
                                  Margin="0,5"
                                  ToolTip.Tip="{ext:Translate RetroArchConfig_AdvancedSettings_Tooltip}" />
                    </StackPanel>
                </GroupBox>

                <!-- RetroAchievements -->
                <GroupBox Header="{ext:Translate RetroArchConfig_RetroAchievements_Header}" Margin="0,0,0,10">
                    <StackPanel Margin="5">
                        <TextBlock Text="{ext:Translate RetroArchConfig_CredentialsManaged_Text}"
                                   FontStyle="Italic"
                                   Margin="0,0,0,5"
                                   TextWrapping="Wrap" />
                        <CheckBox IsChecked="{Binding CheevosEnable}"
                                  Content="{ext:Translate RetroArchConfig_EnableCheevos_Checkbox}"
                                  Margin="0,5"
                                  ToolTip.Tip="{ext:Translate RetroArchConfig_EnableCheevos_Tooltip}" />
                        <CheckBox IsChecked="{Binding CheevosHardcore}"
                                  Content="{ext:Translate RetroArchConfig_HardcoreMode_Checkbox}"
                                  Margin="0,5"
                                  ToolTip.Tip="{ext:Translate RetroArchConfig_HardcoreMode_Tooltip}" />
                        <CheckBox IsChecked="{Binding DiscordAllow}"
                                  Content="{ext:Translate RetroArchConfig_DiscordPresence_Checkbox}"
                                  Margin="0,5"
                                  ToolTip.Tip="{ext:Translate RetroArchConfig_DiscordPresence_Tooltip}" />
                    </StackPanel>
                </GroupBox>

                <!-- CRITICAL SETTING -->
                <Border Classes="important-setting">
                    <StackPanel>
                        <TextBlock Text="{ext:Translate IMPORTANTSETTING}" Classes="important-setting-header" />
                        <CheckBox IsChecked="{Binding ShowBeforeLaunch}"
                                  Content="{ext:Translate RetroArchConfig_ShowBeforeLaunch_Checkbox}"
                                  ToolTip.Tip="{ext:Translate RetroArchConfig_ShowBeforeLaunch_Tooltip}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="BtnSave"
                    Content="{ext:Translate RetroArchConfig_Save_Button}"
                    Classes="secondary"
                    Command="{Binding SaveCommand}"
                    AutomationProperties.Name="{ext:Translate RetroArchConfig_Save_Tooltip}"
                    ToolTip.Tip="{ext:Translate RetroArchConfig_Save_Tooltip}" />
            <Button Content="{ext:Translate RetroArchConfig_Run_Button2}"
                    Classes="primary"
                    Command="{Binding RunCommand}"
                    IsDefault="True"
                    IsVisible="{Binding IsLauncherMode, Converter={StaticResource BoolToVisibility}}"
                    AutomationProperties.Name="{ext:Translate RetroArchConfig_Run_Tooltip}"
                    ToolTip.Tip="{ext:Translate RetroArchConfig_Run_Tooltip}" />
            <Button Content="{ext:Translate RetroArchConfig_Cancel_Button}"
                    Classes="secondary"
                    Command="{Binding CancelCommand}"
                    AutomationProperties.Name="{ext:Translate RetroArchConfig_Cancel_Tooltip}"
                    ToolTip.Tip="{ext:Translate RetroArchConfig_Cancel_Tooltip}" />
        </StackPanel>
    </Grid>
</Window>