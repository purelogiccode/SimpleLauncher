<Window x:Class="SimpleLauncher.Avalonia.InjectConfigWindows.InjectRedreamConfigWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:ext="using:SimpleLauncher.Avalonia.Extensions"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{ext:Translate RedreamConfig_Title}"
        Height="850" Width="700"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgPrimaryBrush}">

    <Grid Margin="10" RowDefinitions="*,Auto">

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Video Section -->
                <GroupBox Header="{ext:Translate RedreamConfig_Video_Header}" Margin="0,0,0,10">
                    <StackPanel Margin="5">
                        <Grid ColumnDefinitions="*,*" Margin="0,0,0,5">
                            <TextBlock Text="{ext:Translate RedreamConfig_Cable_Label}" Classes="form-label" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding CableOptions}"
                                      SelectedItem="{Binding RedreamCable}"
                                      AutomationProperties.Name="{ext:Translate RedreamConfig_Cable_Tooltip}"
                                      ToolTip.Tip="{ext:Translate RedreamConfig_Cable_Tooltip}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,*" Margin="0,0,0,5">
                            <TextBlock Text="{ext:Translate RedreamConfig_Broadcast_Label}" Classes="form-label" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding BroadcastOptions}"
                                      SelectedItem="{Binding RedreamBroadcast}"
                                      AutomationProperties.Name="{ext:Translate RedreamConfig_Broadcast_Tooltip}"
                                      ToolTip.Tip="{ext:Translate RedreamConfig_Broadcast_Tooltip}" />
                        </Grid>
                        <CheckBox IsChecked="{Binding RedreamVsync}"
                                  Content="{ext:Translate RedreamConfig_Vertical_Sync}"
                                  Margin="0,5"
                                  ToolTip.Tip="{ext:Translate RedreamConfig_Vertical_Sync_Tooltip}" />
                        <CheckBox IsChecked="{Binding RedreamFrameskip}"
                                  Content="{ext:Translate RedreamConfig_Frame_Skip}"
                                  Margin="0,5"
                                  ToolTip.Tip="{ext:Translate RedreamConfig_Frame_Skip_Tooltip}" />
                        <Grid ColumnDefinitions="*,*" Margin="0,5,0,5">
                            <TextBlock Text="{ext:Translate RedreamConfig_AspectRatio_Label}" Classes="form-label" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding AspectOptions}"
                                      SelectedItem="{Binding RedreamAspect}"
                                      AutomationProperties.Name="{ext:Translate RedreamConfig_Aspect_Tooltip}"
                                      ToolTip.Tip="{ext:Translate RedreamConfig_Aspect_Tooltip}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,*" Margin="0,5,0,5">
                            <TextBlock Text="{ext:Translate RedreamConfig_ResolutionScale_Label}" Classes="form-label" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding ResOptions}"
                                      SelectedItem="{Binding RedreamRes}"
                                      AutomationProperties.Name="{ext:Translate RedreamConfig_ResolutionScale_Tooltip}"
                                      ToolTip.Tip="{ext:Translate RedreamConfig_ResolutionScale_Tooltip}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,*" Margin="0,5,0,5">
                            <TextBlock Text="{ext:Translate RedreamConfig_Renderer_Label}" Classes="form-label" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding RendererOptions}"
                                      SelectedItem="{Binding RedreamRenderer}"
                                      AutomationProperties.Name="{ext:Translate RedreamConfig_Renderer_Tooltip}"
                                      ToolTip.Tip="{ext:Translate RedreamConfig_Renderer_Tooltip}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,*" Margin="0,5,0,5">
                            <TextBlock Text="{ext:Translate RedreamConfig_FullscreenMode_Label}" Classes="form-label" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding FullmodeOptions}"
                                      SelectedItem="{Binding RedreamFullmode}"
                                      AutomationProperties.Name="{ext:Translate RedreamConfig_FullscreenMode_Tooltip}"
                                      ToolTip.Tip="{ext:Translate RedreamConfig_FullscreenMode_Tooltip}" />
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <!-- System Section -->
                <GroupBox Header="{ext:Translate RedreamConfig_System_Header}" Margin="0,0,0,10">
                    <StackPanel Margin="5">
                        <Grid ColumnDefinitions="*,*" Margin="0,5,0,5">
                            <TextBlock Text="{ext:Translate RedreamConfig_Volume}" Classes="form-label" />
                            <DockPanel Grid.Column="1">
                                <TextBlock Text="{Binding ElementName=SldVolume, Path=Value, StringFormat={}{0}%}"
                                           Width="40" DockPanel.Dock="Right" VerticalAlignment="Center"
                                           Margin="5,0,0,0" />
                                <Slider x:Name="SldVolume"
                                        Value="{Binding RedreamVolume}"
                                        Minimum="0" Maximum="100"
                                        AutomationProperties.Name="Volume"
                                        TickFrequency="1" IsSnapToTickEnabled="True" />
                            </DockPanel>
                        </Grid>
                        <Grid ColumnDefinitions="*,*" Margin="0,5,0,5">
                            <TextBlock Text="{ext:Translate RedreamConfig_Latency_ms}" Classes="form-label" />
                            <ComboBox Grid.Column="1" IsEditable="True"
                                      Text="{Binding RedreamLatency}"
                                      AutomationProperties.Name="{ext:Translate RedreamConfig_Latency_Tooltip}"
                                      ToolTip.Tip="{ext:Translate RedreamConfig_Latency_Tooltip}">
                                <ComboBoxItem Content="8" />
                                <ComboBoxItem Content="16" />
                                <ComboBoxItem Content="32" />
                                <ComboBoxItem Content="48" />
                                <ComboBoxItem Content="64" />
                            </ComboBox>
                        </Grid>
                        <CheckBox IsChecked="{Binding RedreamFramerate}"
                                  Content="{ext:Translate RedreamConfig_Frame_Rate_Counter}"
                                  Margin="0,5"
                                  ToolTip.Tip="{ext:Translate RedreamConfig_Frame_Rate_Counter_Tooltip}" />
                        <Grid ColumnDefinitions="*,*" Margin="0,5,0,5">
                            <TextBlock Text="{ext:Translate RedreamConfig_Language_Label}" Classes="form-label" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding LanguageOptions}"
                                      SelectedItem="{Binding RedreamLanguage}"
                                      AutomationProperties.Name="{ext:Translate RedreamConfig_Language_Tooltip}"
                                      ToolTip.Tip="{ext:Translate RedreamConfig_Language_Tooltip}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,*" Margin="0,5,0,5">
                            <TextBlock Text="{ext:Translate RedreamConfig_Region_Label}" Classes="form-label" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding RegionOptions}"
                                      SelectedItem="{Binding RedreamRegion}"
                                      AutomationProperties.Name="{ext:Translate RedreamConfig_Region_Tooltip}"
                                      ToolTip.Tip="{ext:Translate RedreamConfig_Region_Tooltip}" />
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <!-- CRITICAL SETTING -->
                <Border Classes="important-setting">
                    <StackPanel>
                        <TextBlock Text="{ext:Translate IMPORTANTSETTING}" Classes="important-setting-header" />
                        <CheckBox IsChecked="{Binding RedreamShowSettingsBeforeLaunch}"
                                  Content="{ext:Translate RedreamConfig_ShowBeforeLaunch_Checkbox}"
                                  ToolTip.Tip="{ext:Translate RedreamConfig_ShowBeforeLaunch_Tooltip}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="BtnSave"
                    Content="{ext:Translate RedreamConfig_Save_Button}"
                    Classes="secondary"
                    Command="{Binding SaveCommand}"
                    AutomationProperties.Name="{ext:Translate RedreamConfig_Save_Tooltip}"
                    ToolTip.Tip="{ext:Translate RedreamConfig_Save_Tooltip}" />
            <Button Content="{ext:Translate RedreamConfig_Run_Button2}"
                    Classes="primary"
                    Command="{Binding RunCommand}"
                    IsDefault="True"
                    IsVisible="{Binding IsLauncherMode, Converter={StaticResource BoolToVisibility}}"
                    AutomationProperties.Name="{ext:Translate RedreamConfig_Run_Tooltip}"
                    ToolTip.Tip="{ext:Translate RedreamConfig_Run_Tooltip}" />
            <Button Content="{ext:Translate RedreamConfig_Cancel_Button}"
                    Classes="secondary"
                    Command="{Binding CancelCommand}"
                    AutomationProperties.Name="{ext:Translate RedreamConfig_Cancel_Tooltip}"
                    ToolTip.Tip="{ext:Translate RedreamConfig_Cancel_Tooltip}" />
        </StackPanel>
    </Grid>
</Window>