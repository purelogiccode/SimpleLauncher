<Window x:Class="SimpleLauncher.Avalonia.InjectConfigWindows.InjectAresConfigWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:ext="using:SimpleLauncher.Avalonia.Extensions"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{ext:Translate AresConfig_Title}"
        Height="700" Width="700"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgPrimaryBrush}">

    <Grid Margin="10" RowDefinitions="*,Auto">

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Video Section -->
                <GroupBox Header="{ext:Translate AresConfig_Video_Header}" Margin="0,0,0,10">
                    <StackPanel Margin="5">
                        <Grid ColumnDefinitions="*,*" Margin="0,0,0,5">
                            <TextBlock Text="{ext:Translate AresConfig_VideoDriver_Label}" Classes="form-label" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding VideoDriverOptions}"
                                      SelectedItem="{Binding VideoDriver}"
                                      AutomationProperties.Name="{ext:Translate AresConfig_VideoDriver_Tooltip}"
                                      ToolTip.Tip="{ext:Translate AresConfig_VideoDriver_Tooltip}" />
                        </Grid>
                        <CheckBox IsChecked="{Binding Exclusive}"
                                  Content="{ext:Translate AresConfig_Fullscreen_Checkbox}"
                                  Margin="0,5"
                                  ToolTip.Tip="{ext:Translate AresConfig_Exclusive_Tooltip}" />
                        <Grid ColumnDefinitions="*,*" Margin="0,5,0,5">
                            <TextBlock Text="{ext:Translate AresConfig_Shader_Label}" Classes="form-label" />
                            <ComboBox Grid.Column="1" IsEditable="True"
                                      ItemsSource="{Binding ShaderOptions}"
                                      Text="{Binding Shader}"
                                      AutomationProperties.Name="{ext:Translate AresConfig_Shader_Tooltip}"
                                      ToolTip.Tip="{ext:Translate AresConfig_Shader_Tooltip}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,*" Margin="0,5,0,5">
                            <TextBlock Text="{ext:Translate AresConfig_Multiplier_Label}" Classes="form-label" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding MultiplierOptions}"
                                      SelectedItem="{Binding Multiplier}"
                                      AutomationProperties.Name="{ext:Translate AresConfig_Multiplier_Tooltip}"
                                      ToolTip.Tip="{ext:Translate AresConfig_Multiplier_Tooltip}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,*" Margin="0,5,0,5">
                            <TextBlock Text="{ext:Translate AresConfig_AspectCorrection_Label}" Classes="form-label" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding AspectCorrectionOptions}"
                                      SelectedItem="{Binding AspectCorrection}"
                                      AutomationProperties.Name="{ext:Translate AresConfig_AspectCorrection_Tooltip}"
                                      ToolTip.Tip="{ext:Translate AresConfig_AspectCorrection_Tooltip}" />
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <!-- Audio Section -->
                <GroupBox Header="{ext:Translate AresConfig_Audio_Header}" Margin="0,0,0,10">
                    <StackPanel Margin="5">
                        <CheckBox IsChecked="{Binding Mute}"
                                  Content="{ext:Translate AresConfig_Mute_Checkbox}"
                                  Margin="0,5"
                                  ToolTip.Tip="{ext:Translate AresConfig_Mute_Tooltip}" />
                        <TextBlock Text="{ext:Translate AresConfig_Volume_Label}" Classes="form-label" />
                        <Slider Value="{Binding Volume}"
                                Minimum="0.0" Maximum="2.0"
                                IsSnapToTickEnabled="True" TickFrequency="0.1"
                                AutomationProperties.Name="{ext:Translate AresConfig_Volume_Tooltip}"
                                ToolTip.Tip="{ext:Translate AresConfig_Volume_Tooltip}" />
                    </StackPanel>
                </GroupBox>

                <!-- General Section -->
                <GroupBox Header="{ext:Translate AresConfig_General_Header}" Margin="0,0,0,10">
                    <StackPanel Margin="5">
                        <CheckBox IsChecked="{Binding FastBoot}"
                                  Content="{ext:Translate AresConfig_FastBoot_Checkbox}"
                                  Margin="0,5"
                                  ToolTip.Tip="{ext:Translate AresConfig_FastBoot_Tooltip}" />
                        <CheckBox IsChecked="{Binding Rewind}"
                                  Content="{ext:Translate AresConfig_Rewind_Checkbox}"
                                  Margin="0,5"
                                  ToolTip.Tip="{ext:Translate AresConfig_TimeMachine_Tooltip}" />
                        <CheckBox IsChecked="{Binding RunAhead}"
                                  Content="{ext:Translate AresConfig_RunAhead_Checkbox}"
                                  Margin="0,5"
                                  ToolTip.Tip="{ext:Translate AresConfig_RunAhead_Tooltip}" />
                        <CheckBox IsChecked="{Binding AutoSaveMemory}"
                                  Content="{ext:Translate AresConfig_AutoSaveMemory_Checkbox}"
                                  Margin="0,5"
                                  ToolTip.Tip="{ext:Translate AresConfig_AutoSaveMemory_Tooltip}" />
                    </StackPanel>
                </GroupBox>

                <!-- CRITICAL SETTING -->
                <Border Classes="important-setting">
                    <StackPanel>
                        <TextBlock Text="{ext:Translate IMPORTANTSETTING}" Classes="important-setting-header" />
                        <CheckBox IsChecked="{Binding ShowBeforeLaunch}"
                                  Content="{ext:Translate AresConfig_ShowBeforeLaunch_Checkbox}"
                                  ToolTip.Tip="{ext:Translate AresConfig_ShowBeforeLaunch_Tooltip}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="BtnSave"
                    Content="{ext:Translate AresConfig_Save_Button}"
                    Classes="secondary"
                    Command="{Binding SaveCommand}"
                    AutomationProperties.Name="{ext:Translate AresConfig_Save_Tooltip}"
                    ToolTip.Tip="{ext:Translate AresConfig_Save_Tooltip}" />
            <Button Content="{ext:Translate AresConfig_Run_Button2}"
                    Classes="primary"
                    Command="{Binding RunCommand}"
                    IsDefault="True"
                    IsVisible="{Binding IsLauncherMode, Converter={StaticResource BoolToVisibility}}"
                    AutomationProperties.Name="{ext:Translate AresConfig_Run_Tooltip}"
                    ToolTip.Tip="{ext:Translate AresConfig_Run_Tooltip}" />
            <Button Content="{ext:Translate AresConfig_Cancel_Button}"
                    Classes="secondary"
                    Command="{Binding CancelCommand}"
                    AutomationProperties.Name="{ext:Translate AresConfig_Cancel_Tooltip}"
                    ToolTip.Tip="{ext:Translate AresConfig_Cancel_Tooltip}" />
        </StackPanel>
    </Grid>
</Window>