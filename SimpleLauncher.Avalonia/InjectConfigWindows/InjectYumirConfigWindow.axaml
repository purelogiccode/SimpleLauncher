<Window x:Class="SimpleLauncher.Avalonia.InjectConfigWindows.InjectYumirConfigWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:ext="using:SimpleLauncher.Avalonia.Extensions"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{ext:Translate YumirConfig_Title}"
        Height="650" Width="700"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgPrimaryBrush}">

    <Grid Margin="10" RowDefinitions="*,Auto">

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Video Section -->
                <GroupBox Header="{ext:Translate YumirConfig_Video_Header}" Margin="0,0,0,10">
                    <StackPanel Margin="5">
                        <CheckBox IsChecked="{Binding YumirFullscreen}"
                                  Content="{ext:Translate YumirConfig_Fullscreen_Checkbox}"
                                  Margin="0,5"
                                  ToolTip.Tip="{ext:Translate YumirConfig_Fullscreen_Tooltip}" />
                        <CheckBox IsChecked="{Binding YumirForceAspectRatio}"
                                  Content="{ext:Translate YumirConfig_ForceAspect_Checkbox}"
                                  Margin="0,5"
                                  ToolTip.Tip="{ext:Translate YumirConfig_ForceAspect_Tooltip}" />
                        <CheckBox IsChecked="{Binding YumirReduceLatency}"
                                  Content="{ext:Translate YumirConfig_ReduceLatency_Checkbox}"
                                  Margin="0,5"
                                  ToolTip.Tip="{ext:Translate YumirConfig_ReduceLatency_Tooltip}" />

                        <Grid Margin="0,5" ColumnDefinitions="*,*">
                            <TextBlock Text="{ext:Translate YumirConfig_ForcedAspect_Label}" Classes="form-label"
                                       VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding ForcedAspectOptions}"
                                      SelectedItem="{Binding YumirForcedAspect}"
                                      AutomationProperties.Name="{ext:Translate YumirConfig_ForcedAspect_Tooltip}"
                                      ToolTip.Tip="{ext:Translate YumirConfig_ForcedAspect_Tooltip}" />
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <!-- Audio Section -->
                <GroupBox Header="{ext:Translate YumirConfig_Audio_Header}" Margin="0,0,0,10">
                    <StackPanel Margin="5">
                        <CheckBox IsChecked="{Binding YumirMute}"
                                  Content="{ext:Translate YumirConfig_Mute_Checkbox}"
                                  Margin="0,5"
                                  ToolTip.Tip="{ext:Translate YumirConfig_Mute_Tooltip}" />
                        <TextBlock Text="{ext:Translate YumirConfig_Volume_Label}" Classes="form-label"
                                   VerticalAlignment="Center" />
                        <Slider Value="{Binding YumirVolume}" Minimum="0.0" Maximum="1.0" IsSnapToTickEnabled="True"
                                TickFrequency="0.05"
                                AutomationProperties.Name="{ext:Translate YumirConfig_Volume_Tooltip}"
                                ToolTip.Tip="{ext:Translate YumirConfig_Volume_Tooltip}" />
                    </StackPanel>
                </GroupBox>

                <!-- System Section -->
                <GroupBox Header="{ext:Translate YumirConfig_System_Header}" Margin="0,0,0,10">
                    <StackPanel Margin="5">
                        <CheckBox IsChecked="{Binding YumirAutoDetectRegion}"
                                  Content="{ext:Translate YumirConfig_AutoRegion_Checkbox}"
                                  Margin="0,5"
                                  ToolTip.Tip="{ext:Translate YumirConfig_AutoRegion_Tooltip}" />
                        <Grid Margin="0,5" ColumnDefinitions="*,*">
                            <TextBlock Text="{ext:Translate YumirConfig_VideoStandard_Label}" Classes="form-label"
                                       VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding VideoStandardOptions}"
                                      SelectedItem="{Binding YumirVideoStandard}"
                                      AutomationProperties.Name="{ext:Translate YumirConfig_VideoStandard_Tooltip}"
                                      ToolTip.Tip="{ext:Translate YumirConfig_VideoStandard_Tooltip}" />
                        </Grid>
                        <CheckBox IsChecked="{Binding YumirPauseWhenUnfocused}"
                                  Content="{ext:Translate YumirConfig_PauseUnfocused_Checkbox}"
                                  Margin="0,5"
                                  ToolTip.Tip="{ext:Translate YumirConfig_PauseUnfocused_Tooltip}" />
                    </StackPanel>
                </GroupBox>

                <!-- CRITICAL SETTING -->
                <Border Classes="important-setting">
                    <StackPanel>
                        <TextBlock Text="{ext:Translate IMPORTANTSETTING}" Classes="important-setting-header" />
                        <CheckBox IsChecked="{Binding YumirShowSettingsBeforeLaunch}"
                                  Content="{ext:Translate YumirConfig_ShowBeforeLaunch_Checkbox}"
                                  ToolTip.Tip="{ext:Translate YumirConfig_ShowBeforeLaunch_Tooltip}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="BtnSave" Content="{ext:Translate YumirConfig_Save_Button}"
                    Classes="secondary"
                    Command="{Binding SaveCommand}"
                    AutomationProperties.Name="{ext:Translate YumirConfig_Save_Tooltip}"
                    ToolTip.Tip="{ext:Translate YumirConfig_Save_Tooltip}" />
            <Button Content="{ext:Translate YumirConfig_Run_Button2}"
                    Classes="primary"
                    Command="{Binding RunCommand}"
                    IsDefault="True"
                    IsVisible="{Binding IsLauncherMode, Converter={StaticResource BoolToVisibility}}"
                    AutomationProperties.Name="{ext:Translate YumirConfig_Run_Tooltip}"
                    ToolTip.Tip="{ext:Translate YumirConfig_Run_Tooltip}" />
            <Button Content="{ext:Translate YumirConfig_Cancel_Button}"
                    Classes="secondary"
                    Command="{Binding CancelCommand}"
                    AutomationProperties.Name="{ext:Translate YumirConfig_Cancel_Tooltip}"
                    ToolTip.Tip="{ext:Translate YumirConfig_Cancel_Tooltip}" />
        </StackPanel>
    </Grid>
</Window>