<Window x:Class="SimpleLauncher.Avalonia.InjectConfigWindows.InjectMesenConfigWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:ext="using:SimpleLauncher.Avalonia.Extensions"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{ext:Translate MesenConfig_Title}"
        Height="700" Width="700"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgPrimaryBrush}">

    <Grid Margin="10" RowDefinitions="*,Auto">

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Video Section -->
                <GroupBox Header="{ext:Translate MesenConfig_Video_Header}" Margin="0,0,0,10">
                    <StackPanel Margin="5">
                        <CheckBox IsChecked="{Binding Fullscreen}"
                                  Content="{ext:Translate MesenConfig_Fullscreen_Checkbox}"
                                  Margin="0,5"
                                  ToolTip.Tip="{ext:Translate MesenConfig_Fullscreen_Tooltip}" />
                        <CheckBox IsChecked="{Binding Vsync}"
                                  Content="{ext:Translate MesenConfig_Vsync_Checkbox}"
                                  Margin="0,5"
                                  ToolTip.Tip="{ext:Translate MesenConfig_Vsync_Tooltip}" />
                        <CheckBox IsChecked="{Binding Bilinear}"
                                  Content="{ext:Translate MesenConfig_Bilinear_Checkbox}"
                                  Margin="0,5"
                                  ToolTip.Tip="{ext:Translate MesenConfig_Bilinear_Tooltip}" />
                        <Grid ColumnDefinitions="*,*" Margin="0,5,0,5">
                            <TextBlock Text="{ext:Translate MesenConfig_AspectRatio_Label}" Classes="form-label"
                                       VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding AspectRatioOptions}"
                                      SelectedItem="{Binding AspectRatio}"
                                      AutomationProperties.Name="{ext:Translate MesenConfig_AspectRatio_Tooltip}"
                                      ToolTip.Tip="{ext:Translate MesenConfig_AspectRatio_Tooltip}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,*" Margin="0,5,0,5">
                            <TextBlock Text="{ext:Translate MesenConfig_VideoFilter_Label}" Classes="form-label"
                                       VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding VideoFilterOptions}"
                                      SelectedItem="{Binding VideoFilter}"
                                      AutomationProperties.Name="{ext:Translate MesenConfig_VideoFilter_Tooltip}"
                                      ToolTip.Tip="{ext:Translate MesenConfig_VideoFilter_Tooltip}" />
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <!-- Audio Section -->
                <GroupBox Header="{ext:Translate MesenConfig_Audio_Header}" Margin="0,0,0,10">
                    <StackPanel Margin="5">
                        <CheckBox IsChecked="{Binding EnableAudio}"
                                  Content="{ext:Translate MesenConfig_AudioEnabled_Checkbox}"
                                  Margin="0,5"
                                  ToolTip.Tip="{ext:Translate MesenConfig_EnableAudio_Tooltip}" />
                        <TextBlock Text="{ext:Translate MesenConfig_MasterVolume_Label}" Classes="form-label"
                                   VerticalAlignment="Center" />
                        <Slider Value="{Binding MasterVolume}"
                                Minimum="0"
                                Maximum="100"
                                IsSnapToTickEnabled="True"
                                TickFrequency="1"
                                AutomationProperties.Name="{ext:Translate MesenConfig_MasterVolume_Tooltip}"
                                ToolTip.Tip="{ext:Translate MesenConfig_MasterVolume_Tooltip}" />
                    </StackPanel>
                </GroupBox>

                <!-- Performance & Features Section -->
                <GroupBox Header="{ext:Translate MesenConfig_Performance_Header}" Margin="0,0,0,10">
                    <StackPanel Margin="5">
                        <CheckBox IsChecked="{Binding Rewind}"
                                  Content="{ext:Translate MesenConfig_Rewind_Checkbox}"
                                  Margin="0,5"
                                  ToolTip.Tip="{ext:Translate MesenConfig_TimeMachine_Tooltip}" />
                        <CheckBox IsChecked="{Binding PauseInBackground}"
                                  Content="{ext:Translate MesenConfig_PauseInBackground_Checkbox}"
                                  Margin="0,5"
                                  ToolTip.Tip="{ext:Translate MesenConfig_PauseInBackground_Tooltip}" />
                        <TextBlock Text="{ext:Translate MesenConfig_RunAhead_Label}" Classes="form-label"
                                   VerticalAlignment="Center" />
                        <Slider Value="{Binding RunAhead}"
                                Minimum="0"
                                Maximum="8"
                                IsSnapToTickEnabled="True"
                                TickFrequency="1"
                                AutomationProperties.Name="{ext:Translate MesenConfig_RunAhead_Tooltip}"
                                ToolTip.Tip="{ext:Translate MesenConfig_RunAhead_Tooltip}" />
                    </StackPanel>
                </GroupBox>

                <!-- CRITICAL SETTING -->
                <Border Classes="important-setting">
                    <StackPanel>
                        <TextBlock Text="{ext:Translate IMPORTANTSETTING}" Classes="important-setting-header" />
                        <CheckBox IsChecked="{Binding ShowBeforeLaunch}"
                                  Content="{ext:Translate MesenConfig_ShowBeforeLaunch_Checkbox}"
                                  ToolTip.Tip="{ext:Translate MesenConfig_ShowBeforeLaunch_Tooltip}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="BtnSave"
                    Content="{ext:Translate MesenConfig_Save_Button}"
                    Classes="secondary"
                    Command="{Binding SaveCommand}"
                    AutomationProperties.Name="{ext:Translate MesenConfig_Save_Tooltip}"
                    ToolTip.Tip="{ext:Translate MesenConfig_Save_Tooltip}" />
            <Button Content="{ext:Translate MesenConfig_Run_Button2}"
                    Classes="primary"
                    Command="{Binding RunCommand}"
                    IsDefault="True"
                    IsVisible="{Binding IsLauncherMode, Converter={StaticResource BoolToVisibility}}"
                    AutomationProperties.Name="{ext:Translate MesenConfig_Run_Tooltip}"
                    ToolTip.Tip="{ext:Translate MesenConfig_Run_Tooltip}" />
            <Button Content="{ext:Translate MesenConfig_Cancel_Button}"
                    Classes="secondary"
                    Command="{Binding CancelCommand}"
                    AutomationProperties.Name="{ext:Translate MesenConfig_Cancel_Tooltip}"
                    ToolTip.Tip="{ext:Translate MesenConfig_Cancel_Tooltip}" />
        </StackPanel>
    </Grid>
</Window>