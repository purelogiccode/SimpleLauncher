<Window x:Class="SimpleLauncher.Avalonia.InjectConfigWindows.InjectXeniaConfigWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:ext="using:SimpleLauncher.Avalonia.Extensions"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="using:SimpleLauncher.Core.Models"
        Title="{ext:Translate XeniaConfig_Title}"
        Height="850" Width="700"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgPrimaryBrush}">

    <Grid Margin="10" RowDefinitions="*,Auto">

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- GPU Section -->
                <GroupBox Header="{ext:Translate XeniaConfig_Gpu_Header}" Margin="0,0,0,10">
                    <StackPanel Margin="5">
                        <Grid ColumnDefinitions="*,*" Margin="0,0,0,5">
                            <TextBlock Text="{ext:Translate XeniaConfig_GpuApi_Label}" Classes="form-label"
                                       VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding GpuOptions}"
                                      SelectedItem="{Binding XeniaGpu}"
                                      AutomationProperties.Name="{ext:Translate XeniaConfig_GpuApi_Tooltip}"
                                      ToolTip.Tip="{ext:Translate XeniaConfig_GpuApi_Tooltip}" />
                        </Grid>

                        <CheckBox IsChecked="{Binding XeniaVsync}"
                                  Content="{ext:Translate XeniaConfig_Vsync_Checkbox}"
                                  Margin="0,5"
                                  ToolTip.Tip="{ext:Translate XeniaConfig_Vsync_Tooltip}" />
                        <CheckBox IsChecked="{Binding XeniaFullscreen}"
                                  Content="{ext:Translate XeniaConfig_Fullscreen_Checkbox}"
                                  Margin="0,5"
                                  ToolTip.Tip="{ext:Translate XeniaConfig_Fullscreen_Tooltip}" />

                        <TextBlock Text="{ext:Translate XeniaConfig_ResolutionScale_Label}"
                                   Classes="form-label"
                                   Margin="0,5,0,0"
                                   ToolTip.Tip="{ext:Translate XeniaConfig_ResolutionScale_Tooltip}" />
                        <Grid ColumnDefinitions="*,Auto,*">
                            <ComboBox Grid.Column="0"
                                      ItemsSource="{Binding ResScaleOptions}"
                                      Text="{Binding XeniaResScaleX}"
                                      AutomationProperties.Name="{ext:Translate XeniaConfig_ResolutionScaleX_Tooltip}"
                                      ToolTip.Tip="{ext:Translate XeniaConfig_ResolutionScaleX_Tooltip}" />
                            <TextBlock Text="x" Grid.Column="1" VerticalAlignment="Center" Margin="10,0" />
                            <ComboBox Grid.Column="2"
                                      ItemsSource="{Binding ResScaleOptions}"
                                      Text="{Binding XeniaResScaleY}"
                                      AutomationProperties.Name="{ext:Translate XeniaConfig_ResolutionScaleY_Tooltip}"
                                      ToolTip.Tip="{ext:Translate XeniaConfig_ResolutionScaleY_Tooltip}" />
                        </Grid>

                        <TextBlock Text="{ext:Translate XeniaConfig_PostProcessingAa_Label}" Classes="form-label"
                                   Margin="0,5,0,0" />
                        <ComboBox ItemsSource="{Binding AaOptions}"
                                  SelectedValue="{Binding XeniaAa}"
                                  SelectedValueBinding="{Binding Tag}"
                                      AutomationProperties.Name="{ext:Translate XeniaConfig_PostProcessingAa_Tooltip}"
                                      ToolTip.Tip="{ext:Translate XeniaConfig_PostProcessingAa_Tooltip}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="models:TagOption">
                                    <TextBlock Text="{Binding Display}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock Text="{ext:Translate XeniaConfig_ScalingSharpening_Label}" Classes="form-label"
                                   Margin="0,5,0,0" />
                        <ComboBox ItemsSource="{Binding ScalingOptions}"
                                  SelectedItem="{Binding XeniaScaling}"
                                  AutomationProperties.Name="{ext:Translate XeniaConfig_ScalingSharpening_Tooltip}"
                                  ToolTip.Tip="{ext:Translate XeniaConfig_ScalingSharpening_Tooltip}" />

                        <TextBlock Text="{ext:Translate XeniaConfig_ReadbackResolve_Label}" Classes="form-label"
                                   Margin="0,5,0,0" />
                        <ComboBox ItemsSource="{Binding ReadbackOptions}"
                                  SelectedItem="{Binding XeniaReadbackResolve}"
                                  AutomationProperties.Name="{ext:Translate XeniaConfig_ReadbackResolve_Tooltip}"
                                  ToolTip.Tip="{ext:Translate XeniaConfig_ReadbackResolve_Tooltip}" />

                        <CheckBox IsChecked="{Binding XeniaGammaSrgb}"
                                  Content="{ext:Translate XeniaConfig_GammaSrgb_Checkbox}"
                                  Margin="0,5"
                                  ToolTip.Tip="{ext:Translate XeniaConfig_GammaSrgb_Tooltip}" />

                    </StackPanel>
                </GroupBox>

                <!-- Audio Section -->
                <GroupBox Header="{ext:Translate XeniaConfig_Apu_Header}" Margin="0,0,0,10">
                    <StackPanel Margin="5">
                        <Grid ColumnDefinitions="*,*" Margin="0,0,0,5">
                            <TextBlock Text="{ext:Translate XeniaConfig_AudioDriver_Label}" Classes="form-label"
                                       VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding ApuOptions}"
                                      SelectedItem="{Binding XeniaApu}"
                                      AutomationProperties.Name="{ext:Translate XeniaConfig_AudioDriver_Tooltip}"
                                      ToolTip.Tip="{ext:Translate XeniaConfig_AudioDriver_Tooltip}" />
                        </Grid>
                        <CheckBox IsChecked="{Binding XeniaMute}"
                                  Content="{ext:Translate XeniaConfig_Mute_Checkbox}"
                                  Margin="0,5"
                                  ToolTip.Tip="{ext:Translate XeniaConfig_MuteAudio_Tooltip}" />
                    </StackPanel>
                </GroupBox>

                <!-- System Section -->
                <GroupBox Header="{ext:Translate XeniaConfig_SystemInput_Header}" Margin="0,0,0,10">
                    <StackPanel Margin="5">
                        <CheckBox IsChecked="{Binding XeniaApplyPatches}"
                                  Content="{ext:Translate XeniaConfig_ApplyPatches_Checkbox}"
                                  Margin="0,5"
                                  ToolTip.Tip="{ext:Translate XeniaConfig_ApplyPatches_Tooltip}" />
                        <CheckBox IsChecked="{Binding XeniaMountCache}"
                                  Content="{ext:Translate XeniaConfig_MountCache_Checkbox}"
                                  Margin="0,5"
                                  ToolTip.Tip="{ext:Translate XeniaConfig_MountCache_Tooltip}" />
                        <CheckBox IsChecked="{Binding XeniaVibration}"
                                  Content="{ext:Translate XeniaConfig_Vibration_Checkbox}"
                                  Margin="0,5"
                                  ToolTip.Tip="{ext:Translate XeniaConfig_Vibration_Tooltip}" />

                        <Grid ColumnDefinitions="*,*" Margin="0,5,0,0">
                            <TextBlock Text="{ext:Translate XeniaConfig_Hid_Label}" Classes="form-label"
                                       VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding HidOptions}"
                                      SelectedItem="{Binding XeniaHid}"
                                      AutomationProperties.Name="{ext:Translate XeniaConfig_Hid_Tooltip}"
                                      ToolTip.Tip="{ext:Translate XeniaConfig_Hid_Tooltip}" />
                        </Grid>

                        <Grid ColumnDefinitions="*,*" Margin="0,5,0,0">
                            <TextBlock Text="{ext:Translate XeniaConfig_UserLanguage_Label}" Classes="form-label"
                                       VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding LangOptions}"
                                      SelectedValue="{Binding XeniaUserLanguage}"
                                      SelectedValueBinding="{Binding Tag}"
                                      AutomationProperties.Name="{ext:Translate XeniaConfig_UserLanguage_Tooltip}"
                                      ToolTip.Tip="{ext:Translate XeniaConfig_UserLanguage_Tooltip}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:TagOption">
                                        <TextBlock Text="{Binding Display}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <!-- CRITICAL SETTING -->
                <Border Classes="important-setting">
                    <StackPanel>
                        <TextBlock Text="{ext:Translate IMPORTANTSETTING}" Classes="important-setting-header" />
                        <CheckBox IsChecked="{Binding XeniaShowSettingsBeforeLaunch}"
                                  Content="{ext:Translate XeniaConfig_ShowBeforeLaunch_Checkbox}"
                                  ToolTip.Tip="{ext:Translate XeniaConfig_ShowBeforeLaunch_Tooltip}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="BtnSave"
                    Content="{ext:Translate XeniaConfig_Save_Button}"
                    Classes="secondary"
                    Command="{Binding SaveCommand}"
                    AutomationProperties.Name="{ext:Translate XeniaConfig_Save_Tooltip}"
                    ToolTip.Tip="{ext:Translate XeniaConfig_Save_Tooltip}" />
            <Button Content="{ext:Translate XeniaConfig_Run_Button2}"
                    Classes="primary"
                    Command="{Binding RunCommand}"
                    IsDefault="True"
                    IsVisible="{Binding IsLauncherMode, Converter={StaticResource BoolToVisibility}}"
                    AutomationProperties.Name="{ext:Translate XeniaConfig_Run_Tooltip}"
                    ToolTip.Tip="{ext:Translate XeniaConfig_Run_Tooltip}" />
            <Button Content="{ext:Translate XeniaConfig_Cancel_Button}"
                    Classes="secondary"
                    Command="{Binding CancelCommand}"
                    AutomationProperties.Name="{ext:Translate XeniaConfig_Cancel_Tooltip}"
                    ToolTip.Tip="{ext:Translate XeniaConfig_Cancel_Tooltip}" />
        </StackPanel>
    </Grid>
</Window>