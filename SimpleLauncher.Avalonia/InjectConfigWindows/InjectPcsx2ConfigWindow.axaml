<Window x:Class="SimpleLauncher.Avalonia.InjectConfigWindows.InjectPcsx2ConfigWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:ext="using:SimpleLauncher.Avalonia.Extensions"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{ext:Translate Pcsx2Config_Title}"
        Height="700" Width="700"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgPrimaryBrush}">

    <Grid Margin="10" RowDefinitions="*,Auto">

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Video Section -->
                <GroupBox Header="{ext:Translate Pcsx2Config_Video_Header}" Margin="0,0,0,10">
                    <StackPanel Margin="5">
                        <Grid ColumnDefinitions="*,*" Margin="0,0,0,5">
                            <TextBlock Text="{ext:Translate Pcsx2Config_Renderer_Label}" Classes="form-label" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding RendererDisplayNames}"
                                      SelectedItem="{Binding Pcsx2Renderer}"
                                      AutomationProperties.Name="{ext:Translate Pcsx2Config_Renderer_Tooltip}"
                                      ToolTip.Tip="{ext:Translate Pcsx2Config_Renderer_Tooltip}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,*" Margin="0,5">
                            <TextBlock Text="{ext:Translate Pcsx2Config_Upscale_Label}" Classes="form-label" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding UpscaleDisplayNames}"
                                      SelectedItem="{Binding Pcsx2UpscaleMultiplier}"
                                      AutomationProperties.Name="{ext:Translate Pcsx2Config_Upscale_Tooltip}"
                                      ToolTip.Tip="{ext:Translate Pcsx2Config_Upscale_Tooltip}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,*" Margin="0,5">
                            <TextBlock Text="{ext:Translate Pcsx2Config_AspectRatio_Label}" Classes="form-label" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding AspectOptions}"
                                      SelectedItem="{Binding Pcsx2AspectRatio}"
                                      AutomationProperties.Name="{ext:Translate Pcsx2Config_Aspect_Tooltip}"
                                      ToolTip.Tip="{ext:Translate Pcsx2Config_Aspect_Tooltip}" />
                        </Grid>
                        <CheckBox IsChecked="{Binding Pcsx2Vsync}"
                                  Content="{ext:Translate Pcsx2Config_Vsync_Checkbox}"
                                  Margin="0,5"
                                  ToolTip.Tip="{ext:Translate Pcsx2Config_Vsync_Tooltip}" />
                        <CheckBox IsChecked="{Binding Pcsx2EnableWidescreenPatches}"
                                  Content="{ext:Translate Pcsx2Config_WidescreenPatches_Checkbox}"
                                  Margin="0,5"
                                  ToolTip.Tip="{ext:Translate Pcsx2Config_WidescreenPatches_Tooltip}" />
                    </StackPanel>
                </GroupBox>

                <!-- General Section -->
                <GroupBox Header="{ext:Translate Pcsx2Config_General_Header}" Margin="0,0,0,10">
                    <StackPanel Margin="5">
                        <CheckBox IsChecked="{Binding Pcsx2StartFullscreen}"
                                  Content="{ext:Translate Pcsx2Config_Fullscreen_Checkbox}"
                                  Margin="0,5"
                                  ToolTip.Tip="{ext:Translate Pcsx2Config_Fullscreen_Tooltip}" />
                        <CheckBox IsChecked="{Binding Pcsx2EnableCheats}"
                                  Content="{ext:Translate Pcsx2Config_Cheats_Checkbox}"
                                  Margin="0,5"
                                  ToolTip.Tip="{ext:Translate Pcsx2Config_Cheats_Tooltip}" />
                        <TextBlock Text="{ext:Translate Pcsx2Config_AudioVolume_Label}" Classes="form-label" />
                        <Slider Value="{Binding Pcsx2Volume}"
                                Minimum="0" Maximum="100"
                                IsSnapToTickEnabled="True" TickFrequency="1"
                                AutomationProperties.Name="{ext:Translate Pcsx2Config_Volume_Tooltip}"
                                ToolTip.Tip="{ext:Translate Pcsx2Config_Volume_Tooltip}" />
                    </StackPanel>
                </GroupBox>

                <!-- Achievements Section -->
                <GroupBox Header="{ext:Translate Pcsx2Config_RetroAchievements_Header}" Margin="0,0,0,10">
                    <StackPanel Margin="5">
                        <CheckBox IsChecked="{Binding Pcsx2AchievementsEnabled}"
                                  Content="{ext:Translate Pcsx2Config_AchEnabled_Checkbox}"
                                  Margin="0,5"
                                  ToolTip.Tip="{ext:Translate Pcsx2Config_AchEnabled_Tooltip}" />
                        <CheckBox IsChecked="{Binding Pcsx2AchievementsHardcore}"
                                  Content="{ext:Translate Pcsx2Config_HardcoreMode_Checkbox}"
                                  Margin="0,5"
                                  ToolTip.Tip="{ext:Translate Pcsx2Config_AchHardcore_Tooltip}" />
                    </StackPanel>
                </GroupBox>

                <!-- CRITICAL SETTING -->
                <Border Classes="important-setting">
                    <StackPanel>
                        <TextBlock Text="{ext:Translate IMPORTANTSETTING}" Classes="important-setting-header" />
                        <CheckBox IsChecked="{Binding Pcsx2ShowSettingsBeforeLaunch}"
                                  Content="{ext:Translate Pcsx2Config_ShowBeforeLaunch_Checkbox}"
                                  ToolTip.Tip="{ext:Translate Pcsx2Config_ShowBeforeLaunch_Tooltip}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="BtnSave"
                    Content="{ext:Translate Pcsx2Config_Save_Button}"
                    Classes="secondary"
                    Command="{Binding SaveCommand}"
                    AutomationProperties.Name="{ext:Translate Pcsx2Config_Save_Tooltip}"
                    ToolTip.Tip="{ext:Translate Pcsx2Config_Save_Tooltip}" />
            <Button Content="{ext:Translate Pcsx2Config_Run_Button2}"
                    Classes="primary"
                    Command="{Binding RunCommand}"
                    IsDefault="True"
                    IsVisible="{Binding IsLauncherMode, Converter={StaticResource BoolToVisibility}}"
                    AutomationProperties.Name="{ext:Translate Pcsx2Config_Run_Tooltip}"
                    ToolTip.Tip="{ext:Translate Pcsx2Config_Run_Tooltip}" />
            <Button Content="{ext:Translate Pcsx2Config_Cancel_Button}"
                    Classes="secondary"
                    Command="{Binding CancelCommand}"
                    AutomationProperties.Name="{ext:Translate Pcsx2Config_Cancel_Tooltip}"
                    ToolTip.Tip="{ext:Translate Pcsx2Config_Cancel_Tooltip}" />
        </StackPanel>
    </Grid>
</Window>