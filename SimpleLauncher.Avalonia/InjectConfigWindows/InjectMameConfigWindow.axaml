<Window x:Class="SimpleLauncher.Avalonia.InjectConfigWindows.InjectMameConfigWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:ext="using:SimpleLauncher.Avalonia.Extensions"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{ext:Translate MameConfig_Title}"
        Height="600" Width="700"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgPrimaryBrush}">

    <Grid Margin="10" RowDefinitions="*,Auto">

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Video Section -->
                <GroupBox Header="{ext:Translate MameConfig_VideoDisplay_Header}" Margin="0,0,0,10">
                    <StackPanel Margin="5">
                        <Grid ColumnDefinitions="*,*" Margin="0,0,0,5">
                            <TextBlock Text="{ext:Translate MameConfig_VideoMode_Label}" Classes="form-label" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding VideoOptions}"
                                      SelectedItem="{Binding MameVideo}"
                                      AutomationProperties.Name="{ext:Translate MameConfig_VideoMode_Tooltip}"
                                      ToolTip.Tip="{ext:Translate MameConfig_VideoMode_Tooltip}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,*" Margin="0,0,0,5">
                            <TextBlock Text="{ext:Translate MameConfig_BgfxBackend_Label}" Classes="form-label" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding BgfxBackendOptions}"
                                      SelectedItem="{Binding MameBgfxBackend}"
                                      AutomationProperties.Name="{ext:Translate MameConfig_BgfxBackend_Tooltip}"
                                      ToolTip.Tip="{ext:Translate MameConfig_BgfxBackend_Tooltip}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,*" Margin="0,0,0,5">
                            <TextBlock Text="{ext:Translate MameConfig_BgfxShader_Label}" Classes="form-label" />
                            <ComboBox Grid.Column="1" IsEditable="True"
                                      ItemsSource="{Binding BgfxChainsOptions}"
                                      Text="{Binding MameBgfxScreenChains}"
                                      AutomationProperties.Name="{ext:Translate MameConfig_BgfxShader_Tooltip}"
                                      ToolTip.Tip="{ext:Translate MameConfig_BgfxShader_Tooltip}" />
                        </Grid>
                        <CheckBox IsChecked="{Binding MameFilter}"
                                  Content="{ext:Translate MameConfig_Bilinear_Checkbox}"
                                  Margin="0,5"
                                  ToolTip.Tip="{ext:Translate MameConfig_BilinearFiltering_Tooltip}" />
                        <CheckBox IsChecked="{Binding MameWindow}"
                                  Content="{ext:Translate MameConfig_RunInWindow_Checkbox}"
                                  Margin="0,5"
                                  ToolTip.Tip="{ext:Translate MameConfig_RunInWindow_Tooltip}" />
                        <CheckBox IsChecked="{Binding MameMaximize}"
                                  Content="{ext:Translate MameConfig_Maximize_Checkbox}"
                                  Margin="0,5"
                                  ToolTip.Tip="{ext:Translate MameConfig_Maximize_Tooltip}" />
                        <CheckBox IsChecked="{Binding MameKeepAspect}"
                                  Content="{ext:Translate MameConfig_EnforceAspectRatio_Checkbox}"
                                  Margin="0,5"
                                  ToolTip.Tip="{ext:Translate MameConfig_EnforceAspectRatio_Tooltip}" />
                    </StackPanel>
                </GroupBox>

                <!-- Performance and Advanced Section -->
                <GroupBox Header="{ext:Translate MameConfig_PerformanceAdvanced_Header}" Margin="0,0,0,10">
                    <StackPanel Margin="5">
                        <CheckBox IsChecked="{Binding MameAutoframeskip}"
                                  Content="{ext:Translate MameConfig_AutoFrameskip_Checkbox}"
                                  Margin="0,5"
                                  ToolTip.Tip="{ext:Translate MameConfig_AutoFrameskip_Tooltip}" />
                        <CheckBox IsChecked="{Binding MameCheat}"
                                  Content="{ext:Translate MameConfig_Cheats_Checkbox}"
                                  Margin="0,5"
                                  ToolTip.Tip="{ext:Translate MameConfig_EnableCheats_Tooltip}" />
                        <CheckBox IsChecked="{Binding MameRewind}"
                                  Content="{ext:Translate MameConfig_Rewind_Checkbox}"
                                  Margin="0,5"
                                  ToolTip.Tip="{ext:Translate MameConfig_EnableRewind_Tooltip}" />
                        <CheckBox IsChecked="{Binding MameNvramSave}"
                                  Content="{ext:Translate MameConfig_SaveNvram_Checkbox}"
                                  Margin="0,5"
                                  ToolTip.Tip="{ext:Translate MameConfig_SaveNvram_Tooltip}" />
                    </StackPanel>
                </GroupBox>

                <!-- UX Section -->
                <GroupBox Header="{ext:Translate MameConfig_UserExperience_Header}" Margin="0,0,0,10">
                    <StackPanel Margin="5">
                        <CheckBox IsChecked="{Binding MameSkipGameInfo}"
                                  Content="{ext:Translate MameConfig_SkipGameInfo_Checkbox}"
                                  Margin="0,5"
                                  ToolTip.Tip="{ext:Translate MameConfig_SkipGameInfo_Tooltip}" />
                        <CheckBox IsChecked="{Binding MameAutosave}"
                                  Content="{ext:Translate MameConfig_AutosaveState_Checkbox}"
                                  Margin="0,5"
                                  ToolTip.Tip="{ext:Translate MameConfig_AutosaveState_Tooltip}" />
                        <CheckBox IsChecked="{Binding MameConfirmQuit}"
                                  Content="{ext:Translate MameConfig_ConfirmQuit_Checkbox}"
                                  Margin="0,5"
                                  ToolTip.Tip="{ext:Translate MameConfig_ConfirmQuit_Tooltip}" />
                    </StackPanel>
                </GroupBox>

                <!-- Input Section -->
                <GroupBox Header="{ext:Translate MameConfig_Input_Header}" Margin="0,0,0,10">
                    <StackPanel Margin="5">
                        <CheckBox IsChecked="{Binding MameJoystick}"
                                  Content="{ext:Translate MameConfig_EnableJoystick_Checkbox}"
                                  Margin="0,5"
                                  ToolTip.Tip="{ext:Translate MameConfig_EnableJoystick_Tooltip}" />
                    </StackPanel>
                </GroupBox>

                <!-- CRITICAL SETTING -->
                <Border Classes="important-setting">
                    <StackPanel>
                        <TextBlock Text="{ext:Translate IMPORTANTSETTING}" Classes="important-setting-header" />
                        <CheckBox IsChecked="{Binding MameShowSettingsBeforeLaunch}"
                                  Content="{ext:Translate MameConfig_ShowBeforeLaunch_Checkbox}"
                                  ToolTip.Tip="{ext:Translate MameConfig_ShowBeforeLaunch_Tooltip}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="BtnSave" Content="{ext:Translate MameConfig_Save_Button}"
                    Classes="secondary"
                    Command="{Binding SaveCommand}"
                    AutomationProperties.Name="{ext:Translate MameConfig_Save_Tooltip}"
                    ToolTip.Tip="{ext:Translate MameConfig_Save_Tooltip}" />
            <Button Content="{ext:Translate MameConfig_Run_Button2}"
                    Classes="primary"
                    Command="{Binding RunCommand}"
                    IsDefault="True"
                    IsVisible="{Binding IsLauncherMode, Converter={StaticResource BoolToVisibility}}"
                    AutomationProperties.Name="{ext:Translate MameConfig_Run_Tooltip}"
                    ToolTip.Tip="{ext:Translate MameConfig_Run_Tooltip}" />
            <Button Content="{ext:Translate MameConfig_Cancel_Button}"
                    Classes="secondary"
                    Command="{Binding CancelCommand}"
                    AutomationProperties.Name="{ext:Translate MameConfig_Cancel_Tooltip}"
                    ToolTip.Tip="{ext:Translate MameConfig_Cancel_Tooltip}" />
        </StackPanel>
    </Grid>
</Window>