<Window x:Class="SimpleLauncher.Avalonia.InjectConfigWindows.InjectCemuConfigWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:ext="using:SimpleLauncher.Avalonia.Extensions"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{ext:Translate CemuConfig_Title}"
        Height="600" Width="700"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgPrimaryBrush}">

    <Grid Margin="10" RowDefinitions="*,Auto">

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Video Section -->
                <GroupBox Header="{ext:Translate CemuConfig_Video_Header}" Margin="0,0,0,10">
                    <StackPanel Margin="5">
                        <CheckBox IsChecked="{Binding Fullscreen}"
                                  Content="{ext:Translate CemuConfig_Fullscreen_Checkbox}"
                                  Margin="0,5"
                                  ToolTip.Tip="{ext:Translate CemuConfig_Fullscreen_Tooltip}" />

                        <Grid ColumnDefinitions="*,*" Margin="0,5">
                            <TextBlock Text="{ext:Translate CemuConfig_GpuApi_Label}" Classes="form-label" />
                            <ComboBox Grid.Column="1"
                                      SelectedValue="{Binding GraphicApi}"
                                      SelectedValueBinding="{Binding Tag}"
                                      AutomationProperties.Name="{ext:Translate CemuConfig_Api_Tooltip}"
                                      ToolTip.Tip="{ext:Translate CemuConfig_Api_Tooltip}">
                                <ComboBoxItem Content="OpenGL" Tag="0" />
                                <ComboBoxItem Content="Vulkan" Tag="1" />
                            </ComboBox>
                        </Grid>

                        <Grid ColumnDefinitions="*,*" Margin="0,5">
                            <TextBlock Text="{ext:Translate CemuConfig_Vsync_Label}" Classes="form-label" />
                            <ComboBox Grid.Column="1"
                                      SelectedValue="{Binding Vsync}"
                                      SelectedValueBinding="{Binding Tag}"
                                      AutomationProperties.Name="{ext:Translate CemuConfig_Vsync_Tooltip}"
                                      ToolTip.Tip="{ext:Translate CemuConfig_Vsync_Tooltip}">
                                <ComboBoxItem Content="Off" Tag="0" />
                                <ComboBoxItem Content="On" Tag="1" />
                            </ComboBox>
                        </Grid>

                        <CheckBox IsChecked="{Binding AsyncCompile}"
                                  Content="{ext:Translate CemuConfig_AsyncCompile_Checkbox}"
                                  Margin="0,5"
                                  ToolTip.Tip="{ext:Translate CemuConfig_AsyncCompile_Tooltip}" />
                    </StackPanel>
                </GroupBox>

                <!-- Audio Section -->
                <GroupBox Header="{ext:Translate CemuConfig_Audio_Header}" Margin="0,0,0,10">
                    <StackPanel Margin="5">
                        <TextBlock Text="{ext:Translate CemuConfig_Volume_Label}" Classes="form-label" />
                        <Slider Value="{Binding Volume}"
                                Minimum="0" Maximum="100"
                                IsSnapToTickEnabled="True" TickFrequency="1"
                                AutomationProperties.Name="{ext:Translate CemuConfig_Volume_Tooltip}"
                                ToolTip.Tip="{ext:Translate CemuConfig_Volume_Tooltip}" />
                    </StackPanel>
                </GroupBox>

                <!-- General Section -->
                <GroupBox Header="{ext:Translate CemuConfig_General_Header}" Margin="0,0,0,10">
                    <StackPanel Margin="5">
                        <CheckBox IsChecked="{Binding Discord}"
                                  Content="{ext:Translate CemuConfig_Discord_Checkbox}"
                                  Margin="0,5"
                                  ToolTip.Tip="{ext:Translate CemuConfig_Discord_Tooltip}" />
                        <Grid ColumnDefinitions="*,*" Margin="0,5">
                            <TextBlock Text="{ext:Translate CemuConfig_Language_Label}" Classes="form-label" />
                            <ComboBox Grid.Column="1"
                                      SelectedValue="{Binding Language}"
                                      SelectedValueBinding="{Binding Tag}"
                                      AutomationProperties.Name="{ext:Translate CemuConfig_Language_Tooltip}"
                                      ToolTip.Tip="{ext:Translate CemuConfig_Language_Tooltip}">
                                <ComboBoxItem Content="Japanese" Tag="0" />
                                <ComboBoxItem Content="English" Tag="1" />
                                <ComboBoxItem Content="French" Tag="2" />
                                <ComboBoxItem Content="German" Tag="3" />
                                <ComboBoxItem Content="Italian" Tag="4" />
                                <ComboBoxItem Content="Spanish" Tag="5" />
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <!-- CRITICAL SETTING -->
                <Border Classes="important-setting">
                    <StackPanel>
                        <TextBlock Text="{ext:Translate IMPORTANTSETTING}" Classes="important-setting-header" />
                        <CheckBox IsChecked="{Binding ShowBeforeLaunch}"
                                  Content="{ext:Translate CemuConfig_ShowBeforeLaunch_Checkbox}"
                                  ToolTip.Tip="{ext:Translate CemuConfig_ShowBeforeLaunch_Tooltip}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="BtnSave"
                    Content="{ext:Translate CemuConfig_Save_Button}"
                    Classes="secondary"
                    Command="{Binding SaveCommand}"
                    AutomationProperties.Name="{ext:Translate CemuConfig_Save_Tooltip}"
                    ToolTip.Tip="{ext:Translate CemuConfig_Save_Tooltip}" />
            <Button Content="{ext:Translate CemuConfig_Run_Button2}"
                    Classes="primary"
                    Command="{Binding RunCommand}"
                    IsDefault="True"
                    IsVisible="{Binding IsLauncherMode, Converter={StaticResource BoolToVisibility}}"
                    AutomationProperties.Name="{ext:Translate CemuConfig_Run_Tooltip}"
                    ToolTip.Tip="{ext:Translate CemuConfig_Run_Tooltip}" />
            <Button Content="{ext:Translate CemuConfig_Cancel_Button}"
                    Classes="secondary"
                    Command="{Binding CancelCommand}"
                    AutomationProperties.Name="{ext:Translate CemuConfig_Cancel_Tooltip}"
                    ToolTip.Tip="{ext:Translate CemuConfig_Cancel_Tooltip}" />
        </StackPanel>
    </Grid>
</Window>