<Window x:Class="SimpleLauncher.Avalonia.InjectConfigWindows.InjectStellaConfigWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:ext="using:SimpleLauncher.Avalonia.Extensions"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{ext:Translate StellaConfig_Title}"
        Height="700" Width="700"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgPrimaryBrush}">

    <Grid Margin="10" RowDefinitions="*,Auto">

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Video Section -->
                <GroupBox Header="{ext:Translate StellaConfig_Video_Header}" Margin="0,0,0,10">
                    <StackPanel Margin="5">
                        <CheckBox IsChecked="{Binding Fullscreen}"
                                  Content="{ext:Translate StellaConfig_Fullscreen_Checkbox}"
                                  Margin="0,5"
                                  ToolTip.Tip="{ext:Translate StellaConfig_Fullscreen_Tooltip}" />
                        <CheckBox IsChecked="{Binding Vsync}"
                                  Content="{ext:Translate StellaConfig_Vsync_Checkbox}"
                                  Margin="0,5"
                                  ToolTip.Tip="{ext:Translate StellaConfig_Vsync_Tooltip}" />
                        <CheckBox IsChecked="{Binding CorrectAspect}"
                                  Content="{ext:Translate StellaConfig_CorrectAspect_Checkbox}"
                                  Margin="0,5"
                                  ToolTip.Tip="{ext:Translate StellaConfig_CorrectAspect_Tooltip}" />
                        <Grid ColumnDefinitions="*,*" Margin="0,5,0,5">
                            <TextBlock Text="{ext:Translate StellaConfig_VideoDriver_Label}" Classes="form-label"
                                       VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding VideoDriverOptions}"
                                      SelectedItem="{Binding VideoDriver}"
                                      AutomationProperties.Name="{ext:Translate StellaConfig_VideoDriver_Tooltip}"
                                      ToolTip.Tip="{ext:Translate StellaConfig_VideoDriver_Tooltip}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,*" Margin="0,5,0,5">
                            <TextBlock Text="{ext:Translate StellaConfig_TvFilter_Label}" Classes="form-label"
                                       VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding TvFilterOptions}"
                                      SelectedItem="{Binding TvFilter}"
                                      AutomationProperties.Name="{ext:Translate StellaConfig_TvFilter_Tooltip}"
                                      ToolTip.Tip="{ext:Translate StellaConfig_TvFilter_Tooltip}" />
                        </Grid>
                        <TextBlock Text="{ext:Translate StellaConfig_Scanlines_Label}" Classes="form-label"
                                   VerticalAlignment="Center" />
                        <Slider Value="{Binding Scanlines}" Minimum="0" Maximum="100" IsSnapToTickEnabled="True"
                                TickFrequency="1"
                                AutomationProperties.Name="{ext:Translate StellaConfig_Scanlines_Tooltip}"
                                ToolTip.Tip="{ext:Translate StellaConfig_Scanlines_Tooltip}" />
                    </StackPanel>
                </GroupBox>

                <!-- Audio Section -->
                <GroupBox Header="{ext:Translate StellaConfig_Audio_Header}" Margin="0,0,0,10">
                    <StackPanel Margin="5">
                        <CheckBox IsChecked="{Binding AudioEnabled}"
                                  Content="{ext:Translate StellaConfig_AudioEnabled_Checkbox}"
                                  Margin="0,5"
                                  ToolTip.Tip="{ext:Translate StellaConfig_AudioEnabled_Tooltip}" />
                        <TextBlock Text="{ext:Translate StellaConfig_AudioVolume_Label}" Classes="form-label"
                                   VerticalAlignment="Center" />
                        <Slider Value="{Binding AudioVolume}" Minimum="0" Maximum="100" IsSnapToTickEnabled="True"
                                TickFrequency="1"
                                AutomationProperties.Name="{ext:Translate StellaConfig_AudioVolume_Tooltip}"
                                ToolTip.Tip="{ext:Translate StellaConfig_AudioVolume_Tooltip}" />
                    </StackPanel>
                </GroupBox>

                <!-- Features Section -->
                <GroupBox Header="{ext:Translate StellaConfig_Features_Header}" Margin="0,0,0,10">
                    <StackPanel Margin="5">
                        <CheckBox IsChecked="{Binding TimeMachine}"
                                  Content="{ext:Translate StellaConfig_TimeMachine_Checkbox}"
                                  Margin="0,5"
                                  ToolTip.Tip="{ext:Translate StellaConfig_TimeMachine_Tooltip}" />
                        <CheckBox IsChecked="{Binding ConfirmExit}"
                                  Content="{ext:Translate StellaConfig_ConfirmExit_Checkbox}"
                                  Margin="0,5"
                                  ToolTip.Tip="{ext:Translate StellaConfig_ConfirmExit_Tooltip}" />
                    </StackPanel>
                </GroupBox>

                <!-- CRITICAL SETTING -->
                <Border Classes="important-setting">
                    <StackPanel>
                        <TextBlock Text="{ext:Translate IMPORTANTSETTING}" Classes="important-setting-header" />
                        <CheckBox IsChecked="{Binding ShowBeforeLaunch}"
                                  Content="{ext:Translate StellaConfig_ShowBeforeLaunch_Checkbox}"
                                  ToolTip.Tip="{ext:Translate StellaConfig_ShowBeforeLaunch_Tooltip}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="BtnSave" Content="{ext:Translate StellaConfig_Save_Button}"
                    Classes="secondary"
                    Command="{Binding SaveCommand}"
                    AutomationProperties.Name="{ext:Translate StellaConfig_Save_Tooltip}"
                    ToolTip.Tip="{ext:Translate StellaConfig_Save_Tooltip}" />
            <Button Content="{ext:Translate StellaConfig_Run_Button2}"
                    Classes="primary"
                    Command="{Binding RunCommand}"
                    IsDefault="True"
                    IsVisible="{Binding IsLauncherMode, Converter={StaticResource BoolToVisibility}}"
                    AutomationProperties.Name="{ext:Translate StellaConfig_Run_Tooltip}"
                    ToolTip.Tip="{ext:Translate StellaConfig_Run_Tooltip}" />
            <Button Content="{ext:Translate StellaConfig_Cancel_Button}"
                    Classes="secondary"
                    Command="{Binding CancelCommand}"
                    AutomationProperties.Name="{ext:Translate StellaConfig_Cancel_Tooltip}"
                    ToolTip.Tip="{ext:Translate StellaConfig_Cancel_Tooltip}" />
        </StackPanel>
    </Grid>
</Window>