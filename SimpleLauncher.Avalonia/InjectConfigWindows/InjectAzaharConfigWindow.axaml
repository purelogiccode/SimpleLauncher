<Window x:Class="SimpleLauncher.Avalonia.InjectConfigWindows.InjectAzaharConfigWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:ext="using:SimpleLauncher.Avalonia.Extensions"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{ext:Translate AzaharConfig_Title}"
        Height="650" Width="700"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgPrimaryBrush}">

    <Grid Margin="10" RowDefinitions="*,Auto">

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Video Section -->
                <GroupBox Header="{ext:Translate AzaharConfig_Video_Header}">
                    <StackPanel Margin="5">
                        <Grid ColumnDefinitions="*,*" Margin="0,5">
                            <TextBlock Text="{ext:Translate AzaharConfig_GpuApi_Label}" Classes="form-label" />
                            <ComboBox Grid.Column="1"
                                      SelectedValue="{Binding GraphicsApi}"
                                      SelectedValueBinding="{Binding Tag}"
                                      AutomationProperties.Name="{ext:Translate AzaharConfig_GraphicsApi_Tooltip}"
                                      ToolTip.Tip="{ext:Translate AzaharConfig_GraphicsApi_Tooltip}">
                                <ComboBoxItem Content="OpenGL" Tag="0" />
                                <ComboBoxItem Content="Vulkan" Tag="2" />
                            </ComboBox>
                        </Grid>

                        <Grid ColumnDefinitions="*,*" Margin="0,5">
                            <TextBlock Text="{ext:Translate AzaharConfig_Resolution_Label}" Classes="form-label" />
                            <ComboBox Grid.Column="1"
                                      SelectedValue="{Binding Resolution}"
                                      SelectedValueBinding="{Binding Tag}"
                                      AutomationProperties.Name="{ext:Translate AzaharConfig_Resolution_Tooltip}"
                                      ToolTip.Tip="{ext:Translate AzaharConfig_Resolution_Tooltip}">
                                <ComboBoxItem Content="Auto" Tag="0" />
                                <ComboBoxItem Content="1x Native" Tag="1" />
                                <ComboBoxItem Content="2x (800x480)" Tag="2" />
                                <ComboBoxItem Content="3x (1200x720)" Tag="3" />
                                <ComboBoxItem Content="4x (1600x960)" Tag="4" />
                            </ComboBox>
                        </Grid>

                        <CheckBox IsChecked="{Binding Fullscreen}"
                                  Content="{ext:Translate AzaharConfig_Fullscreen_Checkbox}"
                                  Margin="0,5"
                                  ToolTip.Tip="{ext:Translate AzaharConfig_Fullscreen_Tooltip}" />
                        <CheckBox IsChecked="{Binding Vsync}"
                                  Content="{ext:Translate AzaharConfig_Vsync_Checkbox}"
                                  Margin="0,5"
                                  ToolTip.Tip="{ext:Translate AzaharConfig_Vsync_Tooltip}" />
                        <CheckBox IsChecked="{Binding AsyncShader}"
                                  Content="{ext:Translate AzaharConfig_AsyncShader_Checkbox}"
                                  Margin="0,5"
                                  ToolTip.Tip="{ext:Translate AzaharConfig_AsyncShader_Tooltip}" />
                    </StackPanel>
                </GroupBox>

                <!-- System Section -->
                <GroupBox Header="{ext:Translate AzaharConfig_System_Header}">
                    <StackPanel Margin="5">
                        <CheckBox IsChecked="{Binding IsNew3Ds}"
                                  Content="{ext:Translate AzaharConfig_New3DS_Checkbox}"
                                  Margin="0,5"
                                  ToolTip.Tip="{ext:Translate AzaharConfig_New3DS_Tooltip}" />
                        <Grid ColumnDefinitions="*,*" Margin="0,5">
                            <TextBlock Text="{ext:Translate AzaharConfig_Layout_Label}" Classes="form-label" />
                            <ComboBox Grid.Column="1"
                                      SelectedValue="{Binding Layout}"
                                      SelectedValueBinding="{Binding Tag}"
                                      AutomationProperties.Name="{ext:Translate AzaharConfig_Layout_Tooltip}"
                                      ToolTip.Tip="{ext:Translate AzaharConfig_Layout_Tooltip}">
                                <ComboBoxItem Content="Default" Tag="0" />
                                <ComboBoxItem Content="Single Screen" Tag="1" />
                                <ComboBoxItem Content="Large Screen" Tag="2" />
                                <ComboBoxItem Content="Side by Side" Tag="3" />
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <!-- Audio Section -->
                <GroupBox Header="{ext:Translate AzaharConfig_Audio_Header}">
                    <StackPanel Margin="5">
                        <TextBlock Text="{ext:Translate AzaharConfig_AudioVolume_Label}" Classes="form-label" />
                        <Slider Value="{Binding Volume}"
                                Minimum="0"
                                Maximum="100"
                                IsSnapToTickEnabled="True"
                                TickFrequency="1"
                                AutomationProperties.Name="{ext:Translate AzaharConfig_Volume_Tooltip}"
                                ToolTip.Tip="{ext:Translate AzaharConfig_Volume_Tooltip}" />
                        <CheckBox IsChecked="{Binding AudioStretching}"
                                  Content="{ext:Translate AzaharConfig_AudioStretching_Checkbox}"
                                  Margin="0,5"
                                  ToolTip.Tip="{ext:Translate AzaharConfig_AudioStretching_Tooltip}" />
                    </StackPanel>
                </GroupBox>

                <!-- CRITICAL SETTING -->
                <Border Classes="important-setting">
                    <StackPanel>
                        <TextBlock Text="{ext:Translate IMPORTANTSETTING}" Classes="important-setting-header" />
                        <CheckBox IsChecked="{Binding ShowBeforeLaunch}"
                                  Content="{ext:Translate AzaharConfig_ShowBeforeLaunch_Checkbox}"
                                  ToolTip.Tip="{ext:Translate AzaharConfig_ShowBeforeLaunch_Tooltip}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="BtnSave"
                    Content="{ext:Translate AzaharConfig_Save_Button}"
                    Classes="secondary"
                    Command="{Binding SaveCommand}"
                    AutomationProperties.Name="{ext:Translate AzaharConfig_Save_Tooltip}"
                    ToolTip.Tip="{ext:Translate AzaharConfig_Save_Tooltip}" />
            <Button Content="{ext:Translate AzaharConfig_Run_Button2}"
                    Classes="primary"
                    Command="{Binding RunCommand}"
                    IsDefault="True"
                    IsVisible="{Binding IsLauncherMode, Converter={StaticResource BoolToVisibility}}"
                    AutomationProperties.Name="{ext:Translate AzaharConfig_Run_Tooltip}"
                    ToolTip.Tip="{ext:Translate AzaharConfig_Run_Tooltip}" />
            <Button Content="{ext:Translate AzaharConfig_Cancel_Button}"
                    Classes="secondary"
                    Command="{Binding CancelCommand}"
                    AutomationProperties.Name="{ext:Translate AzaharConfig_Cancel_Tooltip}"
                    ToolTip.Tip="{ext:Translate AzaharConfig_Cancel_Tooltip}" />
        </StackPanel>
    </Grid>
</Window>