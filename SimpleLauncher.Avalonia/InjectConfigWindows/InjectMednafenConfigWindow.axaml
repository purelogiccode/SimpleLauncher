<Window x:Class="SimpleLauncher.Avalonia.InjectConfigWindows.InjectMednafenConfigWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:ext="using:SimpleLauncher.Avalonia.Extensions"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{ext:Translate MednafenConfig_Title}"
        Height="750" Width="700"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgPrimaryBrush}">

    <Grid Margin="10" RowDefinitions="*,Auto">

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Video Section -->
                <GroupBox Header="{ext:Translate MednafenConfig_Video_Header}" Margin="0,0,0,10">
                    <StackPanel Margin="5">
                        <Grid ColumnDefinitions="*,*" Margin="0,0,0,5">
                            <TextBlock Text="{ext:Translate MednafenConfig_VideoDriver_Label}" Classes="form-label"
                                       VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding VideoDriverOptions}"
                                      SelectedItem="{Binding MednafenVideoDriver}"
                                      AutomationProperties.Name="{ext:Translate MednafenConfig_VideoDriver_Tooltip}"
                                      ToolTip.Tip="{ext:Translate MednafenConfig_VideoDriver_Tooltip}" />
                        </Grid>
                        <CheckBox IsChecked="{Binding MednafenFullscreen}"
                                  Content="{ext:Translate MednafenConfig_Fullscreen_Checkbox}"
                                  Margin="0,5"
                                  ToolTip.Tip="{ext:Translate MednafenConfig_Fullscreen_Tooltip}" />
                        <CheckBox IsChecked="{Binding MednafenVsync}"
                                  Content="{ext:Translate MednafenConfig_Vsync_Checkbox}"
                                  Margin="0,5"
                                  ToolTip.Tip="{ext:Translate MednafenConfig_Vsync_Tooltip}" />
                        <Grid ColumnDefinitions="*,*" Margin="0,5,0,5">
                            <TextBlock Text="{ext:Translate MednafenConfig_Stretch_Label}" Classes="form-label"
                                       VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding StretchOptions}"
                                      SelectedItem="{Binding MednafenStretch}"
                                      AutomationProperties.Name="{ext:Translate MednafenConfig_Stretch_Tooltip}"
                                      ToolTip.Tip="{ext:Translate MednafenConfig_Stretch_Tooltip}" />
                        </Grid>
                        <CheckBox IsChecked="{Binding MednafenBilinear}"
                                  Content="{ext:Translate MednafenConfig_Bilinear_Checkbox}"
                                  Margin="0,5"
                                  ToolTip.Tip="{ext:Translate MednafenConfig_Bilinear_Tooltip}" />
                    </StackPanel>
                </GroupBox>

                <!-- Effects Section -->
                <GroupBox Header="{ext:Translate MednafenConfig_Effects_Header}" Margin="0,0,0,10">
                    <StackPanel Margin="5">
                        <TextBlock Text="{ext:Translate MednafenConfig_Scanlines_Label}" Classes="form-label"
                                   VerticalAlignment="Center" />
                        <Slider Value="{Binding MednafenScanlines}" Minimum="0" Maximum="100"
                                IsSnapToTickEnabled="True" TickFrequency="1"
                                AutomationProperties.Name="{ext:Translate MednafenConfig_Scanlines_Tooltip}"
                                ToolTip.Tip="{ext:Translate MednafenConfig_Scanlines_Tooltip}" />
                        <Grid ColumnDefinitions="*,*" Margin="0,5,0,5">
                            <TextBlock Text="{ext:Translate MednafenConfig_Shader_Label}" Classes="form-label"
                                       VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding ShaderOptions}"
                                      SelectedItem="{Binding MednafenShader}"
                                      AutomationProperties.Name="{ext:Translate MednafenConfig_Shader_Tooltip}"
                                      ToolTip.Tip="{ext:Translate MednafenConfig_Shader_Tooltip}" />
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <!-- Sound Section -->
                <GroupBox Header="{ext:Translate SoundIcon}" Margin="0,0,0,10">
                    <StackPanel Margin="5">
                        <TextBlock Text="{ext:Translate MednafenConfig_Volume_Label}" Classes="form-label"
                                   VerticalAlignment="Center" />
                        <Slider Value="{Binding MednafenVolume}" Minimum="0" Maximum="100" IsSnapToTickEnabled="True"
                                TickFrequency="1"
                                AutomationProperties.Name="{ext:Translate MednafenConfig_Volume_Tooltip}"
                                ToolTip.Tip="{ext:Translate MednafenConfig_Volume_Tooltip}" />
                    </StackPanel>
                </GroupBox>

                <!-- Features Section -->
                <GroupBox Header="{ext:Translate MednafenConfig_Features_Header}" Margin="0,0,0,10">
                    <StackPanel Margin="5">
                        <CheckBox IsChecked="{Binding MednafenCheats}"
                                  Content="{ext:Translate MednafenConfig_Cheats_Checkbox}"
                                  Margin="0,5"
                                  ToolTip.Tip="{ext:Translate MednafenConfig_Cheats_Tooltip}" />
                        <CheckBox IsChecked="{Binding MednafenRewind}"
                                  Content="{ext:Translate MednafenConfig_Rewind_Checkbox}"
                                  Margin="0,5"
                                  ToolTip.Tip="{ext:Translate MednafenConfig_Rewind_Tooltip}" />
                    </StackPanel>
                </GroupBox>

                <!-- CRITICAL SETTING -->
                <Border Classes="important-setting">
                    <StackPanel>
                        <TextBlock Text="{ext:Translate IMPORTANTSETTING}" Classes="important-setting-header" />
                        <CheckBox IsChecked="{Binding MednafenShowSettingsBeforeLaunch}"
                                  Content="{ext:Translate MednafenConfig_ShowBeforeLaunch_Checkbox}"
                                  ToolTip.Tip="{ext:Translate MednafenConfig_ShowBeforeLaunch_Tooltip}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="BtnSave" Content="{ext:Translate MednafenConfig_Save_Button}"
                    Classes="secondary"
                    Command="{Binding SaveCommand}"
                    AutomationProperties.Name="{ext:Translate MednafenConfig_Save_Tooltip}"
                    ToolTip.Tip="{ext:Translate MednafenConfig_Save_Tooltip}" />
            <Button Content="{ext:Translate MednafenConfig_Run_Button2}"
                    Classes="primary"
                    Command="{Binding RunCommand}"
                    IsDefault="True"
                    IsVisible="{Binding IsLauncherMode, Converter={StaticResource BoolToVisibility}}"
                    AutomationProperties.Name="{ext:Translate MednafenConfig_Run_Tooltip}"
                    ToolTip.Tip="{ext:Translate MednafenConfig_Run_Tooltip}" />
            <Button Content="{ext:Translate MednafenConfig_Cancel_Button}"
                    Classes="secondary"
                    Command="{Binding CancelCommand}"
                    AutomationProperties.Name="{ext:Translate MednafenConfig_Cancel_Tooltip}"
                    ToolTip.Tip="{ext:Translate MednafenConfig_Cancel_Tooltip}" />
        </StackPanel>
    </Grid>
</Window>