<Window x:Class="SimpleLauncher.Avalonia.InjectConfigWindows.InjectSupermodelConfigWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:ext="using:SimpleLauncher.Avalonia.Extensions"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{ext:Translate SupermodelConfig_Title}"
        Height="750" Width="700"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgPrimaryBrush}">

    <Grid Margin="10" RowDefinitions="*,Auto">

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Video Section -->
                <GroupBox Header="{ext:Translate SupermodelConfig_Video_Header}" Margin="0,0,0,10">
                    <StackPanel Margin="5">
                        <CheckBox IsChecked="{Binding New3DEngine}"
                                  Content="{ext:Translate SupermodelConfig_New3DEngine_Checkbox}"
                                  Margin="0,5"
                                  ToolTip.Tip="{ext:Translate SupermodelConfig_New3DEngine_Tooltip}" />
                        <CheckBox IsChecked="{Binding QuadRendering}"
                                  Content="{ext:Translate SupermodelConfig_QuadRendering_Checkbox}"
                                  Margin="0,5"
                                  ToolTip.Tip="{ext:Translate SupermodelConfig_QuadRendering_Tooltip}" />
                        <CheckBox IsChecked="{Binding Fullscreen}"
                                  Content="{ext:Translate SupermodelConfig_Fullscreen_Checkbox}"
                                  Margin="0,5"
                                  ToolTip.Tip="{ext:Translate SupermodelConfig_Fullscreen_Tooltip}" />
                        <CheckBox IsChecked="{Binding Vsync}"
                                  Content="{ext:Translate SupermodelConfig_Vsync_Checkbox}"
                                  Margin="0,5"
                                  ToolTip.Tip="{ext:Translate SupermodelConfig_Vsync_Tooltip}" />
                        <CheckBox IsChecked="{Binding WideScreen}"
                                  Content="{ext:Translate SupermodelConfig_Widescreen_Checkbox}"
                                  Margin="0,5"
                                  ToolTip.Tip="{ext:Translate SupermodelConfig_Widescreen_Tooltip}" />
                        <CheckBox IsChecked="{Binding Stretch}"
                                  Content="{ext:Translate SupermodelConfig_Stretch_Checkbox}"
                                  Margin="0,5"
                                  ToolTip.Tip="{ext:Translate SupermodelConfig_Stretch_Tooltip}" />

                        <TextBlock Text="{ext:Translate SupermodelConfig_Resolution_Label}" Classes="form-label"
                                   Margin="0,5,0,0"
                                   ToolTip.Tip="{ext:Translate SupermodelConfig_Resolution_Tooltip}" />
                        <Grid ColumnDefinitions="*,Auto,*">
                            <NumericUpDown Grid.Column="0" Minimum="640" Maximum="7680" Increment="1"
                                           Value="{Binding ResX}"
                                           AutomationProperties.Name="{ext:Translate SupermodelConfig_ResolutionX_Tooltip}"
                                           ToolTip.Tip="{ext:Translate SupermodelConfig_ResolutionX_Tooltip}" />
                            <TextBlock Grid.Column="1" Text="x" VerticalAlignment="Center" Margin="10,0" />
                            <NumericUpDown Grid.Column="2" Minimum="480" Maximum="4320" Increment="1"
                                           Value="{Binding ResY}"
                                           AutomationProperties.Name="{ext:Translate SupermodelConfig_ResolutionY_Tooltip}"
                                           ToolTip.Tip="{ext:Translate SupermodelConfig_ResolutionY_Tooltip}" />
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <!-- Audio Section -->
                <GroupBox Header="{ext:Translate SupermodelConfig_Audio_Header}" Margin="0,0,0,10">
                    <StackPanel Margin="5">
                        <TextBlock Text="{ext:Translate SupermodelConfig_MusicVolume_Label}" Classes="form-label"
                                   VerticalAlignment="Center" />
                        <Slider Value="{Binding MusicVolume}" Minimum="0" Maximum="100" IsSnapToTickEnabled="True"
                                TickFrequency="1"
                                AutomationProperties.Name="{ext:Translate SupermodelConfig_MusicVolume_Tooltip}"
                                ToolTip.Tip="{ext:Translate SupermodelConfig_MusicVolume_Tooltip}" />
                        <TextBlock Text="{ext:Translate SupermodelConfig_SoundVolume_Label}" Classes="form-label"
                                   VerticalAlignment="Center" Margin="0,5,0,0" />
                        <Slider Value="{Binding SoundVolume}" Minimum="0" Maximum="100" IsSnapToTickEnabled="True"
                                TickFrequency="1"
                                AutomationProperties.Name="{ext:Translate SupermodelConfig_SoundVolume_Tooltip}"
                                ToolTip.Tip="{ext:Translate SupermodelConfig_SoundVolume_Tooltip}" />
                    </StackPanel>
                </GroupBox>

                <!-- System & Performance Section -->
                <GroupBox Header="{ext:Translate SupermodelConfig_System_Header}" Margin="0,0,0,10">
                    <StackPanel Margin="5">
                        <CheckBox IsChecked="{Binding Throttle}"
                                  Content="{ext:Translate SupermodelConfig_Throttle_Checkbox}"
                                  Margin="0,5"
                                  ToolTip.Tip="{ext:Translate SupermodelConfig_Throttle_Tooltip}" />
                        <CheckBox IsChecked="{Binding MultiThreaded}"
                                  Content="{ext:Translate SupermodelConfig_MultiThreaded_Checkbox}"
                                  Margin="0,5"
                                  ToolTip.Tip="{ext:Translate SupermodelConfig_MultiThreaded_Tooltip}" />

                        <Grid ColumnDefinitions="*,*" Margin="0,5">
                            <TextBlock Text="{ext:Translate SupermodelConfig_InputSystem_Label}" Classes="form-label"
                                       VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding InputSystemOptions}"
                                      SelectedItem="{Binding InputSystem}"
                                      AutomationProperties.Name="{ext:Translate SupermodelConfig_InputSystem_Tooltip}"
                                      ToolTip.Tip="{ext:Translate SupermodelConfig_InputSystem_Tooltip}" />
                        </Grid>

                        <Grid ColumnDefinitions="*,*" Margin="0,5">
                            <TextBlock Text="{ext:Translate SupermodelConfig_PpcFrequency_Label}" Classes="form-label"
                                       VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding PpcFrequencyOptions}"
                                      SelectedItem="{Binding PowerPcFrequency}"
                                      AutomationProperties.Name="{ext:Translate SupermodelConfig_PpcFrequency_Tooltip}"
                                      ToolTip.Tip="{ext:Translate SupermodelConfig_PpcFrequency_Tooltip}" />
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <!-- CRITICAL SETTING -->
                <Border Classes="important-setting">
                    <StackPanel>
                        <TextBlock Text="{ext:Translate IMPORTANTSETTING}" Classes="important-setting-header" />
                        <CheckBox IsChecked="{Binding ShowBeforeLaunch}"
                                  Content="{ext:Translate SupermodelConfig_ShowBeforeLaunch_Checkbox}"
                                  ToolTip.Tip="{ext:Translate SupermodelConfig_ShowBeforeLaunch_Tooltip}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="BtnSave" Content="{ext:Translate SupermodelConfig_Save_Button}"
                    Classes="secondary"
                    Command="{Binding SaveCommand}"
                    AutomationProperties.Name="{ext:Translate SupermodelConfig_Save_Tooltip}"
                    ToolTip.Tip="{ext:Translate SupermodelConfig_Save_Tooltip}" />
            <Button Content="{ext:Translate SupermodelConfig_Run_Button2}"
                    Classes="primary"
                    Command="{Binding RunCommand}"
                    IsDefault="True"
                    IsVisible="{Binding IsLauncherMode, Converter={StaticResource BoolToVisibility}}"
                    AutomationProperties.Name="{ext:Translate SupermodelConfig_Run_Tooltip}"
                    ToolTip.Tip="{ext:Translate SupermodelConfig_Run_Tooltip}" />
            <Button Content="{ext:Translate SupermodelConfig_Cancel_Button}"
                    Classes="secondary"
                    Command="{Binding CancelCommand}"
                    AutomationProperties.Name="{ext:Translate SupermodelConfig_Cancel_Tooltip}"
                    ToolTip.Tip="{ext:Translate SupermodelConfig_Cancel_Tooltip}" />
        </StackPanel>
    </Grid>
</Window>