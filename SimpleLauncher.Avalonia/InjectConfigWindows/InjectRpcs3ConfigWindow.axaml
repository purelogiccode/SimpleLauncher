<Window x:Class="SimpleLauncher.Avalonia.InjectConfigWindows.InjectRpcs3ConfigWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:ext="using:SimpleLauncher.Avalonia.Extensions"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{ext:Translate RPCS3Config_Title}"
        Height="750" Width="700"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgPrimaryBrush}">

    <Grid Margin="10" RowDefinitions="*,Auto">

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Video Section -->
                <GroupBox Header="{ext:Translate RPCS3Config_Video_Header}" Margin="0,0,0,10">
                    <StackPanel Margin="5">
                        <Grid ColumnDefinitions="*,*" Margin="0,0,0,5">
                            <TextBlock Text="{ext:Translate RPCS3Config_Renderer_Label}" Classes="form-label" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding RendererOptions}"
                                      SelectedItem="{Binding Rpcs3Renderer}"
                                      AutomationProperties.Name="{ext:Translate RPCS3Config_Renderer_Tooltip}"
                                      ToolTip.Tip="{ext:Translate RPCS3Config_Renderer_Tooltip}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,*" Margin="0,5,0,5">
                            <TextBlock Text="{ext:Translate RPCS3Config_Resolution_Label}" Classes="form-label" />
                            <ComboBox Grid.Column="1" IsEditable="True"
                                      ItemsSource="{Binding ResolutionOptions}"
                                      Text="{Binding Rpcs3Resolution}"
                                      AutomationProperties.Name="{ext:Translate RPCS3Config_Resolution_Tooltip}"
                                      ToolTip.Tip="{ext:Translate RPCS3Config_Resolution_Tooltip}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,*" Margin="0,5,0,5">
                            <TextBlock Text="{ext:Translate RPCS3Config_AspectRatio_Label}" Classes="form-label" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding AspectRatioOptions}"
                                      SelectedItem="{Binding Rpcs3AspectRatio}"
                                      AutomationProperties.Name="{ext:Translate RPCS3Config_AspectRatio_Tooltip}"
                                      ToolTip.Tip="{ext:Translate RPCS3Config_AspectRatio_Tooltip}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,*" Margin="0,5,0,5">
                            <TextBlock Text="{ext:Translate RPCS3Config_ResolutionScale_Label}" Classes="form-label" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding ResolutionScaleOptions}"
                                      SelectedItem="{Binding Rpcs3ResolutionScale}"
                                      AutomationProperties.Name="{ext:Translate RPCS3Config_ResolutionScale_Tooltip}"
                                      ToolTip.Tip="{ext:Translate RPCS3Config_ResolutionScale_Tooltip}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,*" Margin="0,5,0,5">
                            <TextBlock Text="{ext:Translate RPCS3Config_AnisotropicFilter_Label}" Classes="form-label" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding AnisotropicFilterOptions}"
                                      SelectedItem="{Binding Rpcs3AnisotropicFilter}"
                                      AutomationProperties.Name="{ext:Translate RPCS3Config_AnisotropicFilter_Tooltip}"
                                      ToolTip.Tip="{ext:Translate RPCS3Config_AnisotropicFilter_Tooltip}" />
                        </Grid>
                        <CheckBox IsChecked="{Binding Rpcs3Vsync}"
                                  Content="{ext:Translate RPCS3Config_Vsync_Checkbox}"
                                  Margin="0,5"
                                  ToolTip.Tip="{ext:Translate RPCS3Config_Vsync_Tooltip}" />
                    </StackPanel>
                </GroupBox>

                <!-- Core Section -->
                <GroupBox Header="{ext:Translate RPCS3Config_Core_Header}" Margin="0,0,0,10">
                    <StackPanel Margin="5">
                        <Grid ColumnDefinitions="*,*" Margin="0,0,0,5">
                            <TextBlock Text="{ext:Translate RPCS3Config_PpuDecoder_Label}" Classes="form-label" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding PpuDecoderOptions}"
                                      SelectedItem="{Binding Rpcs3PpuDecoder}"
                                      AutomationProperties.Name="{ext:Translate RPCS3Config_PpuDecoder_Tooltip}"
                                      ToolTip.Tip="{ext:Translate RPCS3Config_PpuDecoder_Tooltip}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,*" Margin="0,5,0,5">
                            <TextBlock Text="{ext:Translate RPCS3Config_SpuDecoder_Label}" Classes="form-label" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding SpuDecoderOptions}"
                                      SelectedItem="{Binding Rpcs3SpuDecoder}"
                                      AutomationProperties.Name="{ext:Translate RPCS3Config_SpuDecoder_Tooltip}"
                                      ToolTip.Tip="{ext:Translate RPCS3Config_SpuDecoder_Tooltip}" />
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <!-- Audio Section -->
                <GroupBox Header="{ext:Translate RPCS3Config_Audio_Header}" Margin="0,0,0,10">
                    <StackPanel Margin="5">
                        <Grid ColumnDefinitions="*,*" Margin="0,0,0,5">
                            <TextBlock Text="{ext:Translate RPCS3Config_AudioRenderer_Label}" Classes="form-label" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding AudioRendererOptions}"
                                      SelectedItem="{Binding Rpcs3AudioRenderer}"
                                      AutomationProperties.Name="{ext:Translate RPCS3Config_AudioRenderer_Tooltip}"
                                      ToolTip.Tip="{ext:Translate RPCS3Config_AudioRenderer_Tooltip}" />
                        </Grid>
                        <CheckBox IsChecked="{Binding Rpcs3AudioBuffering}"
                                  Content="{ext:Translate RPCS3Config_AudioBuffering_Checkbox}"
                                  Margin="0,5"
                                  ToolTip.Tip="{ext:Translate RPCS3Config_AudioBuffering_Tooltip}" />
                    </StackPanel>
                </GroupBox>

                <!-- Miscellaneous Section -->
                <GroupBox Header="{ext:Translate RPCS3Config_Misc_Header}" Margin="0,0,0,10">
                    <StackPanel Margin="5">
                        <CheckBox IsChecked="{Binding Rpcs3StartFullscreen}"
                                  Content="{ext:Translate RPCS3Config_StartFullscreen_Checkbox}"
                                  Margin="0,5"
                                  ToolTip.Tip="{ext:Translate RPCS3Config_StartFullscreen_Tooltip}" />
                    </StackPanel>
                </GroupBox>

                <!-- CRITICAL SETTING -->
                <Border Classes="important-setting">
                    <StackPanel>
                        <TextBlock Text="{ext:Translate IMPORTANTSETTING}" Classes="important-setting-header" />
                        <CheckBox IsChecked="{Binding Rpcs3ShowSettingsBeforeLaunch}"
                                  Content="{ext:Translate RPCS3Config_ShowBeforeLaunch_Checkbox}"
                                  ToolTip.Tip="{ext:Translate RPCS3Config_ShowBeforeLaunch_Tooltip}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="BtnSave"
                    Content="{ext:Translate RPCS3Config_Save_Button}"
                    Classes="secondary"
                    Command="{Binding SaveCommand}"
                    AutomationProperties.Name="{ext:Translate RPCS3Config_Save_Tooltip}"
                    ToolTip.Tip="{ext:Translate RPCS3Config_Save_Tooltip}" />
            <Button Content="{ext:Translate RPCS3Config_Run_Button2}"
                    Classes="primary"
                    Command="{Binding RunCommand}"
                    IsDefault="True"
                    IsVisible="{Binding IsLauncherMode, Converter={StaticResource BoolToVisibility}}"
                    AutomationProperties.Name="{ext:Translate RPCS3Config_Run_Tooltip}"
                    ToolTip.Tip="{ext:Translate RPCS3Config_Run_Tooltip}" />
            <Button Content="{ext:Translate RPCS3Config_Cancel_Button}"
                    Classes="secondary"
                    Command="{Binding CancelCommand}"
                    AutomationProperties.Name="{ext:Translate RPCS3Config_Cancel_Tooltip}"
                    ToolTip.Tip="{ext:Translate RPCS3Config_Cancel_Tooltip}" />
        </StackPanel>
    </Grid>
</Window>