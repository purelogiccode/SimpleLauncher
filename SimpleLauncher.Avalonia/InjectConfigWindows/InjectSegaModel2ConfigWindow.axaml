<Window x:Class="SimpleLauncher.Avalonia.InjectConfigWindows.InjectSegaModel2ConfigWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:ext="using:SimpleLauncher.Avalonia.Extensions"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{ext:Translate SegaModel2Config_Title}"
        Height="700" Width="700"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgPrimaryBrush}">

    <Grid Margin="10" RowDefinitions="*,Auto">

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Renderer Section -->
                <GroupBox Header="{ext:Translate SegaModel2Config_Renderer_Header}" Margin="0,0,0,10">
                    <StackPanel Margin="5">
                        <TextBlock Text="{ext:Translate SegaModel2Config_Resolution_Label}" Classes="form-label"
                                   Margin="0,5,0,0"
                                   ToolTip.Tip="{ext:Translate SegaModel2Config_Resolution_Tooltip}" />
                        <Grid ColumnDefinitions="*,Auto,*">
                            <NumericUpDown Grid.Column="0" Minimum="640" Maximum="7680" Increment="1"
                                           Value="{Binding ResX}"
                                           AutomationProperties.Name="{ext:Translate SegaModel2Config_ResolutionX_Tooltip}"
                                           ToolTip.Tip="{ext:Translate SegaModel2Config_ResolutionX_Tooltip}" />
                            <TextBlock Grid.Column="1" Text="x" VerticalAlignment="Center" Margin="10,0" />
                            <NumericUpDown Grid.Column="2" Minimum="480" Maximum="4320" Increment="1"
                                           Value="{Binding ResY}"
                                           AutomationProperties.Name="{ext:Translate SegaModel2Config_ResolutionY_Tooltip}"
                                           ToolTip.Tip="{ext:Translate SegaModel2Config_ResolutionY_Tooltip}" />
                        </Grid>

                        <Grid ColumnDefinitions="*,*" Margin="0,5">
                            <TextBlock Text="{ext:Translate SegaModel2Config_Widescreen_Label}" Classes="form-label"
                                       VerticalAlignment="Center"
                                       ToolTip.Tip="{ext:Translate SegaModel2Config_Widescreen_Tooltip}" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding WideScreenOptions}"
                                      SelectedItem="{Binding WideScreen}"
                                      AutomationProperties.Name="{ext:Translate SegaModel2Config_Widescreen_Tooltip}"
                                      ToolTip.Tip="{ext:Translate SegaModel2Config_Widescreen_Tooltip}" />
                        </Grid>

                        <Grid ColumnDefinitions="*,*" Margin="0,5">
                            <TextBlock Text="{ext:Translate SegaModel2Config_FSAA_Label}" Classes="form-label"
                                       VerticalAlignment="Center"
                                       ToolTip.Tip="{ext:Translate SegaModel2Config_FSAA_Tooltip}" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding FsaaOptions}"
                                      SelectedItem="{Binding Fsaa}"
                                      AutomationProperties.Name="{ext:Translate SegaModel2Config_FSAA_Tooltip}"
                                      ToolTip.Tip="{ext:Translate SegaModel2Config_FSAA_Tooltip}" />
                        </Grid>

                        <CheckBox IsChecked="{Binding Bilinear}"
                                  Content="{ext:Translate SegaModel2Config_Bilinear_Checkbox}"
                                  Margin="0,5"
                                  ToolTip.Tip="{ext:Translate SegaModel2Config_Bilinear_Tooltip}" />
                        <CheckBox IsChecked="{Binding Trilinear}"
                                  Content="{ext:Translate SegaModel2Config_Trilinear_Checkbox}"
                                  Margin="0,5"
                                  ToolTip.Tip="{ext:Translate SegaModel2Config_Trilinear_Tooltip}" />
                        <CheckBox IsChecked="{Binding FilterTilemaps}"
                                  Content="{ext:Translate SegaModel2Config_FilterTilemaps_Checkbox}"
                                  Margin="0,5"
                                  ToolTip.Tip="{ext:Translate SegaModel2Config_FilterTilemaps_Tooltip}" />
                        <CheckBox IsChecked="{Binding DrawCross}"
                                  Content="{ext:Translate SegaModel2Config_DrawCross_Checkbox}"
                                  Margin="0,5"
                                  ToolTip.Tip="{ext:Translate SegaModel2Config_DrawCross_Tooltip}" />
                    </StackPanel>
                </GroupBox>

                <!-- Input Section -->
                <GroupBox Header="{ext:Translate SegaModel2Config_Input_Header}" Margin="0,0,0,10">
                    <StackPanel Margin="5">
                        <CheckBox IsChecked="{Binding XInput}"
                                  Content="{ext:Translate SegaModel2Config_XInput_Checkbox}"
                                  Margin="0,5"
                                  ToolTip.Tip="{ext:Translate SegaModel2Config_XInput_Tooltip}" />
                        <CheckBox IsChecked="{Binding EnableFf}"
                                  Content="{ext:Translate SegaModel2Config_EnableFF_Checkbox}"
                                  Margin="0,5"
                                  ToolTip.Tip="{ext:Translate SegaModel2Config_EnableFF_Tooltip}" />
                        <CheckBox IsChecked="{Binding HoldGears}"
                                  Content="{ext:Translate SegaModel2Config_HoldGears_Checkbox}"
                                  Margin="0,5"
                                  ToolTip.Tip="{ext:Translate SegaModel2Config_HoldGears_Tooltip}" />
                        <CheckBox IsChecked="{Binding UseRawInput}"
                                  Content="{ext:Translate SegaModel2Config_UseRawInput_Checkbox}"
                                  Margin="0,5"
                                  ToolTip.Tip="{ext:Translate SegaModel2Config_UseRawInput_Tooltip}" />
                    </StackPanel>
                </GroupBox>

                <!-- CRITICAL SETTING -->
                <Border Classes="important-setting">
                    <StackPanel>
                        <TextBlock Text="{ext:Translate IMPORTANTSETTING}" Classes="important-setting-header" />
                        <CheckBox IsChecked="{Binding ShowBeforeLaunch}"
                                  Content="{ext:Translate SegaModel2Config_ShowBeforeLaunch_Checkbox}"
                                  ToolTip.Tip="{ext:Translate SegaModel2Config_ShowBeforeLaunch_Tooltip}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="BtnSave" Content="{ext:Translate SegaModel2Config_Save_Button}"
                    Classes="secondary"
                    Command="{Binding SaveCommand}"
                    AutomationProperties.Name="{ext:Translate SegaModel2Config_Save_Tooltip}"
                    ToolTip.Tip="{ext:Translate SegaModel2Config_Save_Tooltip}" />
            <Button Content="{ext:Translate SegaModel2Config_Run_Button2}"
                    Classes="primary"
                    Command="{Binding RunCommand}"
                    IsDefault="True"
                    IsVisible="{Binding IsLauncherMode, Converter={StaticResource BoolToVisibility}}"
                    AutomationProperties.Name="{ext:Translate SegaModel2Config_Run_Tooltip}"
                    ToolTip.Tip="{ext:Translate SegaModel2Config_Run_Tooltip}" />
            <Button Content="{ext:Translate SegaModel2Config_Cancel_Button}"
                    Classes="secondary"
                    Command="{Binding CancelCommand}"
                    AutomationProperties.Name="{ext:Translate SegaModel2Config_Cancel_Tooltip}"
                    ToolTip.Tip="{ext:Translate SegaModel2Config_Cancel_Tooltip}" />
        </StackPanel>
    </Grid>
</Window>