<Window x:Class="SimpleLauncher.Avalonia.InjectConfigWindows.InjectDuckStationConfigWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:ext="using:SimpleLauncher.Avalonia.Extensions"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="using:SimpleLauncher.Core.Models"
        Title="{ext:Translate DuckStationConfig_Title}"
        Height="800" Width="700"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgPrimaryBrush}">

    <Grid Margin="10" RowDefinitions="*,Auto">

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- General Section -->
                <GroupBox Header="{ext:Translate DuckStationConfig_General_Header}" Margin="0,0,0,10">
                    <StackPanel Margin="5">
                        <CheckBox IsChecked="{Binding DuckStationStartFullscreen}"
                                  Content="{ext:Translate DuckStationConfig_Fullscreen_Checkbox}"
                                  Margin="0,5"
                                  ToolTip.Tip="{ext:Translate DuckStationConfig_Fullscreen_Tooltip}" />
                        <CheckBox IsChecked="{Binding DuckStationPauseOnFocusLoss}"
                                  Content="{ext:Translate DuckStationConfig_PauseOnFocusLoss_Checkbox}"
                                  Margin="0,5"
                                  ToolTip.Tip="{ext:Translate DuckStationConfig_PauseOnFocusLoss_Tooltip}" />
                        <CheckBox IsChecked="{Binding DuckStationSaveStateOnExit}"
                                  Content="{ext:Translate DuckStationConfig_SaveStateOnExit_Checkbox}"
                                  Margin="0,5"
                                  ToolTip.Tip="{ext:Translate DuckStationConfig_SaveStateOnExit_Tooltip}" />
                        <CheckBox IsChecked="{Binding DuckStationRewindEnable}"
                                  Content="{ext:Translate DuckStationConfig_Rewind_Checkbox}"
                                  Margin="0,5"
                                  ToolTip.Tip="{ext:Translate DuckStationConfig_RewindEnable_Tooltip}" />
                        <TextBlock Text="{ext:Translate DuckStationConfig_Runahead_Label}"
                                   Classes="form-label"
                                   ToolTip.Tip="{ext:Translate DuckStationConfig_Runahead_Tooltip}" />
                        <Slider Value="{Binding DuckStationRunaheadFrameCount}"
                                Minimum="0" Maximum="8"
                                IsSnapToTickEnabled="True" TickFrequency="1"
                                AutomationProperties.Name="{ext:Translate DuckStationConfig_Runahead_Tooltip}"
                                ToolTip.Tip="{ext:Translate DuckStationConfig_Runahead_Tooltip}" />
                    </StackPanel>
                </GroupBox>

                <!-- Video/GPU Section -->
                <GroupBox Header="{ext:Translate DuckStationConfig_Video_Header}" Margin="0,0,0,10">
                    <StackPanel Margin="5">
                        <Grid ColumnDefinitions="*,*" Margin="0,0,0,5">
                            <TextBlock Text="{ext:Translate DuckStationConfig_Renderer_Header}" Classes="form-label" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding RendererOptions}"
                                      SelectedItem="{Binding DuckStationRenderer}"
                                      AutomationProperties.Name="{ext:Translate DuckStationConfig_Renderer_Tooltip}"
                                      ToolTip.Tip="{ext:Translate DuckStationConfig_Renderer_Tooltip}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,*" Margin="0,5,0,5">
                            <TextBlock Text="{ext:Translate DuckStationConfig_ResolutionScale_Label}"
                                       Classes="form-label" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding ResolutionScaleOptions}"
                                      SelectedValue="{Binding DuckStationResolutionScale}"
                                      SelectedValueBinding="{Binding Tag}"
                                      AutomationProperties.Name="{ext:Translate DuckStationConfig_ResolutionScale_Tooltip}"
                                      ToolTip.Tip="{ext:Translate DuckStationConfig_ResolutionScale_Tooltip}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:TagOption">
                                        <TextBlock Text="{Binding Display}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                        <Grid ColumnDefinitions="*,*" Margin="0,5,0,5">
                            <TextBlock Text="{ext:Translate DuckStationConfig_TextureFilter_Label}"
                                       Classes="form-label" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding TextureFilterOptions}"
                                      SelectedItem="{Binding DuckStationTextureFilter}"
                                      AutomationProperties.Name="{ext:Translate DuckStationConfig_TextureFilter_Tooltip}"
                                      ToolTip.Tip="{ext:Translate DuckStationConfig_TextureFilter_Tooltip}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,*" Margin="0,5,0,5">
                            <TextBlock Text="{ext:Translate DuckStationConfig_AspectRatio_Label}" Classes="form-label" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding AspectRatioOptions}"
                                      SelectedItem="{Binding DuckStationAspectRatio}"
                                      AutomationProperties.Name="{ext:Translate DuckStationConfig_AspectRatio_Tooltip}"
                                      ToolTip.Tip="{ext:Translate DuckStationConfig_AspectRatio_Tooltip}" />
                        </Grid>
                        <CheckBox IsChecked="{Binding DuckStationWidescreenHack}"
                                  Content="{ext:Translate DuckStationConfig_WidescreenHack_Checkbox}"
                                  Margin="0,5"
                                  ToolTip.Tip="{ext:Translate DuckStationConfig_WidescreenHack_Tooltip}" />
                        <CheckBox IsChecked="{Binding DuckStationPgxpEnable}"
                                  Content="{ext:Translate DuckStationConfig_PgxpEnable_Checkbox}"
                                  Margin="0,5"
                                  ToolTip.Tip="{ext:Translate DuckStationConfig_PgxpEnable_Tooltip}" />
                        <CheckBox IsChecked="{Binding DuckStationVsync}"
                                  Content="{ext:Translate DuckStationConfig_Vsync_Checkbox}"
                                  Margin="0,5"
                                  ToolTip.Tip="{ext:Translate DuckStationConfig_Vsync_Tooltip}" />
                    </StackPanel>
                </GroupBox>

                <!-- Audio Section -->
                <GroupBox Header="{ext:Translate DuckStationConfig_Audio_Header}" Margin="0,0,0,10">
                    <StackPanel Margin="5">
                        <CheckBox IsChecked="{Binding DuckStationOutputMuted}"
                                  Content="{ext:Translate DuckStationConfig_Mute_Checkbox}"
                                  Margin="0,5"
                                  ToolTip.Tip="{ext:Translate DuckStationConfig_Mute_Tooltip}" />
                        <TextBlock Text="{ext:Translate DuckStationConfig_MasterVolume_Label}"
                                   Classes="form-label"
                                   ToolTip.Tip="{ext:Translate DuckStationConfig_Volume_Tooltip}" />
                        <Slider Value="{Binding DuckStationOutputVolume}"
                                Minimum="0" Maximum="100"
                                IsSnapToTickEnabled="True" TickFrequency="1"
                                AutomationProperties.Name="{ext:Translate DuckStationConfig_Volume_Tooltip}"
                                ToolTip.Tip="{ext:Translate DuckStationConfig_Volume_Tooltip}" />
                    </StackPanel>
                </GroupBox>

                <!-- CRITICAL SETTING -->
                <Border Classes="important-setting">
                    <StackPanel>
                        <TextBlock Text="{ext:Translate IMPORTANTSETTING}" Classes="important-setting-header" />
                        <CheckBox IsChecked="{Binding DuckStationShowSettingsBeforeLaunch}"
                                  Content="{ext:Translate DuckStationConfig_ShowBeforeLaunch_Checkbox}"
                                  ToolTip.Tip="{ext:Translate DuckStationConfig_ShowBeforeLaunch_Tooltip}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="BtnSave"
                    Content="{ext:Translate DuckStationConfig_Save_Button}"
                    Classes="secondary"
                    Command="{Binding SaveCommand}"
                    AutomationProperties.Name="{ext:Translate DuckStationConfig_Save_Tooltip}"
                    ToolTip.Tip="{ext:Translate DuckStationConfig_Save_Tooltip}" />
            <Button Content="{ext:Translate DuckStationConfig_Run_Button2}"
                    Classes="primary"
                    Command="{Binding RunCommand}"
                    IsDefault="True"
                    IsVisible="{Binding IsLauncherMode, Converter={StaticResource BoolToVisibility}}"
                    AutomationProperties.Name="{ext:Translate DuckStationConfig_Run_Tooltip}"
                    ToolTip.Tip="{ext:Translate DuckStationConfig_Run_Tooltip}" />
            <Button Content="{ext:Translate DuckStationConfig_Cancel_Button}"
                    Classes="secondary"
                    Command="{Binding CancelCommand}"
                    AutomationProperties.Name="{ext:Translate DuckStationConfig_Cancel_Tooltip}"
                    ToolTip.Tip="{ext:Translate DuckStationConfig_Cancel_Tooltip}" />
        </StackPanel>
    </Grid>
</Window>