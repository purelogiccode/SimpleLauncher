<Window x:Class="SimpleLauncher.Avalonia.InjectConfigWindows.InjectDolphinConfigWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:ext="using:SimpleLauncher.Avalonia.Extensions"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{ext:Translate DolphinConfig_Title}"
        Height="500" Width="700"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgPrimaryBrush}">

    <Grid Margin="10" RowDefinitions="*,Auto">

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Core Section -->
                <GroupBox Header="{ext:Translate DolphinConfig_Core_Header}">
                    <StackPanel Margin="5">
                        <Grid ColumnDefinitions="*,*" Margin="0,0,0,5">
                            <TextBlock Text="{ext:Translate DolphinConfig_GfxBackend_Label}" Classes="form-label" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding GfxBackendOptions}"
                                      SelectedItem="{Binding GfxBackend}"
                                      AutomationProperties.Name="{ext:Translate DolphinConfig_GfxBackend_Tooltip}"
                                      ToolTip.Tip="{ext:Translate DolphinConfig_GfxBackend_Tooltip}" />
                        </Grid>
                        <CheckBox IsChecked="{Binding DspThread}"
                                  Content="{ext:Translate DolphinConfig_DspThread_Checkbox}"
                                  Margin="0,5"
                                  ToolTip.Tip="{ext:Translate DolphinConfig_DspThread_Tooltip}" />
                    </StackPanel>
                </GroupBox>

                <!-- Wiimote Section -->
                <GroupBox Header="{ext:Translate InjectDolphinConfigWindow_Wiimote}">
                    <StackPanel Margin="5">
                        <CheckBox IsChecked="{Binding WiimoteContinuousScanning}"
                                  Content="{ext:Translate DolphinConfig_WiimoteContinuousScanning_Checkbox}"
                                  Margin="0,5"
                                  ToolTip.Tip="{ext:Translate DolphinConfig_WiimoteContinuousScanning_Tooltip}" />
                        <CheckBox IsChecked="{Binding WiimoteEnableSpeaker}"
                                  Content="{ext:Translate DolphinConfig_WiimoteEnableSpeaker_Checkbox}"
                                  Margin="0,5"
                                  ToolTip.Tip="{ext:Translate DolphinConfig_WiimoteEnableSpeaker_Tooltip}" />
                    </StackPanel>
                </GroupBox>

                <!-- CRITICAL SETTING -->
                <Border Classes="important-setting">
                    <StackPanel>
                        <TextBlock Text="{ext:Translate IMPORTANTSETTING}" Classes="important-setting-header" />
                        <CheckBox IsChecked="{Binding ShowBeforeLaunch}"
                                  Content="{ext:Translate DolphinConfig_ShowBeforeLaunch_Checkbox}"
                                  ToolTip.Tip="{ext:Translate DolphinConfig_ShowBeforeLaunch_Tooltip}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="{ext:Translate DolphinConfig_Save_Button}"
                    Classes="secondary"
                    Command="{Binding SaveCommand}"
                    AutomationProperties.Name="{ext:Translate DolphinConfig_Save_Tooltip}"
                    ToolTip.Tip="{ext:Translate DolphinConfig_Save_Tooltip}" />
            <Button Content="{ext:Translate DolphinConfig_Run_Button2}"
                    Classes="primary"
                    Command="{Binding RunCommand}"
                    IsDefault="True"
                    IsVisible="{Binding IsLauncherMode, Converter={StaticResource BoolToVisibility}}"
                    AutomationProperties.Name="{ext:Translate DolphinConfig_Run_Tooltip}"
                    ToolTip.Tip="{ext:Translate DolphinConfig_Run_Tooltip}" />
            <Button Content="{ext:Translate DolphinConfig_Cancel_Button}"
                    Classes="secondary"
                    Command="{Binding CancelCommand}"
                    AutomationProperties.Name="{ext:Translate DolphinConfig_Cancel_Tooltip}"
                    ToolTip.Tip="{ext:Translate DolphinConfig_Cancel_Tooltip}" />
        </StackPanel>
    </Grid>
</Window>