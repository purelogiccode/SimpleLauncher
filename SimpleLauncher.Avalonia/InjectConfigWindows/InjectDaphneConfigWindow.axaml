<Window x:Class="SimpleLauncher.Avalonia.InjectConfigWindows.InjectDaphneConfigWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:ext="using:SimpleLauncher.Avalonia.Extensions"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{ext:Translate DaphneConfig_Title}"
        Height="550" Width="700"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgPrimaryBrush}">

    <Grid Margin="10" RowDefinitions="*,Auto">

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Video Section -->
                <GroupBox Header="{ext:Translate DaphneConfig_Video_Header}" Margin="0,0,0,10">
                    <StackPanel Margin="5">
                        <CheckBox IsChecked="{Binding DaphneFullscreen}"
                                  Content="{ext:Translate DaphneConfig_Fullscreen_Checkbox}"
                                  Margin="0,5"
                                  ToolTip.Tip="{ext:Translate DaphneConfig_Fullscreen_Tooltip}" />
                        <CheckBox IsChecked="{Binding DaphneBilinear}"
                                  Content="{ext:Translate DaphneConfig_Bilinear_Checkbox}"
                                  Margin="0,5"
                                  ToolTip.Tip="{ext:Translate DaphneConfig_Bilinear_Tooltip}" />
                        <TextBlock Text="{ext:Translate DaphneConfig_Resolution_Label}" Classes="form-label"
                                   Margin="0,5,0,0"
                                   ToolTip.Tip="{ext:Translate DaphneConfig_Resolution_Tooltip}" />
                        <Grid ColumnDefinitions="*,Auto,*">
                            <NumericUpDown Grid.Column="0" Minimum="640" Maximum="7680" Increment="1"
                                           Value="{Binding DaphneResX}"
                                           AutomationProperties.Name="{ext:Translate DaphneConfig_ResolutionX_Tooltip}"
                                           ToolTip.Tip="{ext:Translate DaphneConfig_ResolutionX_Tooltip}" />
                            <TextBlock Grid.Column="1" Text="x" VerticalAlignment="Center" Margin="10,0" />
                            <NumericUpDown Grid.Column="2" Minimum="480" Maximum="4320" Increment="1"
                                           Value="{Binding DaphneResY}"
                                           AutomationProperties.Name="{ext:Translate DaphneConfig_ResolutionY_Tooltip}"
                                           ToolTip.Tip="{ext:Translate DaphneConfig_ResolutionY_Tooltip}" />
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <!-- Audio Section -->
                <GroupBox Header="{ext:Translate DaphneConfig_Audio_Header}" Margin="0,0,0,10">
                    <StackPanel Margin="5">
                        <CheckBox IsChecked="{Binding DaphneEnableSound}"
                                  Content="{ext:Translate DaphneConfig_EnableSound_Checkbox}"
                                  Margin="0,5"
                                  ToolTip.Tip="{ext:Translate DaphneConfig_EnableSound_Tooltip}" />
                    </StackPanel>
                </GroupBox>

                <!-- Gameplay Section -->
                <GroupBox Header="{ext:Translate DaphneConfig_Gameplay_Header}" Margin="0,0,0,10">
                    <StackPanel Margin="5">
                        <CheckBox IsChecked="{Binding DaphneDisableCrosshairs}"
                                  Content="{ext:Translate DaphneConfig_DisableCrosshairs_Checkbox}"
                                  Margin="0,5"
                                  ToolTip.Tip="{ext:Translate DaphneConfig_DisableCrosshairs_Tooltip}" />
                        <CheckBox IsChecked="{Binding DaphneUseOverlays}"
                                  Content="{ext:Translate DaphneConfig_UseOverlays_Checkbox}"
                                  Margin="0,5"
                                  ToolTip.Tip="{ext:Translate DaphneConfig_UseOverlays_Tooltip}" />
                    </StackPanel>
                </GroupBox>

                <!-- CRITICAL SETTING -->
                <Border Classes="important-setting">
                    <StackPanel>
                        <TextBlock Text="{ext:Translate IMPORTANTSETTING}" Classes="important-setting-header" />
                        <CheckBox IsChecked="{Binding DaphneShowSettingsBeforeLaunch}"
                                  Content="{ext:Translate DaphneConfig_ShowBeforeLaunch_Checkbox}"
                                  ToolTip.Tip="{ext:Translate DaphneConfig_ShowBeforeLaunch_Tooltip}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="BtnSave" Content="{ext:Translate DaphneConfig_Save_Button}"
                    Classes="secondary"
                    Command="{Binding SaveCommand}"
                    AutomationProperties.Name="{ext:Translate DaphneConfig_Save_Tooltip}"
                    ToolTip.Tip="{ext:Translate DaphneConfig_Save_Tooltip}" />
            <Button Content="{ext:Translate DaphneConfig_Run_Button2}"
                    Classes="primary"
                    Command="{Binding RunCommand}"
                    IsDefault="True"
                    IsVisible="{Binding IsLauncherMode, Converter={StaticResource BoolToVisibility}}"
                    AutomationProperties.Name="{ext:Translate DaphneConfig_Run_Tooltip}"
                    ToolTip.Tip="{ext:Translate DaphneConfig_Run_Tooltip}" />
            <Button Content="{ext:Translate DaphneConfig_Cancel_Button}"
                    Classes="secondary"
                    Command="{Binding CancelCommand}"
                    AutomationProperties.Name="{ext:Translate DaphneConfig_Cancel_Tooltip}"
                    ToolTip.Tip="{ext:Translate DaphneConfig_Cancel_Tooltip}" />
        </StackPanel>
    </Grid>
</Window>