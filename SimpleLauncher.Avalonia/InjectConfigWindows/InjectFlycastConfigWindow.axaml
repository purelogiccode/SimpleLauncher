<Window x:Class="SimpleLauncher.Avalonia.InjectConfigWindows.InjectFlycastConfigWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:ext="using:SimpleLauncher.Avalonia.Extensions"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{ext:Translate FlycastConfig_Title}"
        Height="450" Width="700"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgPrimaryBrush}">

    <Grid Margin="10" RowDefinitions="*,Auto">

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Video Section -->
                <GroupBox Header="{ext:Translate FlycastConfig_Video_Header}" Margin="0,0,0,10">
                    <StackPanel Margin="5">
                        <CheckBox IsChecked="{Binding Fullscreen}"
                                  Content="{ext:Translate FlycastConfig_Fullscreen_Checkbox}"
                                  Margin="0,5"
                                  ToolTip.Tip="{ext:Translate FlycastConfig_Fullscreen_Tooltip}" />
                        <CheckBox IsChecked="{Binding Maximized}"
                                  Content="{ext:Translate FlycastConfig_Maximized_Checkbox}"
                                  Margin="0,5"
                                  ToolTip.Tip="{ext:Translate FlycastConfig_Maximized_Tooltip}" />

                        <TextBlock Text="{ext:Translate FlycastConfig_Resolution_Label}" Classes="form-label"
                                   Margin="0,5,0,0"
                                   ToolTip.Tip="{ext:Translate FlycastConfig_Resolution_Tooltip}" />
                        <Grid ColumnDefinitions="*,Auto,*">
                            <NumericUpDown Grid.Column="0" Minimum="640" Maximum="7680" Increment="1"
                                           Value="{Binding Width}"
                                           AutomationProperties.Name="{ext:Translate FlycastConfig_ResolutionX_Tooltip}"
                                           ToolTip.Tip="{ext:Translate FlycastConfig_ResolutionX_Tooltip}" />
                            <TextBlock Grid.Column="1" Text="x" VerticalAlignment="Center" Margin="10,0" />
                            <NumericUpDown Grid.Column="2" Minimum="480" Maximum="4320" Increment="1"
                                           Value="{Binding Height}"
                                           AutomationProperties.Name="{ext:Translate FlycastConfig_ResolutionY_Tooltip}"
                                           ToolTip.Tip="{ext:Translate FlycastConfig_ResolutionY_Tooltip}" />
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <!-- CRITICAL SETTING -->
                <Border Classes="important-setting">
                    <StackPanel>
                        <TextBlock Text="{ext:Translate IMPORTANTSETTING}" Classes="important-setting-header" />
                        <CheckBox IsChecked="{Binding ShowBeforeLaunch}"
                                  Content="{ext:Translate FlycastConfig_ShowBeforeLaunch_Checkbox}"
                                  ToolTip.Tip="{ext:Translate FlycastConfig_ShowBeforeLaunch_Tooltip}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="BtnSave" Content="{ext:Translate FlycastConfig_Save_Button}"
                    Classes="secondary"
                    Command="{Binding SaveCommand}"
                    AutomationProperties.Name="{ext:Translate FlycastConfig_Save_Tooltip}"
                    ToolTip.Tip="{ext:Translate FlycastConfig_Save_Tooltip}" />
            <Button Content="{ext:Translate FlycastConfig_Run_Button2}"
                    Classes="primary"
                    Command="{Binding RunCommand}"
                    IsDefault="True"
                    IsVisible="{Binding IsLauncherMode, Converter={StaticResource BoolToVisibility}}"
                    AutomationProperties.Name="{ext:Translate FlycastConfig_Run_Tooltip}"
                    ToolTip.Tip="{ext:Translate FlycastConfig_Run_Tooltip}" />
            <Button Content="{ext:Translate FlycastConfig_Cancel_Button}"
                    Classes="secondary"
                    Command="{Binding CancelCommand}"
                    AutomationProperties.Name="{ext:Translate FlycastConfig_Cancel_Tooltip}"
                    ToolTip.Tip="{ext:Translate FlycastConfig_Cancel_Tooltip}" />
        </StackPanel>
    </Grid>
</Window>