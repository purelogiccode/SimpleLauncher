<Window x:Class="SimpleLauncher.Avalonia.EditSystemWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:ext="using:SimpleLauncher.Avalonia.Extensions"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{ext:Translate EditSystem}"
        Width="1200" MinWidth="1000"
        Height="600" MinHeight="550"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgPrimaryBrush}"
        Opened="Window_Opened"
        Closing="Window_Closing">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Row 0: selector + actions -->
        <Border Grid.Row="0" Background="{DynamicResource BgTertiaryBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1"
                Padding="12,10">
            <Grid ColumnDefinitions="*,Auto">

                <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center">
                    <TextBlock Text="{ext:Translate System}" FontSize="13" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,0" />
                    <ComboBox Grid.Column="1" x:Name="SystemNameDropdown"
                              HorizontalAlignment="Stretch"
                              MinWidth="250"
                              Height="40"
                              SelectionChanged="SystemNameDropdown_SelectionChanged"
                              Background="{DynamicResource BgSecondaryBrush}"
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              BorderBrush="{DynamicResource BorderNormalBrush}" />
                </Grid>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="AddSystemButton" Content="{ext:Translate EditSystemWindow_Add_New}"
                            Classes="secondary"
                            Padding="14,6" Margin="4,0"
                            Click="AddSystemButton_ClickAsync" />
                    <Button x:Name="SaveSystemButton" Content="{ext:Translate SaveorUpdateSystem}"
                            Classes="primary"
                            Padding="20,6" Margin="4,0"
                            IsEnabled="False"
                            Click="SaveSystemButton_ClickAsync" />
                    <Button x:Name="DeleteSystemButton" Content="{ext:Translate EditSystemWindow_Delete}"
                            Classes="secondary"
                            Padding="14,6" Margin="4,0"
                            IsEnabled="False"
                            Click="DeleteSystemButton_ClickAsync" />
                    <Button Content="{ext:Translate EditSystemWindow_Help}"
                            Classes="secondary"
                            Padding="14,6" Margin="4,0"
                            ToolTip.Tip="{ext:Translate EditSystemWindow_Open_the_parameters_wiki}"
                            Click="HelpLink_ClickAsync" />
                    <Button Content="{ext:Translate Close}"
                            Classes="secondary"
                            Padding="14,6" Margin="4,0"
                            Click="CloseButton_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Row 1: form (left) + splitter + System Help (right) — WPF EditSystemWindow 3-column parity -->
        <Grid Grid.Row="1" ColumnDefinitions="1.5*,5,*">
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="16,12"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <StackPanel HorizontalAlignment="Stretch">
                    <!-- ═══ SYSTEM ═══ -->
                    <Border Background="{DynamicResource BgSecondaryBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                            CornerRadius="6" Padding="16" Margin="0,0,0,14">
                        <StackPanel HorizontalAlignment="Stretch">
                            <TextBlock Text="{ext:Translate EditSystemWindow_System_Header}" FontWeight="SemiBold"
                                       FontSize="14"
                                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12" />

                            <!-- System image preview + picker (parity with WPF ChooseSystemImageButton) -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <Border Background="{DynamicResource BgTertiaryBrush}"
                                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                                        BorderThickness="1" CornerRadius="4" Padding="4"
                                        Width="150" Height="150">
                                    <Image x:Name="SystemImagePreview" Stretch="Uniform"
                                           RenderOptions.BitmapInterpolationMode="HighQuality" />
                                </Border>
                                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{ext:Translate SystemImageLabel}" FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock
                                        Text="{ext:Translate EditSystemWindow_Copied_to_images_systems_as_PNG_JPG}"
                                        FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                        TextWrapping="Wrap" MaxWidth="260" Margin="0,4,0,8" />
                                    <Button Content="{ext:Translate EditSystemWindow_Choose_Image}" Classes="secondary"
                                            Padding="12,6"
                                            ToolTip.Tip="{ext:Translate TooltipChooseSystemImage}"
                                            Click="ChooseSystemImageButton_ClickAsync" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Name -->
                            <TextBlock Text="{ext:Translate SystemNameHeader}" FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBox x:Name="SystemNameTextBox" Height="40" Margin="0,4,0,12"
                                     Background="{DynamicResource BgTertiaryBrush}"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     BorderBrush="{DynamicResource BorderNormalBrush}"
                                     LostFocus="SystemNameTextBox_LostFocus" />

                            <!-- System folders -->
                            <TextBlock Text="{ext:Translate EditSystemWindow_System_Folder_ROMs}" FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <Grid Margin="0,4,0,4" ColumnDefinitions="*,Auto">
                                <TextBox x:Name="SystemFolderTextBox" Height="40"
                                         VerticalContentAlignment="Center"
                                         Background="{DynamicResource BgTertiaryBrush}"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         BorderBrush="{DynamicResource BorderNormalBrush}" />
                                <Button Grid.Column="1" Content="{ext:Translate SetSystemFolder}" MinWidth="110"
                                        Height="40" Padding="12,6" Margin="6,0,0,0"
                                        Classes="secondary"
                                        ToolTip.Tip="{ext:Translate TooltipChooseSystemFolder}"
                                        Click="ChooseSystemFolder" />
                            </Grid>

                            <!-- Additional folders (WPF AdditionalFoldersExpander parity) -->
                            <Expander x:Name="AdditionalFoldersExpander"
                                      Header="{ext:Translate AdditionalSystemFoldersOptional}"
                                      ToolTip.Tip="{ext:Translate TooltipAdditionalFoldersExpander}"
                                      HorizontalAlignment="Stretch"
                                      HorizontalContentAlignment="Stretch"
                                      Margin="0,8,0,0">
                                <StackPanel HorizontalAlignment="Stretch">
                                    <ListBox x:Name="AdditionalFoldersListBox" Height="90" Margin="0,4,0,4"
                                             Background="{DynamicResource BgTertiaryBrush}"
                                             Foreground="{DynamicResource TextPrimaryBrush}"
                                             BorderBrush="{DynamicResource BorderNormalBrush}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <Button Content="{ext:Translate EditSystemWindow_Add_Folder}" Padding="10,4"
                                                Classes="secondary"
                                                Margin="0,0,6,0"
                                                Click="AddAdditionalFolder_Click" />
                                        <Button Content="{ext:Translate EditSystemWindow_Remove_Selected}" Padding="10,4"
                                                Classes="secondary"
                                                Click="RemoveAdditionalFolder_Click" />
                                    </StackPanel>
                                </StackPanel>
                            </Expander>

                            <!-- Image folder -->
                            <TextBlock Text="{ext:Translate SystemImageFolder}" FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <Grid Margin="0,4,0,12" ColumnDefinitions="*,Auto">
                                <TextBox x:Name="SystemImageFolderTextBox" Height="40"
                                         VerticalContentAlignment="Center"
                                         Background="{DynamicResource BgTertiaryBrush}"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         BorderBrush="{DynamicResource BorderNormalBrush}" />
                                <Button Grid.Column="1" Content="{ext:Translate SetSystemImageFolder}" MinWidth="130"
                                        Height="40" Padding="12,6" Margin="6,0,0,0"
                                        Classes="secondary"
                                        ToolTip.Tip="{ext:Translate TooltipChooseSystemImageFolder2}"
                                        Click="ChooseSystemImageFolder" />
                            </Grid>

                            <!-- Formats -->
                            <Grid ColumnDefinitions="*,*">
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock
                                        Text="{ext:Translate EditSystemWindow_Formats_to_Search_comma_separated}"
                                        FontSize="12"
                                        Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBox x:Name="FormatToSearchTextBox" Height="40" Margin="0,4,0,12"
                                             Background="{DynamicResource BgTertiaryBrush}"
                                             Foreground="{DynamicResource TextPrimaryBrush}"
                                             BorderBrush="{DynamicResource BorderNormalBrush}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock
                                        Text="{ext:Translate EditSystemWindow_Formats_to_Launch_comma_separated}"
                                        FontSize="12"
                                        Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBox x:Name="FormatToLaunchTextBox" Height="40" Margin="0,4,0,12"
                                             Background="{DynamicResource BgTertiaryBrush}"
                                             Foreground="{DynamicResource TextPrimaryBrush}"
                                             BorderBrush="{DynamicResource BorderNormalBrush}" />
                                </StackPanel>
                            </Grid>

                            <!-- Options -->
                            <Grid ColumnDefinitions="*,*,*">
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Text="{ext:Translate ExtractFileBeforeLaunch}" FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <ComboBox x:Name="ExtractFileBeforeLaunchComboBox" Height="40" Margin="0,4,0,0"
                                              Background="{DynamicResource BgTertiaryBrush}"
                                              Foreground="{DynamicResource TextPrimaryBrush}"
                                              BorderBrush="{DynamicResource BorderNormalBrush}">
                                        <ComboBoxItem Content="false" />
                                        <ComboBoxItem Content="true" />
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                    <TextBlock Text="{ext:Translate EditSystemWindow_Group_By_Folder}" FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <ComboBox x:Name="GroupByFolderComboBox" Height="40" Margin="0,4,0,0"
                                              Background="{DynamicResource BgTertiaryBrush}"
                                              Foreground="{DynamicResource TextPrimaryBrush}"
                                              BorderBrush="{DynamicResource BorderNormalBrush}">
                                        <ComboBoxItem Content="false" />
                                        <ComboBoxItem Content="true" />
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{ext:Translate DisableRecursiveSearch}" FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <ComboBox x:Name="DisableRecursiveSearchComboBox" Height="40" Margin="0,4,0,0"
                                              Background="{DynamicResource BgTertiaryBrush}"
                                              Foreground="{DynamicResource TextPrimaryBrush}"
                                              BorderBrush="{DynamicResource BorderNormalBrush}">
                                        <ComboBoxItem Content="false" />
                                        <ComboBoxItem Content="true" />
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ═══ EMULATORS ═══ -->
                    <Border Background="{DynamicResource BgSecondaryBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                            CornerRadius="6" Padding="16" Margin="0,0,0,14">
                        <StackPanel HorizontalAlignment="Stretch">
                            <TextBlock Text="{ext:Translate Preferences.Emulators}" FontWeight="SemiBold" FontSize="14"
                                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12" />

                            <Expander x:Name="Emulator1Expander" Header="{ext:Translate Emulator1}" IsExpanded="True"
                                      Foreground="{DynamicResource TextPrimaryBrush}"
                                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                <StackPanel Margin="0,8,0,0" HorizontalAlignment="Stretch">
                                    <Grid ColumnDefinitions="*,*" HorizontalAlignment="Stretch">
                                        <StackPanel Margin="0,0,8,0">
                                            <TextBlock Text="{ext:Translate Name}" FontSize="12"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <TextBox x:Name="Emulator1NameTextBox" Height="40" Margin="0,4,0,8"
                                                     Background="{DynamicResource BgTertiaryBrush}"
                                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                                     BorderBrush="{DynamicResource BorderNormalBrush}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{ext:Translate EditSystemWindow_Notify_on_Error}"
                                                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <ComboBox x:Name="ReceiveANotificationOnEmulatorError1" Height="40"
                                                      Margin="0,4,0,8"
                                                      Background="{DynamicResource BgTertiaryBrush}"
                                                      Foreground="{DynamicResource TextPrimaryBrush}"
                                                      BorderBrush="{DynamicResource BorderNormalBrush}">
                                                <ComboBoxItem Content="false" />
                                                <ComboBoxItem Content="true" />
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="{ext:Translate EditSystemWindow_Path_exe_bat}" FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <Grid Margin="0,4,0,8" ColumnDefinitions="*,Auto">
                                        <TextBox x:Name="Emulator1PathTextBox" Height="40"
                                                 VerticalContentAlignment="Center"
                                                 Background="{DynamicResource BgTertiaryBrush}"
                                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                                 BorderBrush="{DynamicResource BorderNormalBrush}" />
                                        <Button Grid.Column="1" Content="{ext:Translate SetEmulator1Path}"
                                                MinWidth="130" Height="40" Padding="12,6" Margin="6,0,0,0"
                                                Classes="secondary"
                                                ToolTip.Tip="{ext:Translate TooltipChooseEmulator1Path}"
                                                Click="ChooseEmulator1Path" />
                                    </Grid>
                                    <TextBlock Text="{ext:Translate EditSystemWindow_Parameters}" FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <Grid Margin="0,4,0,0" ColumnDefinitions="*,Auto">
                                        <TextBox x:Name="Emulator1ParametersTextBox" Height="40"
                                                 Background="{DynamicResource BgTertiaryBrush}"
                                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                                 BorderBrush="{DynamicResource BorderNormalBrush}" />
                                        <Button Grid.Column="1" Content="{ext:Translate SuggestParameters}"
                                                MinWidth="90" Height="40" Padding="12,6" Margin="6,0,0,0"
                                                Classes="secondary"
                                                ToolTip.Tip="{ext:Translate TooltipSuggestParameters}"
                                                Click="SuggestEmulator1Parameters_ClickAsync" />
                                    </Grid>
                                </StackPanel>
                            </Expander>

                            <Expander x:Name="Emulator2Expander" Header="{ext:Translate Emulator2}"
                                      Foreground="{DynamicResource TextPrimaryBrush}"
                                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                <StackPanel Margin="0,8,0,0" HorizontalAlignment="Stretch">
                                    <Grid ColumnDefinitions="*,*" HorizontalAlignment="Stretch">
                                        <StackPanel Margin="0,0,8,0">
                                            <TextBlock Text="{ext:Translate Name}" FontSize="12"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <TextBox x:Name="Emulator2NameTextBox" Height="40" Margin="0,4,0,8"
                                                     Background="{DynamicResource BgTertiaryBrush}"
                                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                                     BorderBrush="{DynamicResource BorderNormalBrush}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{ext:Translate EditSystemWindow_Notify_on_Error}"
                                                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <ComboBox x:Name="ReceiveANotificationOnEmulatorError2" Height="40"
                                                      Margin="0,4,0,8"
                                                      Background="{DynamicResource BgTertiaryBrush}"
                                                      Foreground="{DynamicResource TextPrimaryBrush}"
                                                      BorderBrush="{DynamicResource BorderNormalBrush}">
                                                <ComboBoxItem Content="false" />
                                                <ComboBoxItem Content="true" />
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="{ext:Translate EditSystemWindow_Path_exe_bat}" FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <Grid Margin="0,4,0,8" ColumnDefinitions="*,Auto">
                                        <TextBox x:Name="Emulator2PathTextBox" Height="40"
                                                 VerticalContentAlignment="Center"
                                                 Background="{DynamicResource BgTertiaryBrush}"
                                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                                 BorderBrush="{DynamicResource BorderNormalBrush}" />
                                        <Button Grid.Column="1" Content="{ext:Translate SetEmulator2Path}"
                                                MinWidth="130" Height="40" Padding="12,6" Margin="6,0,0,0"
                                                Classes="secondary"
                                                ToolTip.Tip="{ext:Translate TooltipChooseEmulator2Path}"
                                                Click="ChooseEmulator2Path" />
                                    </Grid>
                                    <TextBlock Text="{ext:Translate EditSystemWindow_Parameters}" FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <Grid Margin="0,4,0,0" ColumnDefinitions="*,Auto">
                                        <TextBox x:Name="Emulator2ParametersTextBox" Height="40"
                                                 Background="{DynamicResource BgTertiaryBrush}"
                                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                                 BorderBrush="{DynamicResource BorderNormalBrush}" />
                                        <Button Grid.Column="1" Content="{ext:Translate SuggestParameters}"
                                                MinWidth="90" Height="40" Padding="12,6" Margin="6,0,0,0"
                                                Classes="secondary"
                                                ToolTip.Tip="{ext:Translate TooltipSuggestParameters}"
                                                Click="SuggestEmulator2Parameters_ClickAsync" />
                                    </Grid>
                                </StackPanel>
                            </Expander>

                            <Expander x:Name="Emulator3Expander" Header="{ext:Translate Emulator3}"
                                      Foreground="{DynamicResource TextPrimaryBrush}"
                                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                <StackPanel Margin="0,8,0,0" HorizontalAlignment="Stretch">
                                    <Grid ColumnDefinitions="*,*" HorizontalAlignment="Stretch">
                                        <StackPanel Margin="0,0,8,0">
                                            <TextBlock Text="{ext:Translate Name}" FontSize="12"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <TextBox x:Name="Emulator3NameTextBox" Height="40" Margin="0,4,0,8"
                                                     Background="{DynamicResource BgTertiaryBrush}"
                                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                                     BorderBrush="{DynamicResource BorderNormalBrush}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{ext:Translate EditSystemWindow_Notify_on_Error}"
                                                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <ComboBox x:Name="ReceiveANotificationOnEmulatorError3" Height="40"
                                                      Margin="0,4,0,8"
                                                      Background="{DynamicResource BgTertiaryBrush}"
                                                      Foreground="{DynamicResource TextPrimaryBrush}"
                                                      BorderBrush="{DynamicResource BorderNormalBrush}">
                                                <ComboBoxItem Content="false" />
                                                <ComboBoxItem Content="true" />
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="{ext:Translate EditSystemWindow_Path_exe_bat}" FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <Grid Margin="0,4,0,8" ColumnDefinitions="*,Auto">
                                        <TextBox x:Name="Emulator3PathTextBox" Height="40"
                                                 VerticalContentAlignment="Center"
                                                 Background="{DynamicResource BgTertiaryBrush}"
                                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                                 BorderBrush="{DynamicResource BorderNormalBrush}" />
                                        <Button Grid.Column="1" Content="{ext:Translate SetEmulator3Path}"
                                                MinWidth="130" Height="40" Padding="12,6" Margin="6,0,0,0"
                                                Classes="secondary"
                                                ToolTip.Tip="{ext:Translate TooltipChooseEmulator3Path}"
                                                Click="ChooseEmulator3Path" />
                                    </Grid>
                                    <TextBlock Text="{ext:Translate EditSystemWindow_Parameters}" FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <Grid Margin="0,4,0,0" ColumnDefinitions="*,Auto">
                                        <TextBox x:Name="Emulator3ParametersTextBox" Height="40"
                                                 Background="{DynamicResource BgTertiaryBrush}"
                                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                                 BorderBrush="{DynamicResource BorderNormalBrush}" />
                                        <Button Grid.Column="1" Content="{ext:Translate SuggestParameters}"
                                                MinWidth="90" Height="40" Padding="12,6" Margin="6,0,0,0"
                                                Classes="secondary"
                                                ToolTip.Tip="{ext:Translate TooltipSuggestParameters}"
                                                Click="SuggestEmulator3Parameters_ClickAsync" />
                                    </Grid>
                                </StackPanel>
                            </Expander>

                            <Expander x:Name="Emulator4Expander" Header="{ext:Translate Emulator4}"
                                      Foreground="{DynamicResource TextPrimaryBrush}"
                                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                <StackPanel Margin="0,8,0,0" HorizontalAlignment="Stretch">
                                    <Grid ColumnDefinitions="*,*" HorizontalAlignment="Stretch">
                                        <StackPanel Margin="0,0,8,0">
                                            <TextBlock Text="{ext:Translate Name}" FontSize="12"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <TextBox x:Name="Emulator4NameTextBox" Height="40" Margin="0,4,0,8"
                                                     Background="{DynamicResource BgTertiaryBrush}"
                                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                                     BorderBrush="{DynamicResource BorderNormalBrush}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{ext:Translate EditSystemWindow_Notify_on_Error}"
                                                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <ComboBox x:Name="ReceiveANotificationOnEmulatorError4" Height="40"
                                                      Margin="0,4,0,8"
                                                      Background="{DynamicResource BgTertiaryBrush}"
                                                      Foreground="{DynamicResource TextPrimaryBrush}"
                                                      BorderBrush="{DynamicResource BorderNormalBrush}">
                                                <ComboBoxItem Content="false" />
                                                <ComboBoxItem Content="true" />
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="{ext:Translate EditSystemWindow_Path_exe_bat}" FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <Grid Margin="0,4,0,8" ColumnDefinitions="*,Auto">
                                        <TextBox x:Name="Emulator4PathTextBox" Height="40"
                                                 VerticalContentAlignment="Center"
                                                 Background="{DynamicResource BgTertiaryBrush}"
                                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                                 BorderBrush="{DynamicResource BorderNormalBrush}" />
                                        <Button Grid.Column="1" Content="{ext:Translate SetEmulator4Path}"
                                                MinWidth="130" Height="40" Padding="12,6" Margin="6,0,0,0"
                                                Classes="secondary"
                                                ToolTip.Tip="{ext:Translate TooltipChooseEmulator4Path}"
                                                Click="ChooseEmulator4Path" />
                                    </Grid>
                                    <TextBlock Text="{ext:Translate EditSystemWindow_Parameters}" FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <Grid Margin="0,4,0,0" ColumnDefinitions="*,Auto">
                                        <TextBox x:Name="Emulator4ParametersTextBox" Height="40"
                                                 Background="{DynamicResource BgTertiaryBrush}"
                                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                                 BorderBrush="{DynamicResource BorderNormalBrush}" />
                                        <Button Grid.Column="1" Content="{ext:Translate SuggestParameters}"
                                                MinWidth="90" Height="40" Padding="12,6" Margin="6,0,0,0"
                                                Classes="secondary"
                                                ToolTip.Tip="{ext:Translate TooltipSuggestParameters}"
                                                Click="SuggestEmulator4Parameters_ClickAsync" />
                                    </Grid>
                                </StackPanel>
                            </Expander>

                            <Expander x:Name="Emulator5Expander" Header="{ext:Translate Emulator5}"
                                      Foreground="{DynamicResource TextPrimaryBrush}"
                                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                <StackPanel Margin="0,8,0,0" HorizontalAlignment="Stretch">
                                    <Grid ColumnDefinitions="*,*" HorizontalAlignment="Stretch">
                                        <StackPanel Margin="0,0,8,0">
                                            <TextBlock Text="{ext:Translate Name}" FontSize="12"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <TextBox x:Name="Emulator5NameTextBox" Height="40" Margin="0,4,0,8"
                                                     Background="{DynamicResource BgTertiaryBrush}"
                                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                                     BorderBrush="{DynamicResource BorderNormalBrush}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{ext:Translate EditSystemWindow_Notify_on_Error}"
                                                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <ComboBox x:Name="ReceiveANotificationOnEmulatorError5" Height="40"
                                                      Margin="0,4,0,8"
                                                      Background="{DynamicResource BgTertiaryBrush}"
                                                      Foreground="{DynamicResource TextPrimaryBrush}"
                                                      BorderBrush="{DynamicResource BorderNormalBrush}">
                                                <ComboBoxItem Content="false" />
                                                <ComboBoxItem Content="true" />
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="{ext:Translate EditSystemWindow_Path_exe_bat}" FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <Grid Margin="0,4,0,8" ColumnDefinitions="*,Auto">
                                        <TextBox x:Name="Emulator5PathTextBox" Height="40"
                                                 VerticalContentAlignment="Center"
                                                 Background="{DynamicResource BgTertiaryBrush}"
                                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                                 BorderBrush="{DynamicResource BorderNormalBrush}" />
                                        <Button Grid.Column="1" Content="{ext:Translate SetEmulator5Path}"
                                                MinWidth="130" Height="40" Padding="12,6" Margin="6,0,0,0"
                                                Classes="secondary"
                                                ToolTip.Tip="{ext:Translate TooltipChooseEmulator5Path}"
                                                Click="ChooseEmulator5Path" />
                                    </Grid>
                                    <TextBlock Text="{ext:Translate EditSystemWindow_Parameters}" FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <Grid Margin="0,4,0,0" ColumnDefinitions="*,Auto">
                                        <TextBox x:Name="Emulator5ParametersTextBox" Height="40"
                                                 Background="{DynamicResource BgTertiaryBrush}"
                                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                                 BorderBrush="{DynamicResource BorderNormalBrush}" />
                                        <Button Grid.Column="1" Content="{ext:Translate SuggestParameters}"
                                                MinWidth="90" Height="40" Padding="12,6" Margin="6,0,0,0"
                                                Classes="secondary"
                                                ToolTip.Tip="{ext:Translate TooltipSuggestParameters}"
                                                Click="SuggestEmulator5Parameters_ClickAsync" />
                                    </Grid>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Rail resize grip (WPF GridSplitter parity) -->
            <GridSplitter Grid.Column="1" Width="5"
                          Background="Transparent"
                          ResizeBehavior="PreviousAndNext"
                          Cursor="SizeWestEast" />

            <!-- Right column: Developer Suggestion / System Help (WPF HelpUserTextBlock parity) -->
            <Grid Grid.Column="2" Margin="10" RowDefinitions="Auto,*">
                <TextBlock x:Name="HelpTitleTextBlock"
                           Margin="0,0,0,8"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontWeight="Bold"
                           FontSize="14"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <Border Grid.Row="1" Background="{DynamicResource BgSecondaryBrush}"
                        BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                        CornerRadius="6" Padding="10">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <SelectableTextBlock x:Name="SystemHelpTextBlock"
                                             TextWrapping="Wrap"
                                             Foreground="{DynamicResource TextPrimaryBrush}"
                                             FontSize="12" />
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>

        <!-- Row 2: status -->
        <Border Grid.Row="2" Background="{DynamicResource BgSecondaryBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0"
                Padding="12,6">
            <TextBlock x:Name="StatusTextBlock" FontSize="12"
                       Foreground="{DynamicResource TextMutedBrush}"
                       Text="{ext:Translate EditSystemWindow_Select_a_system_to_edit_or_click_Add_New}" />
        </Border>

        <!-- Loading overlay -->
        <Border x:Name="LoadingOverlay"
                Grid.Row="0" Grid.RowSpan="3"
                Background="#B31E1E1E"
                IsVisible="False">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="LoadingText" Text="{ext:Translate Loadingsystems}" FontSize="14"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           HorizontalAlignment="Center" />
                <Button x:Name="EmergencyButton"
                        Content="{ext:Translate EditSystemWindow_Return}"
                        Width="100" Margin="0,16,0,0"
                        Classes="secondary"
                        Click="EmergencyOverlayRelease_Click"
                        HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</Window>