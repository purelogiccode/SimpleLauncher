<Window x:Class="SimpleLauncher.Avalonia.UpdateLogWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:ext="using:SimpleLauncher.Avalonia.Extensions"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{ext:Translate Updating}"
        Width="600" Height="400"
        CanResize="False"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <TextBox Text="{Binding LogText, Mode=OneWay}"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 TextWrapping="NoWrap"
                 FontFamily="Consolas, Courier New, monospace"
                 AutomationProperties.Name="Update log" />
    </Grid>
</Window>