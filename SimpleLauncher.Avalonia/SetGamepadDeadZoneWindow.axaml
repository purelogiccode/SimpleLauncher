<Window x:Class="SimpleLauncher.Avalonia.SetGamepadDeadZoneWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:ext="using:SimpleLauncher.Avalonia.Extensions"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{ext:Translate SetGamepadDeadZone}"
        Width="600" Height="480"
        WindowStartupLocation="CenterScreen">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="Auto,*,Auto">

        <!-- Explanation -->
        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                   Margin="10,20,10,10"
                   Text="{ext:Translate SetGamepadDeadZoneWindow_You_can_define_custom_gamepad_dead_zone_}"
                   TextWrapping="Wrap" />

        <!-- Dead Zone Explanation -->
        <GroupBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                  Margin="10,0,10,10"
                  Header="{ext:Translate SetGamepadDeadZoneWindow_Dead_Zone_Explanation}">
            <StackPanel>
                <TextBlock Text="{ext:Translate SetGamepadDeadZoneWindow_The_dead_zone_is_the_amount_of_stick_mov}"
                           TextWrapping="Wrap" Margin="5" />
                <TextBlock Text="{ext:Translate SetGamepadDeadZoneWindow_Higher_values_larger_dead_zone_more_stic}"
                           TextWrapping="Wrap" Margin="5" />
                <TextBlock Text="{ext:Translate SetGamepadDeadZoneWindow_Lower_values_smaller_dead_zone_stick_res}"
                           TextWrapping="Wrap" Margin="5" />
                <TextBlock Text="{ext:Translate SetGamepadDeadZoneWindow_Setting_it_too_low_may_cause_stick_drift}"
                           TextWrapping="Wrap" Margin="5" />
                <TextBlock Text="{ext:Translate SetGamepadDeadZoneWindow_Setting_it_too_high_may_make_aiming_and_}"
                           TextWrapping="Wrap" Margin="5" />
            </StackPanel>
        </GroupBox>

        <!-- DeadZoneX -->
        <TextBlock Grid.Row="2" Grid.Column="0"
                   Classes="form-label" Margin="10"
                   Text="{ext:Translate SetGamepadDeadZoneWindow_Dead_Zone_X}" />
        <Slider Grid.Row="2" Grid.Column="1"
                Margin="10"
                Width="150"
                Minimum="0"
                Maximum="0.3"
                SmallChange="0.01"
                LargeChange="0.05"
                TickFrequency="0.01"
                HorizontalAlignment="Center"
                IsSnapToTickEnabled="True"
                Value="{Binding DeadZoneX}"
                AutomationProperties.Name="{ext:Translate SetGamepadDeadZoneWindow_Dead_Zone_X}" />
        <TextBlock Grid.Row="2" Grid.Column="2"
                   Margin="10"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"
                   Text="{Binding DeadZoneXText}" />

        <!-- DeadZoneY -->
        <TextBlock Grid.Row="3" Grid.Column="0"
                   Classes="form-label" Margin="10"
                   Text="{ext:Translate SetGamepadDeadZoneWindow_Dead_Zone_Y}" />
        <Slider Grid.Row="3" Grid.Column="1"
                Margin="10"
                Width="150"
                Minimum="0"
                Maximum="0.3"
                SmallChange="0.01"
                LargeChange="0.05"
                TickFrequency="0.01"
                HorizontalAlignment="Center"
                IsSnapToTickEnabled="True"
                Value="{Binding DeadZoneY}"
                AutomationProperties.Name="{ext:Translate SetGamepadDeadZoneWindow_Dead_Zone_Y}" />
        <TextBlock Grid.Row="3" Grid.Column="2"
                   Margin="10"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"
                   Text="{Binding DeadZoneYText}" />

        <Grid Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <!-- Save Button -->
                <Button Classes="primary"
                        Margin="0,20,5,10"
                        Padding="10"
                        Command="{Binding SaveCommand}"
                        Content="{ext:Translate SetGamepadDeadZoneWindow_Save_Dead_Zone}"
                        AutomationProperties.Name="{ext:Translate SetGamepadDeadZoneWindow_Save_Dead_Zone}" />
                <!-- Revert Button -->
                <Button Classes="secondary"
                        Margin="5,20,0,10"
                        Padding="10"
                        Command="{Binding RevertCommand}"
                        Content="{ext:Translate ReverttoDefaultValues}"
                        AutomationProperties.Name="{ext:Translate ReverttoDefaultValues}" />
                <!-- Cancel Button -->
                <Button Classes="secondary"
                        Margin="5,20,0,10"
                        Command="{Binding CancelCommand}"
                        Content="{ext:Translate YumirConfig_Cancel_Button}" IsCancel="True"
                        AutomationProperties.Name="{ext:Translate YumirConfig_Cancel_Button}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>