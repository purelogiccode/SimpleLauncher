<Window x:Class="SimpleLauncher.Avalonia.SetLinksWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:ext="using:SimpleLauncher.Avalonia.Extensions"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{ext:Translate EditLinks}"
        Width="600" MinWidth="600"
        Height="270"
        CanResize="False"
        WindowStartupLocation="CenterScreen">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="Auto,Auto,*">

        <!-- Explanation -->
        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                   Margin="10,20,10,10"
                   Text="{ext:Translate SetLinksWindow_You_can_define_custom_URLs_that_will_be_}"
                   TextWrapping="Wrap" />

        <!-- Video Link -->
        <TextBlock Grid.Row="1" Grid.Column="0"
                   Classes="form-label" Margin="10"
                   Text="{ext:Translate VideoLinkButton}" />
        <Image Grid.Row="1" Grid.Column="1"
               Width="22" Height="22"
               VerticalAlignment="Center"
               HorizontalAlignment="Left"
               Source="{Binding VideoIconPath, Converter={StaticResource PathToImage}}" />
        <TextBox Grid.Row="1" Grid.Column="2"
                 Margin="10"
                 HorizontalAlignment="Stretch"
                 Text="{Binding VideoUrl}"
                 AutomationProperties.Name="{ext:Translate VideoLinkButton}" />

        <!-- Info Link -->
        <TextBlock Grid.Row="2" Grid.Column="0"
                   Classes="form-label" Margin="10"
                   Text="{ext:Translate InfoLinkButton}" />
        <Image Grid.Row="2" Grid.Column="1"
               Width="22" Height="22"
               VerticalAlignment="Center"
               HorizontalAlignment="Left"
               Source="{Binding InfoIconPath, Converter={StaticResource PathToImage}}" />
        <TextBox Grid.Row="2" Grid.Column="2"
                 Margin="10"
                 Text="{Binding InfoUrl}"
                 AutomationProperties.Name="{ext:Translate InfoLinkButton}" />

        <Grid Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3"
              ColumnDefinitions="*,*,*">
            <!-- Save Button -->
            <Button Grid.Column="0"
                    Classes="primary"
                    Margin="10"
                    Padding="10"
                    HorizontalAlignment="Right"
                    IsDefault="True"
                    Command="{Binding SaveCommand}"
                    Content="{ext:Translate SetLinksWindow_Save_Update_Links}"
                    AutomationProperties.Name="{ext:Translate SetLinksWindow_Save_Update_Links}" />
            <!-- Revert Button -->
            <Button Grid.Column="1"
                    Classes="secondary"
                    Margin="10"
                    Padding="10"
                    HorizontalAlignment="Center"
                    Command="{Binding RevertCommand}"
                    Content="{ext:Translate ReverttoDefaultValues}"
                    AutomationProperties.Name="{ext:Translate ReverttoDefaultValues}" />
            <!-- Cancel Button -->
            <Button Grid.Column="2"
                    Classes="secondary"
                    Margin="10"
                    HorizontalAlignment="Left"
                    Command="{Binding CancelCommand}"
                    Content="{ext:Translate YumirConfig_Cancel_Button}" IsCancel="True"
                    AutomationProperties.Name="{ext:Translate YumirConfig_Cancel_Button}" />
        </Grid>
    </Grid>
</Window>