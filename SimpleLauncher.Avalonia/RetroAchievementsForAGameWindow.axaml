<Window x:Class="SimpleLauncher.Avalonia.RetroAchievementsForAGameWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:SimpleLauncher.Avalonia.Controls"
        xmlns:ext="using:SimpleLauncher.Avalonia.Extensions"
        xmlns:models="using:SimpleLauncher.Core.Models"
        xmlns:local="using:SimpleLauncher.Avalonia.Models"
        Title="{ext:Translate RetroAchievements}"
        WindowState="Maximized"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgPrimaryBrush}">

    <Grid RowDefinitions="Auto,*">

        <!-- Header Section: Game Cover, Title, Console -->
        <Border Grid.Row="0" Margin="10" Padding="15"
                BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="5">
            <StackPanel Orientation="Horizontal">
                <controls:RemoteImage x:Name="GameCoverImage" Width="80" Height="80" Stretch="Uniform"
                                      Margin="0,0,15,0" ToolTip.Tip="{ext:Translate TooltipGameCoverImage}" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="GameTitleTextBlock" FontSize="24" FontWeight="Bold"
                               Text="{ext:Translate GameTitle}"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock x:Name="ConsoleNameTextBlock" FontSize="16" Margin="0,5,0,0"
                               Text="{ext:Translate ConsoleName}"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <TabControl x:Name="TabControl" Grid.Row="1" Margin="10,0,10,10" SelectionChanged="TabControl_SelectionChanged">

            <!-- Tab 1: Achievements -->
            <TabItem Header="{ext:Translate AchievementsTab}" Tag="Achievements">
                <Grid RowDefinitions="Auto,*">
                    <!-- Progress Summary Header -->
                    <Border Grid.Row="0" Margin="10,10,10,0" Padding="15"
                            BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="5">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                                <TextBlock x:Name="GameProgressTitle" FontSize="20" FontWeight="Bold"
                                           Margin="0,0,10,0" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock x:Name="GameProgressConsole" FontStyle="Italic" VerticalAlignment="Bottom"
                                           FontSize="16" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>

                            <!-- Completion Progress Bars -->
                            <Grid Margin="0,15,0,10" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="{ext:Translate CasualProgress}"
                                           FontWeight="Bold"
                                           Margin="0,0,0,5" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <ProgressBar Grid.Row="1" Grid.Column="0" x:Name="CasualProgressbar" Height="20"
                                             Margin="0,0,10,0" Minimum="0" Maximum="100"
                                             AutomationProperties.Name="{ext:Translate CasualProgress}" />
                                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="CasualProgressText"
                                           VerticalAlignment="Center" FontWeight="Bold" Width="60"
                                           TextAlignment="Right" Foreground="{DynamicResource TextPrimaryBrush}" />
                            </Grid>

                            <Grid Margin="0,0,0,10" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="{ext:Translate HardcoreProgress}"
                                           FontWeight="Bold"
                                           Margin="0,0,0,5" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <ProgressBar Grid.Row="1" Grid.Column="0" x:Name="HardcoreProgressbar" Height="20"
                                             Margin="0,0,10,0" Minimum="0" Maximum="100"
                                             AutomationProperties.Name="{ext:Translate HardcoreProgress}" />
                                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="HardcoreProgressText"
                                           VerticalAlignment="Center" FontWeight="Bold" Width="60"
                                           TextAlignment="Right" Foreground="{DynamicResource TextPrimaryBrush}" />
                            </Grid>

                            <!-- Achievement Stats -->
                            <Grid Margin="0,10,0,0" ColumnDefinitions="*,*,*,*">
                                <Border Grid.Column="0" BorderBrush="{DynamicResource BorderNormalBrush}"
                                        BorderThickness="1" Padding="10" Margin="0,0,5,0" CornerRadius="3">
                                    <StackPanel>
                                        <TextBlock x:Name="EarnedAchievementsValue" FontSize="18" FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource AccentBrush}" />
                                        <TextBlock Text="{ext:Translate AchievementsEarned}"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" BorderBrush="{DynamicResource BorderNormalBrush}"
                                        BorderThickness="1" Padding="10" Margin="5,0,5,0" CornerRadius="3">
                                    <StackPanel>
                                        <TextBlock x:Name="TotalAchievementsValue" FontSize="18" FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource AccentBrush}" />
                                        <TextBlock Text="{ext:Translate TotalAchievements}"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" BorderBrush="{DynamicResource BorderNormalBrush}"
                                        BorderThickness="1" Padding="10" Margin="5,0,5,0" CornerRadius="3">
                                    <StackPanel>
                                        <TextBlock x:Name="TotalPointsEarnedValue" FontSize="18" FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource AccentBrush}" />
                                        <TextBlock Text="{ext:Translate TotalPointsEarned}"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="3" BorderBrush="{DynamicResource BorderNormalBrush}"
                                        BorderThickness="1" Padding="10" Margin="5,0,0,0" CornerRadius="3">
                                    <StackPanel>
                                        <TextBlock x:Name="TruePointsEarnedValue" FontSize="18" FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource AccentBrush}" />
                                        <TextBlock Text="{ext:Translate TruePointsEarned}" HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Highest Award Info -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                                <TextBlock Text="{ext:Translate HighestAward}" FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14"
                                           Margin="0,0,10,0" />
                                <Image x:Name="HighestAwardIcon"
                                       Source="avares://SimpleLauncher.Avalonia/images/trophy.png"
                                       Width="20" Height="20"
                                       Margin="0,0,5,0" VerticalAlignment="Center" IsVisible="False" />
                                <TextBlock x:Name="HighestAwardKindText" FontWeight="Bold"
                                           Foreground="{DynamicResource SelectionBackgroundBrush}" FontSize="14" />
                                <TextBlock Text="{ext:Translate AwardOn}" FontWeight="Bold" Margin="5,0,5,0"
                                           Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" />
                                <TextBlock x:Name="HighestAwardDateText" FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Achievements DataGrid -->
                    <Grid Grid.Row="1" Margin="10,10,10,10">
                        <DataGrid x:Name="AchievementsDataGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  Background="{DynamicResource BgSecondaryBrush}"
                                  BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                                  ToolTip.Tip="{ext:Translate TooltipAchievementsDataGrid}"
                                  AutomationProperties.Name="{ext:Translate TooltipAchievementsDataGrid}">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="{ext:Translate HeaderIcon}" Width="Auto">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="local:RaAchievement">
                                            <controls:RemoteImage Url="{Binding BadgeUri}" Width="40" Height="40"
                                                                  Margin="5" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="{ext:Translate HeaderTitle}" Binding="{Binding Title}"
                                                    Width="*" SortMemberPath="Title" />
                                <DataGridTextColumn Header="{ext:Translate HeaderDescription}"
                                                    Binding="{Binding Description}" Width="2*"
                                                    SortMemberPath="Description" />
                                <DataGridTextColumn Header="{ext:Translate HeaderPoints}" Binding="{Binding Points}"
                                                    Width="Auto"
                                                    SortMemberPath="Points" />
                                <DataGridTextColumn Header="{ext:Translate HeaderTrueRatio}"
                                                    Binding="{Binding TrueRatio, StringFormat='{}{0}%'}"
                                                    Width="Auto" SortMemberPath="TrueRatio" />
                                <DataGridTextColumn Header="{ext:Translate HeaderUnlocked}"
                                                    Binding="{Binding DateUnlockedDisplay}" Width="Auto"
                                                    SortMemberPath="DateUnlocked" />
                                <DataGridTextColumn Header="{ext:Translate HeaderMode}" Binding="{Binding ModeDisplay}"
                                                    Width="Auto"
                                                    SortMemberPath="UnlockedInHardcore" />
                                <DataGridTextColumn Header="{ext:Translate HeaderRarity}"
                                                    Binding="{Binding RarityDisplay}" Width="Auto"
                                                    SortMemberPath="NumAwardedHardcore" />
                                <DataGridTextColumn Header="{ext:Translate HeaderAuthor}"
                                                    Binding="{Binding AuthorDisplay}" Width="Auto"
                                                    SortMemberPath="Author" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <Grid x:Name="NoAchievementsOverlay" Background="{DynamicResource BgPrimaryBrush}"
                              IsVisible="False">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock x:Name="NoAchievementsMessage" Text="{ext:Translate NoAchievementsFound}"
                                           VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="18"
                                           Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"
                                           TextAlignment="Center" />
                                <Button Content="{ext:Translate OpenRaSettings}" Margin="0,15,0,0"
                                        Classes="primary" Click="OpenRaSettings_Click"
                                        ToolTip.Tip="{ext:Translate OpenRetroAchievementsSettings}"
                                        AutomationProperties.Name="{ext:Translate OpenRetroAchievementsSettings}" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- Tab 2: Game Info -->
            <TabItem Header="{ext:Translate GameInfoTab}" Tag="GameInfo">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="10">
                    <StackPanel>
                        <!-- Game Images Section -->
                        <TextBlock Text="{ext:Translate GameImages}" FontWeight="Bold" FontSize="18" Margin="0,0,0,15"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <Grid Margin="0,0,0,25" ColumnDefinitions="*,*,*,*">
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="{ext:Translate Icon}" FontSize="14" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <Border BorderBrush="{DynamicResource BorderNormalBrush}" BorderThickness="1"
                                        Margin="0,5,0,0" HorizontalAlignment="Center">
                                    <controls:RemoteImage x:Name="GameInfoImageIcon" Width="150" Height="112.5"
                                                          Stretch="Uniform" PointerPressed="GameImage_PointerPressed"
                                                          ToolTip.Tip="{ext:Translate ClickToViewFullSize}" />
                                </Border>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="10,0,10,0">
                                <TextBlock Text="{ext:Translate TitleScreen}" FontSize="14"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <Border BorderBrush="{DynamicResource BorderNormalBrush}" BorderThickness="1"
                                        Margin="0,5,0,0" HorizontalAlignment="Center">
                                    <controls:RemoteImage x:Name="GameInfoTitleImage" Width="150" Height="112.5"
                                                          Stretch="Uniform" PointerPressed="GameImage_PointerPressed"
                                                          ToolTip.Tip="{ext:Translate ClickToViewFullSize}" />
                                </Border>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="10,0,10,0">
                                <TextBlock Text="{ext:Translate InGame}" FontSize="14" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <Border BorderBrush="{DynamicResource BorderNormalBrush}" BorderThickness="1"
                                        Margin="0,5,0,0" HorizontalAlignment="Center">
                                    <controls:RemoteImage x:Name="GameInfoIngameImage" Width="150" Height="112.5"
                                                          Stretch="Uniform" PointerPressed="GameImage_PointerPressed"
                                                          ToolTip.Tip="{ext:Translate ClickToViewFullSize}" />
                                </Border>
                            </StackPanel>
                            <StackPanel Grid.Column="3" Margin="10,0,0,0">
                                <TextBlock Text="{ext:Translate BoxArt}" FontSize="14" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <Border BorderBrush="{DynamicResource BorderNormalBrush}" BorderThickness="1"
                                        Margin="0,5,0,0" HorizontalAlignment="Center">
                                    <controls:RemoteImage x:Name="GameInfoBoxArtImage" Width="150" Height="112.5"
                                                          Stretch="Uniform" PointerPressed="GameImage_PointerPressed"
                                                          ToolTip.Tip="{ext:Translate ClickToViewFullSize}" />
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Game Details Grid -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <TextBlock Text="{ext:Translate GameDetails}" FontWeight="Bold" FontSize="18"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <Button x:Name="ViewGameOnRaButton" Content="{ext:Translate ViewOnRetroAchievements}"
                                    Classes="primary" Click="ViewGameOnRaButton_Click" Margin="15,0,0,0"
                                    ToolTip.Tip="{ext:Translate ViewGameOnRetroAchievementsTooltip}"
                                    AutomationProperties.Name="{ext:Translate ViewGameOnRetroAchievementsTooltip}" />
                        </StackPanel>
                        <Grid Margin="0,0,0,25" ColumnDefinitions="Auto,*,Auto,*"
                              RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{ext:Translate Genre}" FontWeight="Bold"
                                       Margin="0,0,10,8" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="GameInfoGenre" Margin="0,0,20,8"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="{ext:Translate Released}" FontWeight="Bold"
                                       Margin="0,0,10,8" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Grid.Row="0" Grid.Column="3" x:Name="GameInfoReleased" Margin="0,0,0,8"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{ext:Translate Developer}" FontWeight="Bold"
                                       Margin="0,0,10,8" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="GameInfoDeveloper" Margin="0,0,20,8"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="{ext:Translate Publisher}" FontWeight="Bold"
                                       Margin="0,0,10,8" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Grid.Row="1" Grid.Column="3" x:Name="GameInfoPublisher" Margin="0,0,0,8"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{ext:Translate Players}" FontWeight="Bold"
                                       Margin="0,0,10,8" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="GameInfoPlayers" Margin="0,0,20,8"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="{ext:Translate HeaderAchievements}"
                                       FontWeight="Bold"
                                       Margin="0,0,10,8" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Grid.Row="2" Grid.Column="3" x:Name="GameInfoAchievementCount" Margin="0,0,0,8"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="{ext:Translate Console}" FontWeight="Bold"
                                       Margin="0,0,10,8" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="GameInfoConsoleName" Margin="0,0,20,8"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Grid.Row="3" Grid.Column="2" Text="{ext:Translate Updated}" FontWeight="Bold"
                                       Margin="0,0,10,8" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Grid.Row="3" Grid.Column="3" x:Name="GameInfoUpdated" Margin="0,0,0,8"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="{ext:Translate ConsoleID}" FontWeight="Bold"
                                       Margin="0,0,10,8" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Grid.Row="4" Grid.Column="1" x:Name="GameInfoConsoleId" Margin="0,0,20,8"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Grid.Row="4" Grid.Column="2" Text="{ext:Translate GameID}" FontWeight="Bold"
                                       Margin="0,0,10,8" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Grid.Row="4" Grid.Column="3" x:Name="GameInfoId" Margin="0,0,0,8"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="{ext:Translate ParentGame}" FontWeight="Bold"
                                       Margin="0,0,10,8" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Grid.Row="5" Grid.Column="1" x:Name="GameInfoParentGame" Margin="0,0,20,8"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Grid.Row="5" Grid.Column="2" Text="{ext:Translate ForumTopic}" FontWeight="Bold"
                                       Margin="0,0,10,8" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Grid.Row="5" Grid.Column="3" x:Name="GameInfoForumTopic" Margin="0,0,0,8"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />

                            <TextBlock Grid.Row="6" Grid.Column="0" Text="{ext:Translate ReleaseGranularity}"
                                       FontWeight="Bold"
                                       Margin="0,0,10,8" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="3"
                                       x:Name="GameInfoReleaseGranularity"
                                       Margin="0,0,0,8" Foreground="{DynamicResource TextPrimaryBrush}" />

                            <TextBlock Grid.Row="7" Grid.Column="0" Text="{ext:Translate GuideURL}" FontWeight="Bold"
                                       Margin="0,0,10,8" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="3" x:Name="GameInfoGuideUrl"
                                       Margin="0,0,0,8" Foreground="{DynamicResource TextPrimaryBrush}" />
                        </Grid>

                        <!-- Statistics Section -->
                        <TextBlock Text="{ext:Translate PlayerStatistics}" FontWeight="Bold" FontSize="18"
                                   Margin="0,0,0,15"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <Grid Margin="0,0,0,25" ColumnDefinitions="*,*,*">
                            <Border Grid.Column="0" BorderBrush="{DynamicResource BorderNormalBrush}"
                                    BorderThickness="1" Padding="10" Margin="0,0,5,0" CornerRadius="3">
                                <StackPanel>
                                    <TextBlock x:Name="DistinctPlayersValue" FontSize="18" FontWeight="Bold"
                                               HorizontalAlignment="Center" Foreground="{DynamicResource AccentBrush}" />
                                    <TextBlock Text="{ext:Translate TotalPlayers}" HorizontalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" BorderBrush="{DynamicResource BorderNormalBrush}"
                                    BorderThickness="1" Padding="10" Margin="5,0,5,0" CornerRadius="3">
                                <StackPanel>
                                    <TextBlock x:Name="CasualPlayersValue" FontSize="18" FontWeight="Bold"
                                               HorizontalAlignment="Center" Foreground="{DynamicResource AccentBrush}" />
                                    <TextBlock Text="{ext:Translate CasualPlayers}" HorizontalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" BorderBrush="{DynamicResource BorderNormalBrush}"
                                    BorderThickness="1" Padding="10" Margin="5,0,0,0" CornerRadius="3">
                                <StackPanel>
                                    <TextBlock x:Name="HardcorePlayersValue" FontSize="18" FontWeight="Bold"
                                               HorizontalAlignment="Center" Foreground="{DynamicResource AccentBrush}" />
                                    <TextBlock Text="{ext:Translate HardcorePlayers}" HorizontalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Claims Section -->
                        <TextBlock Text="{ext:Translate DevelopmentClaims}" FontWeight="Bold" FontSize="18"
                                   Margin="0,0,0,15"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock x:Name="GameInfoClaims" TextWrapping="Wrap" Margin="0,0,0,20"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />

                        <!-- Achievements List Section -->
                        <StackPanel x:Name="GameInfoAchievementsSection" IsVisible="False">
                            <TextBlock Text="{ext:Translate AchievementsList}" FontWeight="Bold" FontSize="18"
                                       Margin="0,25,0,15"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <DataGrid x:Name="GameInfoAchievementsDataGrid" AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      Margin="0,0,0,20" HeadersVisibility="Column"
                                      Background="{DynamicResource BgSecondaryBrush}"
                                      BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" MaxHeight="400"
                                      ToolTip.Tip="{ext:Translate TooltipGameInfoAchievementsDataGrid}"
                                      AutomationProperties.Name="{ext:Translate TooltipGameInfoAchievementsDataGrid}">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="{ext:Translate HeaderIcon}" Width="Auto">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate x:DataType="local:RaAchievement">
                                                <controls:RemoteImage Url="{Binding BadgeUri}" Width="40" Height="40"
                                                                      Margin="5" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="{ext:Translate HeaderTitle}" Binding="{Binding Title}"
                                                        Width="*" SortMemberPath="Title" />
                                    <DataGridTextColumn Header="{ext:Translate HeaderDescription}"
                                                        Binding="{Binding Description}" Width="2*"
                                                        SortMemberPath="Description" />
                                    <DataGridTextColumn Header="{ext:Translate HeaderPoints}"
                                                        Binding="{Binding Points}" Width="Auto"
                                                        SortMemberPath="Points" />
                                    <DataGridTextColumn Header="{ext:Translate HeaderTrueRatio}"
                                                        Binding="{Binding TrueRatio, StringFormat='{}{0}%'}"
                                                        Width="Auto" SortMemberPath="TrueRatio" />
                                    <DataGridTextColumn Header="{ext:Translate HeaderAuthor}"
                                                        Binding="{Binding AuthorDisplay}" Width="Auto"
                                                        SortMemberPath="Author" />
                                    <DataGridTextColumn Header="{ext:Translate HeaderCreated}"
                                                        Binding="{Binding DateCreated}" Width="Auto"
                                                        SortMemberPath="DateCreated" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>

                        <!-- No Data Overlay -->
                        <Grid x:Name="NoGameInfoOverlay" Background="{DynamicResource BgPrimaryBrush}"
                              IsVisible="False">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock x:Name="NoGameInfoMessage" Text="{ext:Translate NoGameInfoAvailable}"
                                           VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="18"
                                           Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"
                                           TextAlignment="Center" />
                                <Button Content="{ext:Translate OpenRaSettings}" Margin="0,15,0,0"
                                        Classes="primary" Click="OpenRaSettings_Click"
                                        ToolTip.Tip="{ext:Translate OpenRetroAchievementsSettings}"
                                        AutomationProperties.Name="{ext:Translate OpenRetroAchievementsSettings}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Tab 3: Game Ranking -->
            <TabItem Header="{ext:Translate GameRankingTab}" Tag="GameRanking">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="10">
                    <StackPanel>
                        <!-- Your Rank and Score Section -->
                        <TextBlock Text="{ext:Translate YourRankAndScore}" FontWeight="Bold" FontSize="18"
                                   Margin="0,0,0,15"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <Grid Margin="0,0,0,25" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{ext:Translate Rank}" FontWeight="Bold"
                                       Margin="0,0,10,8" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="UserRankText" Margin="0,0,0,8"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{ext:Translate Score}" FontWeight="Bold"
                                       Margin="0,0,10,8" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="UserScoreText" Margin="0,0,0,8"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{ext:Translate LastAward}" FontWeight="Bold"
                                       Margin="0,0,10,8" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="UserLastAwardText" Margin="0,0,0,8"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />

                            <Grid Grid.Row="0" Grid.Column="0" Grid.RowSpan="3" Grid.ColumnSpan="2"
                                  x:Name="NoUserRankOverlay" Background="{DynamicResource BgPrimaryBrush}"
                                  IsVisible="False">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock x:Name="NoUserRankMessage" Text="{ext:Translate NoRankData}"
                                               VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="16"
                                               Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"
                                               TextAlignment="Center" />
                                    <Button Content="{ext:Translate OpenRaSettings}" Margin="0,15,0,0"
                                            Classes="primary" Click="OpenRaSettings_Click"
                                            ToolTip.Tip="{ext:Translate OpenRetroAchievementsSettings}"
                                        AutomationProperties.Name="{ext:Translate OpenRetroAchievementsSettings}" />
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <!-- Latest Masters Section -->
                        <TextBlock Text="{ext:Translate LatestMasters}" FontWeight="Bold" FontSize="18"
                                   Margin="0,0,0,15"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <DataGrid x:Name="LatestMastersDataGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                  Margin="0,0,0,20" HeadersVisibility="Column"
                                  Background="{DynamicResource BgSecondaryBrush}"
                                  BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                                  ToolTip.Tip="{ext:Translate TooltipLatestMastersDataGrid}"
                                  AutomationProperties.Name="{ext:Translate TooltipLatestMastersDataGrid}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{ext:Translate HeaderRank}" Binding="{Binding Rank}"
                                                    Width="Auto"
                                                    SortMemberPath="Rank" />
                                <DataGridTextColumn Header="{ext:Translate HeaderUser}" Binding="{Binding User}"
                                                    Width="*" SortMemberPath="User" />
                                <DataGridTextColumn Header="{ext:Translate HeaderScore}" Binding="{Binding Score}"
                                                    Width="Auto"
                                                    SortMemberPath="Score" />
                                <DataGridTextColumn Header="{ext:Translate HeaderTrueRatio}"
                                                    Binding="{Binding TrueRatio, StringFormat='{}{0}%'}"
                                                    Width="Auto" SortMemberPath="TrueRatio" />
                                <DataGridTextColumn Header="{ext:Translate HeaderAchievements}"
                                                    Binding="{Binding NumAchievements}" Width="Auto"
                                                    SortMemberPath="NumAchievements" />
                                <DataGridTextColumn Header="{ext:Translate HeaderLastAward}"
                                                    Binding="{Binding LastAward}" Width="Auto"
                                                    SortMemberPath="LastAward" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <Grid x:Name="NoLatestMastersOverlay" Background="{DynamicResource BgPrimaryBrush}"
                              IsVisible="False">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock x:Name="NoLatestMastersMessage" Text="{ext:Translate NoLatestMasters}"
                                           VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="18"
                                           Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"
                                           TextAlignment="Center" />
                                <Button Content="{ext:Translate OpenRaSettings}" Margin="0,15,0,0"
                                        Classes="primary" Click="OpenRaSettings_Click"
                                        ToolTip.Tip="{ext:Translate OpenRetroAchievementsSettings}"
                                        AutomationProperties.Name="{ext:Translate OpenRetroAchievementsSettings}" />
                            </StackPanel>
                        </Grid>

                        <!-- High Scores Section -->
                        <TextBlock Text="{ext:Translate HighScores}" FontWeight="Bold" FontSize="18" Margin="0,20,0,15"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <DataGrid x:Name="HighScoresDataGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                  Margin="0,0,0,10" HeadersVisibility="Column"
                                  Background="{DynamicResource BgSecondaryBrush}"
                                  BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                                  ToolTip.Tip="{ext:Translate TooltipHighScoresDataGrid}"
                                  AutomationProperties.Name="{ext:Translate TooltipHighScoresDataGrid}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{ext:Translate HeaderRank}" Binding="{Binding Rank}"
                                                    Width="Auto"
                                                    SortMemberPath="Rank" />
                                <DataGridTextColumn Header="{ext:Translate HeaderUser}" Binding="{Binding User}"
                                                    Width="*" SortMemberPath="User" />
                                <DataGridTextColumn Header="{ext:Translate HeaderScore}" Binding="{Binding Score}"
                                                    Width="Auto"
                                                    SortMemberPath="Score" />
                                <DataGridTextColumn Header="{ext:Translate HeaderTrueRatio}"
                                                    Binding="{Binding TrueRatio, StringFormat='{}{0}%'}"
                                                    Width="Auto" SortMemberPath="TrueRatio" />
                                <DataGridTextColumn Header="{ext:Translate HeaderAchievements}"
                                                    Binding="{Binding NumAchievements}" Width="Auto"
                                                    SortMemberPath="NumAchievements" />
                                <DataGridTextColumn Header="{ext:Translate HeaderLastAward}"
                                                    Binding="{Binding LastAward}" Width="Auto"
                                                    SortMemberPath="LastAward" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <Grid x:Name="NoHighScoresOverlay" Background="{DynamicResource BgPrimaryBrush}"
                              IsVisible="False">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock x:Name="NoHighScoresMessage" Text="{ext:Translate NoHighScores}"
                                           VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="18"
                                           Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"
                                           TextAlignment="Center" />
                                <Button Content="{ext:Translate OpenRaSettings}" Margin="0,15,0,0"
                                        Classes="primary" Click="OpenRaSettings_Click"
                                        ToolTip.Tip="{ext:Translate OpenRetroAchievementsSettings}"
                                        AutomationProperties.Name="{ext:Translate OpenRetroAchievementsSettings}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Tab 4: My Profile -->
            <TabItem Header="{ext:Translate MyProfileTab}" Tag="MyProfile">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="10">
                    <Grid>
                        <StackPanel x:Name="UserProfilePanel">
                            <!-- User Header with Avatar -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                <Border BorderBrush="{DynamicResource BorderNormalBrush}" BorderThickness="1"
                                        Width="90" Height="90" CornerRadius="5">
                                    <controls:RemoteImage x:Name="UserProfilePic" Stretch="Uniform" />
                                </Border>
                                <StackPanel VerticalAlignment="Center" Margin="15,0,0,0">
                                    <TextBlock x:Name="UserProfileUser" FontSize="22" FontWeight="Bold"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock x:Name="UserProfileMotto" FontStyle="Italic" TextWrapping="Wrap"
                                               Margin="0,5,0,0" FontSize="14"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <Button x:Name="ViewProfileOnRaButton" Content="{ext:Translate ViewProfileOnRA}"
                                            Classes="primary" Click="ViewProfileOnRaButton_Click" Margin="0,10,0,0"
                                            ToolTip.Tip="{ext:Translate ViewProfileOnRetroAchievementsTooltip}"
                                            AutomationProperties.Name="{ext:Translate ViewProfileOnRetroAchievementsTooltip}" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Current Activity -->
                            <Border Background="{DynamicResource AccentBrush}" Margin="0,0,0,20" Padding="15"
                                    CornerRadius="5">
                                <StackPanel>
                                    <TextBlock Text="{ext:Translate CurrentlyPlaying}" FontWeight="Bold"
                                               Foreground="White" FontSize="16" />
                                    <TextBlock x:Name="UserProfileRichPresence" TextWrapping="Wrap"
                                               Foreground="White" Margin="0,5,0,0" FontSize="14" />
                                </StackPanel>
                            </Border>

                            <!-- User Statistics Grid -->
                            <Grid Margin="0,0,0,25" ColumnDefinitions="*,*,*">
                                <Border Grid.Column="0" BorderBrush="{DynamicResource BorderNormalBrush}"
                                        BorderThickness="1" Padding="10" Margin="0,0,5,0" CornerRadius="3">
                                    <StackPanel>
                                        <TextBlock x:Name="PointsValue" FontSize="18" FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource AccentBrush}" />
                                        <TextBlock Text="{ext:Translate Points}" HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" BorderBrush="{DynamicResource BorderNormalBrush}"
                                        BorderThickness="1" Padding="10" Margin="5,0,5,0" CornerRadius="3">
                                    <StackPanel>
                                        <TextBlock x:Name="TruePointsValue" FontSize="18" FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource AccentBrush}" />
                                        <TextBlock Text="{ext:Translate TruePoints}" HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" BorderBrush="{DynamicResource BorderNormalBrush}"
                                        BorderThickness="1" Padding="10" Margin="5,0,0,0" CornerRadius="3">
                                    <StackPanel>
                                        <TextBlock x:Name="RankValue" FontSize="18" FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource AccentBrush}" />
                                        <TextBlock Text="{ext:Translate Rank}" HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Detailed User Information -->
                            <TextBlock Text="{ext:Translate UserDetails}" FontWeight="Bold" FontSize="18"
                                       Margin="0,0,0,15"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <Grid Margin="0,0,0,25" ColumnDefinitions="Auto,*"
                                  RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="{ext:Translate MemberSince}"
                                           FontWeight="Bold"
                                           Margin="0,0,10,8" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="UserProfileMemberSince"
                                           Margin="0,0,0,8" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="{ext:Translate UserID}" FontWeight="Bold"
                                           Margin="0,0,10,8" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="UserProfileId"
                                           Margin="0,0,0,8" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="{ext:Translate Contributions}"
                                           FontWeight="Bold"
                                           Margin="0,0,10,8" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="UserProfileContributions"
                                           Margin="0,0,0,8" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="{ext:Translate SoftcorePoints}"
                                           FontWeight="Bold"
                                           Margin="0,0,10,8" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Grid.Row="3" Grid.Column="1" x:Name="UserProfileSoftcorePoints"
                                           Margin="0,0,0,8" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Grid.Row="4" Grid.Column="0" Text="{ext:Translate Permissions}"
                                           FontWeight="Bold"
                                           Margin="0,0,10,8" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Grid.Row="4" Grid.Column="1" x:Name="UserProfilePermissions"
                                           Margin="0,0,0,8" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Grid.Row="5" Grid.Column="0" Text="{ext:Translate Status}" FontWeight="Bold"
                                           Margin="0,0,10,8" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Grid.Row="5" Grid.Column="1" x:Name="UserProfileStatus"
                                           Margin="0,0,0,8" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Grid.Row="6" Grid.Column="0" Text="{ext:Translate ProfileID}"
                                           FontWeight="Bold"
                                           Margin="0,0,10,8" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Grid.Row="6" Grid.Column="1" x:Name="UserProfileProfileId"
                                           Margin="0,0,0,8" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Grid.Row="7" Grid.Column="0" Text="{ext:Translate WallActive}"
                                           FontWeight="Bold"
                                           Margin="0,0,10,8" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Grid.Row="7" Grid.Column="1" x:Name="UserProfileWallActive"
                                           Margin="0,0,0,8" Foreground="{DynamicResource TextPrimaryBrush}" />
                            </Grid>

                            <!-- Recently Played Section -->
                            <TextBlock Text="{ext:Translate RecentlyPlayedGames}" FontWeight="Bold" Margin="0,15,0,10"
                                       FontSize="18" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <ListBox x:Name="UserProfileRecentlyPlayed" BorderThickness="1"
                                     BorderBrush="{DynamicResource BorderNormalBrush}"
                                     Background="{DynamicResource BgSecondaryBrush}"
                                     AutomationProperties.Name="{ext:Translate RecentlyPlayedGames}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:RaRecentlyPlayedGame">
                                        <StackPanel Orientation="Horizontal" Margin="0,2">
                                            <controls:RemoteImage Url="{Binding GameIconUrl}"
                                                                  Width="40" Height="40" Stretch="Uniform"
                                                                  VerticalAlignment="Center" Margin="0,0,10,0" />
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip.Tip="{Binding Title}" />
                                                <TextBlock Text="{Binding ConsoleName}" FontSize="12"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip.Tip="{Binding ConsoleName}" Margin="0,2,0,0" />
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                    <TextBlock Text="{ext:Translate Casual}" FontSize="12" />
                                                    <TextBlock Text="{Binding ProgressDisplay}" FontSize="12"
                                                               ToolTip.Tip="{Binding ProgressDisplay}" />
                                                    <TextBlock Text="{ext:Translate Hardcore}" FontSize="12"
                                                               Margin="5,0,0,0" />
                                                    <TextBlock Text="{Binding HardcoreProgressDisplay}" FontSize="12"
                                                               ToolTip.Tip="{Binding HardcoreProgressDisplay}" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding LastPlayed}" FontSize="12"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip.Tip="{Binding LastPlayed}" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>

                        <Grid x:Name="NoProfileOverlay" Background="{DynamicResource BgPrimaryBrush}" IsVisible="False">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock x:Name="NoProfileMainMessage" Text="{ext:Translate NoProfileLoaded}"
                                           VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="18"
                                           TextWrapping="Wrap" TextAlignment="Center"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock x:Name="NoProfileSubMessage"
                                           Text="{ext:Translate CheckSettingsTryAgain}"
                                           VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="14"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,10,0,0" TextWrapping="Wrap" TextAlignment="Center" />
                                <Button Content="{ext:Translate OpenRaSettings}" Margin="0,15,0,0"
                                        Classes="primary" Click="OpenRaSettings_Click"
                                        ToolTip.Tip="{ext:Translate OpenRetroAchievementsSettings}"
                                        AutomationProperties.Name="{ext:Translate OpenRetroAchievementsSettings}" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- Tab 5: Unlocks -->
            <TabItem Header="{ext:Translate UnlocksTab}" Tag="Unlocks">
                <Grid RowDefinitions="Auto,Auto,*">
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10,15,10,15">
                        <TextBlock Text="{ext:Translate FromDate}" VerticalAlignment="Center" Margin="0,0,5,0"
                                   FontSize="14"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <DatePicker x:Name="FromDatePicker" Width="140"
                                    ToolTip.Tip="{ext:Translate FromDatePickerTooltip}"
                                    AutomationProperties.Name="{ext:Translate FromDatePickerTooltip}" />
                        <TextBlock Text="{ext:Translate ToDate}" VerticalAlignment="Center" Margin="15,0,5,0"
                                   FontSize="14"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <DatePicker x:Name="ToDatePicker" Width="140"
                                    ToolTip.Tip="{ext:Translate ToDatePickerTooltip}"
                                    AutomationProperties.Name="{ext:Translate ToDatePickerTooltip}" />
                        <Button Content="{ext:Translate FetchUnlocks}" Click="FetchUnlocksClickAsync" Margin="15,0,0,0"
                                Padding="10,5" x:Name="FetchUnlocksButton" Classes="primary"
                                ToolTip.Tip="{ext:Translate FetchUnlocksTooltip}"
                                AutomationProperties.Name="{ext:Translate FetchUnlocksTooltip}" />
                        <Button Content="{ext:Translate ResetDates}" Click="ResetDatesClickAsync" Margin="10,0,0,0"
                                Padding="10,5"
                                Classes="secondary" ToolTip.Tip="{ext:Translate ResetDatesTooltip}"
                                AutomationProperties.Name="{ext:Translate ResetDatesTooltip}" />
                    </StackPanel>

                    <Border Grid.Row="1" Margin="10,0,10,15" Padding="15"
                            BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="5">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="{ext:Translate TotalUnlocksInRange}" FontWeight="Bold" FontSize="16"
                                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,10,0" />
                                <TextBlock x:Name="TotalUnlocksInRangeText" FontWeight="Bold" FontSize="16"
                                           Foreground="{DynamicResource AccentBrush}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,0">
                                <TextBlock Text="{ext:Translate TotalPointsEarnedInRange}" FontWeight="Bold"
                                           FontSize="16"
                                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,10,0" />
                                <TextBlock x:Name="TotalPointsEarnedInRangeText" FontWeight="Bold" FontSize="16"
                                           Foreground="{DynamicResource AccentBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <DataGrid x:Name="UnlocksDataGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
                              Margin="10,0,10,10" HeadersVisibility="Column"
                              Background="{DynamicResource BgSecondaryBrush}"
                              BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                              ToolTip.Tip="{ext:Translate UnlocksDataGridTooltip}"
                              AutomationProperties.Name="{ext:Translate UnlocksDataGridTooltip}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="{ext:Translate HeaderGameIcon}" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="models:RaEarnedAchievement">
                                        <controls:RemoteImage Url="{Binding GameIconFullUrl}" Width="32" Height="32"
                                                              Margin="5" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="{ext:Translate HeaderGameTitle}" Binding="{Binding GameTitle}"
                                                Width="*" SortMemberPath="GameTitle" />
                            <DataGridTemplateColumn Header="{ext:Translate HeaderBadge}" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="models:RaEarnedAchievement">
                                        <controls:RemoteImage Url="{Binding BadgeFullUrl}" Width="32" Height="32"
                                                              Margin="5" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="{ext:Translate HeaderAchievement}" Binding="{Binding Title}"
                                                Width="2*" SortMemberPath="Title" />
                            <DataGridTextColumn Header="{ext:Translate HeaderPoints}" Binding="{Binding Points}"
                                                Width="Auto"
                                                SortMemberPath="Points" />
                            <DataGridTextColumn Header="{ext:Translate HeaderTrueRatio}"
                                                Binding="{Binding TrueRatio, StringFormat='{}{0}%'}"
                                                Width="Auto" SortMemberPath="TrueRatio" />
                            <DataGridTextColumn Header="{ext:Translate HeaderUnlockedDate}"
                                                Binding="{Binding UnlockedDateDisplay}" Width="Auto"
                                                SortMemberPath="UnlockedDate" />
                            <DataGridTextColumn Header="{ext:Translate HeaderMode}" Binding="{Binding ModeDisplay}"
                                                Width="Auto"
                                                SortMemberPath="ModeDisplay" />
                            <DataGridTextColumn Header="{ext:Translate HeaderConsole}" Binding="{Binding ConsoleName}"
                                                Width="Auto" SortMemberPath="ConsoleName" />
                            <DataGridTextColumn Header="{ext:Translate HeaderAuthor}" Binding="{Binding Author}"
                                                Width="Auto" SortMemberPath="Author" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <Grid x:Name="NoUnlocksOverlay" Grid.Row="2" Background="{DynamicResource BgPrimaryBrush}"
                          IsVisible="False">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock x:Name="NoUnlocksMessage" Text="{ext:Translate NoUnlocksFound}"
                                       VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="18"
                                       Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"
                                       TextAlignment="Center" />
                            <Button Content="{ext:Translate OpenRaSettings}" Margin="0,15,0,0"
                                    Classes="primary" Click="OpenRaSettings_Click"
                                    ToolTip.Tip="{ext:Translate OpenRetroAchievementsSettings}"
                                    AutomationProperties.Name="{ext:Translate OpenRetroAchievementsSettings}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- Tab 6: User Progress -->
            <TabItem Header="{ext:Translate UserProgressTab}" Tag="UserProgress">
                <Grid>
                    <DataGrid x:Name="UserProgressDataGrid" AutoGenerateColumns="False" IsReadOnly="True"
                              Margin="10" HeadersVisibility="Column"
                              Background="{DynamicResource BgSecondaryBrush}"
                              BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                              ToolTip.Tip="{ext:Translate UserProgressDataGridTooltip}"
                              AutomationProperties.Name="{ext:Translate UserProgressDataGridTooltip}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="{ext:Translate HeaderIcon}" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="models:RaUserCompletionGame">
                                        <controls:RemoteImage Url="{Binding ImageIcon}" Width="32" Height="32"
                                                              Margin="5" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="{ext:Translate HeaderGameTitle}" Binding="{Binding Title}"
                                                Width="2*" SortMemberPath="Title" />
                            <DataGridTextColumn Header="{ext:Translate HeaderConsole}" Binding="{Binding ConsoleName}"
                                                Width="*" SortMemberPath="ConsoleName" />
                            <DataGridTextColumn Header="{ext:Translate Casual}" Binding="{Binding CompletionDisplay}"
                                                Width="Auto"
                                                SortMemberPath="NumAwarded" />
                            <DataGridTextColumn Header="{ext:Translate Hardcore}"
                                                Binding="{Binding HardcoreCompletionDisplay}" Width="Auto"
                                                SortMemberPath="NumAwardedHardcore" />
                            <DataGridTextColumn Header="{ext:Translate MostRecentAward}"
                                                Binding="{Binding MostRecentAwardedDateDisplay}" Width="Auto"
                                                SortMemberPath="MostRecentAwardedDate" />
                            <DataGridTextColumn Header="{ext:Translate HeaderHighestAward}"
                                                Binding="{Binding HighestAwardKindDisplay}" Width="Auto"
                                                SortMemberPath="HighestAwardKind" />
                            <DataGridTextColumn Header="{ext:Translate HighestAwardDate}"
                                                Binding="{Binding HighestAwardDateDisplay}" Width="Auto"
                                                SortMemberPath="HighestAwardDate" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <Grid x:Name="NoUserProgressOverlay" Background="{DynamicResource BgPrimaryBrush}"
                          IsVisible="False">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock x:Name="NoUserProgressMainMessage" Text="{ext:Translate NoUserProgress}"
                                       VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="18"
                                       TextWrapping="Wrap" TextAlignment="Center"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock x:Name="NoUserProgressSubMessage"
                                       Text="{ext:Translate CheckSettingsTryAgain}"
                                       VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="14"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,10,0,0" TextWrapping="Wrap" TextAlignment="Center" />
                            <Button Content="{ext:Translate OpenRaSettings}" Margin="0,15,0,0"
                                    Classes="primary" Click="OpenRaSettings_Click"
                                    ToolTip.Tip="{ext:Translate OpenRetroAchievementsSettings}"
                                    AutomationProperties.Name="{ext:Translate OpenRetroAchievementsSettings}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Loading Overlay -->
        <Border Grid.Row="0" x:Name="LoadingOverlay" Background="{DynamicResource OverlayProcessingBrush}"
                IsVisible="False" ZIndex="10">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MinWidth="260">
                <ProgressBar IsIndeterminate="True" Width="220"
                             AutomationProperties.Name="Loading" />
                <TextBlock x:Name="LoadingOverlayMessage" Text="{ext:Translate Loading}" Margin="0,12,0,0"
                           HorizontalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" />
                <Button x:Name="EmergencyReturnButton" Content="{ext:Translate EditSystemWindow_Return}"
                        Margin="0,15,0,0"
                        Classes="secondary" Click="EmergencyOverlayRelease_Click"
                        AutomationProperties.Name="{ext:Translate EditSystemWindow_Return}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>