<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>net11.0;net11.0-windows</TargetFrameworks>
        <ImplicitUsings>enable</ImplicitUsings>
        <IsPackable>true</IsPackable>
        <Company>PureLogicCode.com</Company>
        <Product>Simple Launcher Core</Product>
        <LangVersion>15</LangVersion>
        <Nullable>enable</Nullable>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>

        <CopyDocumentationFileToOutputDirectory>false</CopyDocumentationFileToOutputDirectory>
        <!-- SDL2's generated bindings (Hexa.NET.SDL2) expose native pointers. -->
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <NeutralLanguage>en</NeutralLanguage>
        <DebugType>embedded</DebugType>
        <DebugSymbols>true</DebugSymbols>
        <RepositoryUrl>https://github.com/purelogiccode/SimpleLauncher</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <AssemblyVersion>5.9.2</AssemblyVersion>
        <FileVersion>5.9.2</FileVersion>
        <Version>5.9.2</Version>
        <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    </PropertyGroup>

    <ItemGroup>
        <Using Include="System.IO" />
        <Using Include="System.Net.Http" />
        <Using Include="Serilog" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\SimpleLauncher.Diagnostics\SimpleLauncher.Diagnostics.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="CHDSharp" Version="1.7.3" />
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
        <PackageReference Include="InputSimulatorCore" Version="1.0.5" />
        <PackageReference Include="Meziantou.Analyzer" Version="3.0.342">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="MessagePack" Version="3.1.12" />
        <PackageReference Include="NAudio.Alsa" Version="3.3.0" />
        <PackageReference Include="NAudio.SoundFile" Version="3.3.0" />
        <PackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="11.0.100">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.Data.Sqlite" Version="11.0.0" />
        <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="11.0.0" />
        <PackageReference Include="Microsoft.Extensions.Configuration" Version="11.0.0" />
        <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="11.0.0" />
        <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="11.0.0" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0" />
        <PackageReference Include="Microsoft.Extensions.Http" Version="11.0.0" />
        <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="11.0.1" />
        <PackageReference Include="NAudio.Core" Version="3.3.0" />
        <PackageReference Include="NAudio.Wasapi" Version="3.3.0" />
        <PackageReference Include="PBPSharp" Version="1.1.8" />
        <PackageReference Include="Roslynator.Analyzers" Version="5.0.1">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="SharpCompress" Version="0.50.12" />
        <PackageReference Include="SourceGear.sqlite3" Version="3.53.4" />
        <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="11.0.0" />
        <PackageReference Include="Tomlyn" Version="2.11.1" />
        <PackageReference Include="Serilog" Version="4.4.0" />
        <PackageReference Include="Serilog.Sinks.Async" Version="2.1.0" />
        <PackageReference Include="Serilog.Sinks.Debug" Version="3.0.0" />
        <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
        <PackageReference Include="YamlDotNet" Version="18.1.0" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="SharpDX" Version="4.2.0" />
        <PackageReference Include="SharpDX.DirectInput" Version="4.2.0" />
        <PackageReference Include="SharpDX.XInput" Version="4.2.0" />
    </ItemGroup>

    <ItemGroup>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
            <_Parameter1>SimpleLauncher.Tests</_Parameter1>
        </AssemblyAttribute>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
            <_Parameter1>SimpleLauncher</_Parameter1>
        </AssemblyAttribute>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
            <_Parameter1>SimpleLauncher.Avalonia</_Parameter1>
        </AssemblyAttribute>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
            <_Parameter1>SimpleLauncher.Avalonia.Tests</_Parameter1>
        </AssemblyAttribute>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
            <_Parameter1>SimpleLauncher.SlowTests</_Parameter1>
        </AssemblyAttribute>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
            <_Parameter1>SimpleLauncher.Avalonia.SlowTests</_Parameter1>
        </AssemblyAttribute>
    </ItemGroup>

    <!-- Linux/macOS gamepad input; the bindings bundle the native SDL2 binaries for the
         linux/osx/win RIDs (Windows keeps the SharpDX/XInput path, so it is not referenced
         there and no SDL2 payload ships in the Windows release). -->
    <ItemGroup Condition="'$(TargetFramework)' == 'net11.0'">
        <PackageReference Include="Hexa.NET.SDL2" Version="1.2.17" />
    </ItemGroup>

    <!-- Managed MP3 decoding (NLayer.NAudioSupport plugs NLayer into NAudio's
         Mp3FileReaderBase): Linux/macOS use it directly so the built-in UI sounds play
         without a system libsndfile, and Windows uses it as the fallback when Media
         Foundation is unavailable (N/KN editions without the Media Feature Pack, bug
         67862-67879). -->
    <ItemGroup>
        <PackageReference Include="NLayer" Version="3.0.1" />
        <PackageReference Include="NLayer.NAudioSupport" Version="3.0.1" />
    </ItemGroup>
    <ItemGroup Condition="'$(TargetFramework)' == 'net11.0-windows'">
        <PackageReference Include="NAudio.WinMM" Version="3.3.0" />
    </ItemGroup>

    <!-- net11.0 is the Linux/macOS TFM; the WINDOWS symbol is defined only for
         net11.0-windows. A Windows RID on net11.0 makes PlaySoundEffects take the
         managed/(lib)sndfile decoder + ALSA output path, so audio would fail on
         Windows (no libasound). Fail loudly instead. -->
    <Target Name="GuardWindowsRidOnLinuxTfm" BeforeTargets="Build;Publish">
        <Error
            Condition="'$(TargetFramework)' == 'net11.0' and $([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('win'))"
            Text="Cannot build/publish net11.0 with a Windows RuntimeIdentifier '$([System.String]::Copy('$(RuntimeIdentifier)'))'. The net11.0 TFM is Linux/macOS-only (audio output uses NAudio.Alsa). For Windows, use the net11.0-windows TFM, e.g. `dotnet publish -f net11.0-windows -r $(RuntimeIdentifier)`." />
    </Target>
</Project>